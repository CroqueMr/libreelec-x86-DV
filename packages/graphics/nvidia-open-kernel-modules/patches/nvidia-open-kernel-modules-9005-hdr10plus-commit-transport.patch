+    } u;
+    NvU32 operation;
+    struct NvKmsCb1Hdr hdr[NVKMS_MAX_SUBDEVICES][NVKMS_MAX_HEADS_PER_DISP];
+    struct {
+        NvKmsDeviceHandle device;
+        NvKmsDispHandle disp;
+        NVDpyId dpy;
+        NvU32 head, status, potential;
+    } query;
+};
+#endif
