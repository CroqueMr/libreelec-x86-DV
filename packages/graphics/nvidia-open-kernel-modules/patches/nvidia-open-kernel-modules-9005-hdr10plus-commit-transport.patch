+    NVDpyId dpy;
+    NvU32 head;
+};
+enum {NV_CB1_SET_MODE, NV_CB1_FLIP, NV_CB1_QUERY};
+struct NvKmsCb1KapiParams {
+    union {
+        struct NvKmsSetModeParams mode;
