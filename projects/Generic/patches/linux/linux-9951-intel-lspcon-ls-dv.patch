+intel_display_param_named(dv_lspcon, int, 0400,
+	"Standard Dolby Vision through a MegaChips MCDP2800 LSPCON switched to "
+	"level-shifter mode, gen9/10, 4K up to 30 Hz (-1=verified boards only "
