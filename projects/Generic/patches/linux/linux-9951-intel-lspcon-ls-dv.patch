 			.rgb = pipe_config->output_format == INTEL_OUTPUT_FORMAT_RGB &&
 				pipe_config->sink_format == INTEL_OUTPUT_FORMAT_RGB,
 			.limited_range = pipe_config->limited_color_range,
@@ -2746,11 +2751,12 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 			 */
 			if (__ratelimit(&connector->dv_log_limit))
 				drm_err(display->drm,
-					"DVBridge: link rejected errno=%d connector=%u display_ver=%u enabled=%d edid=%s version=%u legacy_vsif=%d sink60=%d native_hdmi=%d lspcon=%d dual_mode=%d vbt_dual_mode=%d hdmi=%d rgb=%d limited=%d hdr_blob=%d cloned=%d progressive=%d bpc=%u pipe_bpp=%u colorspace=%u mode=%ux%u@%u\n",
+					"DVBridge: link rejected errno=%d connector=%u display_ver=%u enabled=%d edid=%s version=%u legacy_vsif=%d sink60=%d native_hdmi=%d verified_bridge=%d lspcon=%d dual_mode=%d vbt_dual_mode=%d hdmi=%d rgb=%d limited=%d hdr_blob=%d cloned=%d progressive=%d bpc=%u pipe_bpp=%u colorspace=%u mode=%ux%u@%u\n",
 					ret, connector->base.base.id, DISPLAY_VER(display),
