@@ -3442,6 +3448,58 @@ static u8 intel_hdmi_ddc_pin(struct intel_encoder *encoder)
 	return ddc_pin;
 }
 
+/*
+ * linux-9951: an LSPCON port that can also drive an HDMI-mode Dolby Vision
+ * output (level-shifter mode). The GPU's own DIPs carry the InfoFrames then;
+ * in PCON mode the LSPCON hooks apply as before. During readout the output
+ * type is not known yet when the InfoFrames are read, so the chip's mode
+ * (lspcon.ls_dv, set by the HDMI enable path) decides.
+ */
+static bool lspcon_dv_hdmi(struct intel_encoder *encoder,
+			   const struct intel_crtc_state *crtc_state)
+{
+	return intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI) ||
+		intel_lspcon_ls_dv_active(enc_to_dig_port(encoder));
+}
+
+static void lspcon_dv_write_infoframe(struct intel_encoder *encoder,
+				      const struct intel_crtc_state *crtc_state,
+				      unsigned int type, const void *frame, ssize_t len)
+{
+	if (lspcon_dv_hdmi(encoder, crtc_state))
+		hsw_write_infoframe(encoder, crtc_state, type, frame, len);
+	else
+		lspcon_write_infoframe(encoder, crtc_state, type, frame, len);
+}
+
+static void lspcon_dv_read_infoframe(struct intel_encoder *encoder,
+				     const struct intel_crtc_state *crtc_state,
+				     unsigned int type, void *frame, ssize_t len)
+{
+	if (lspcon_dv_hdmi(encoder, crtc_state))
+		hsw_read_infoframe(encoder, crtc_state, type, frame, len);
+	else
+		lspcon_read_infoframe(encoder, crtc_state, type, frame, len);
+}
+
+static void lspcon_dv_set_infoframes(struct intel_encoder *encoder, bool enable,
+				     const struct intel_crtc_state *crtc_state,
+				     const struct drm_connector_state *conn_state)
+{
+	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI))
+		hsw_set_infoframes(encoder, enable, crtc_state, conn_state);
+	else
+		lspcon_set_infoframes(encoder, enable, crtc_state, conn_state);
+}
+
+static u32 lspcon_dv_infoframes_enabled(struct intel_encoder *encoder,
+					const struct intel_crtc_state *crtc_state)
+{
+	if (lspcon_dv_hdmi(encoder, crtc_state))
+		return hsw_infoframes_enabled(encoder, crtc_state);
+	return lspcon_infoframes_enabled(encoder, crtc_state);
+}
+
 void intel_infoframe_init(struct intel_digital_port *dig_port)
 {
 	struct intel_display *display = to_intel_display(dig_port);
@@ -3457,7 +3515,12 @@ void intel_infoframe_init(struct intel_digital_port *dig_port)
 		dig_port->set_infoframes = g4x_set_infoframes;
 		dig_port->infoframes_enabled = g4x_infoframes_enabled;
 	} else if (HAS_DDI(display)) {
-		if (intel_bios_encoder_is_lspcon(dig_port->base.devdata)) {
+		if (intel_dp_lspcon_dv_allowed(dig_port)) {
+			dig_port->write_infoframe = lspcon_dv_write_infoframe;
+			dig_port->read_infoframe = lspcon_dv_read_infoframe;
+			dig_port->set_infoframes = lspcon_dv_set_infoframes;
+			dig_port->infoframes_enabled = lspcon_dv_infoframes_enabled;
+		} else if (intel_bios_encoder_is_lspcon(dig_port->base.devdata)) {
 			dig_port->write_infoframe = lspcon_write_infoframe;
 			dig_port->read_infoframe = lspcon_read_infoframe;
 			dig_port->set_infoframes = lspcon_set_infoframes;
--- a/drivers/gpu/drm/i915/display/intel_lspcon.c
+++ b/drivers/gpu/drm/i915/display/intel_lspcon.c
@@ -722,6 +722,79 @@ u32 intel_lspcon_infoframes_enabled(struct intel_encoder *encoder,
 	return dig_port->infoframes_enabled(encoder, pipe_config);
 }
 
+bool intel_lspcon_ls_dv_active(const struct intel_digital_port *dig_port)
+{
+	return dig_port->lspcon.ls_dv;
+}
+
+/*
+ * linux-9951: Standard Dolby Vision through the LSPCON in level-shifter mode.
+ * In PCON mode the MCDP2800 (FW 1.77) drops the Dolby VSIF; in level-shifter
+ * mode it repeats the GPU's own TMDS, so the native-HDMI DV path (AVI, VSIF)
+ * reaches the TV (NUC Display Lab v0.4.0-dvlab, report #17). The switch is
+ * the standard dual-mode register (I2C 0x40, offset 0x40) over the LSPCON's
+ * I2C-over-AUX bridge, the register lspcon_probe() uses for PCON mode.
+ *
+ * enable: wake the chip (it may be idle in D3), then level-shifter mode with
+ * TMDS output on. !enable: TMDS output on (PCON mode expects it), PCON mode,
+ * and wait for native AUX as lspcon_resume does.
