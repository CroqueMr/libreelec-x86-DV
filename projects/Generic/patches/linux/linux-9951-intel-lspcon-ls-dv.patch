+		if (!ret && lspcon_wait_mode(lspcon, DRM_LSPCON_MODE_PCON) != DRM_LSPCON_MODE_PCON)
+			ret = -ETIMEDOUT;
+		if (!ret)
+			lspcon_resume_in_pcon_wa(lspcon);
+	}
