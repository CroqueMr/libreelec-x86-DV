@@ -298,6 +299,8 @@
 	tf = &plane_state->in_transfer_func;
 
 	dce110_prescale_params(&prescale_params, plane_state);
+	if (pipe_ctx->stream->dv_standard)
+		prescale_params.mode = IPP_PRESCALE_MODE_BYPASS_LUT;
 	ipp->funcs->ipp_program_prescale(ipp, &prescale_params);
 
 	if (!plane_state->gamma_correction.is_identity &&
@@ -3029,6 +3032,8 @@
 
 	bp = dc->ctx->dc_bios;
 	for (i = 0; i < dc->res_pool->pipe_count; i++) {
+		if (dc->ctx->dce_version == DCE_VERSION_11_22 && dc->res_pool->ipps[i])
+			dce_ipp_reset_dv(dc->res_pool->ipps[i]);
 		xfm = dc->res_pool->transforms[i];
 		xfm->funcs->transform_reset(xfm);
 
@@ -3188,7 +3193,8 @@
 				plane_state->rotation);
 
 	/* Moved programming gamma from dc to hwss */
-	if (pipe_ctx->plane_state->update_flags.bits.full_update ||
+	if (dc->ctx->dce_version == DCE_VERSION_11_22 ||
+			pipe_ctx->plane_state->update_flags.bits.full_update ||
 			pipe_ctx->plane_state->update_flags.bits.in_transfer_func_change ||
 			pipe_ctx->plane_state->update_flags.bits.gamma_change)
 		hws->funcs.set_input_transfer_func(dc, pipe_ctx, pipe_ctx->plane_state);
