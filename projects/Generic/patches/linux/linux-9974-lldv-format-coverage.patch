+	struct dvbridge_sink_caps result = {DV_EDID_ABSENT, 0, 0, 0, false, false, false, 0, false};
 	unsigned int block, i, blocks, found = 0;
 
 	if (!edid || !size)
@@ -146,6 +152,7 @@ dvbridge_parse_edid(const unsigned char *edid, size_t size)
 					result.status = DV_EDID_VERSION;
 					return result;
 				}
+				result.lldv_422_12 = (data[4] & 1) != 0;
 				result.status = result.version == 2 && (data[6] & 3) < 2 ?
