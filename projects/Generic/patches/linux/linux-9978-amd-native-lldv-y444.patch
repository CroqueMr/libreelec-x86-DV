+	if (pixel_clock <= 0 ||
+	    (format != AMDGPU_LLDV_RGB10_LAB && format != AMDGPU_LLDV_444_10))
+		return false;
+	tmds = pixel_clock;
+	if (format == AMDGPU_LLDV_444_10)
