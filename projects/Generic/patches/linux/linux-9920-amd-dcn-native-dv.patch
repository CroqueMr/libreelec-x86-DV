+static bool hdr10plus_has_frame_update(struct drm_atomic_commit *state,
+				      struct drm_crtc *crtc)
+{
+	struct drm_plane_state *plane = drm_atomic_get_new_plane_state(state, crtc->primary);
+
+	/* Packet programming accompanies the primary surface update. Do not
+	 * acknowledge metadata-only commits that leave the hardware packet stale. */
+	return plane && plane->crtc == crtc && plane->fb && to_dm_plane_state(plane)->dc_state;
+}
+
+static int fill_hdr10plus_info_packet(const struct drm_property_blob *blob,
+				     struct dc_info_packet *out)
+{
+	const u8 *packet = blob->data;
+	struct dc_info_packet result = {0};
+
+	if (!drm_hdr10plus_infoframe_valid(packet, blob->length))
+		return -EINVAL;
+	result.hb0 = packet[0];
+	result.hb1 = packet[1];
+	result.hb2 = packet[2];
+	memcpy(result.sb, packet + 3, 28);
+	result.valid = true;
+	*out = result;
+	return 0;
+}
+
+static int fill_hdr10plus_stream_packet(const struct drm_property_blob *blob,
+		struct dc_stream_state *stream, const struct drm_display_mode *mode)
+{
+	if (stream->timing.hdmi_vic) {
+		u8 vic = drm_match_cea_mode(mode);
+
+		if (!vic)
+			return -EINVAL;
+		/* HDR10+ owns the vendor packet; carry this timing in native AVI. */
+		stream->timing.vic = vic;
+		stream->timing.hdmi_vic = 0;
+	}
+	return fill_hdr10plus_info_packet(blob, &stream->vsp_infopacket);
+}
+
+static void amdgpu_dm_build_hdmi_vsif(const struct drm_connector *connector,
+				    const struct drm_display_mode *mode,
+				    struct dc_info_packet *out)
+{
+	struct hdmi_vendor_infoframe frame;
+	u8 buffer[HDMI_INFOFRAME_SIZE(VENDOR)];
+	ssize_t length;
+
+	memset(out, 0, sizeof(*out));
+	if (drm_hdmi_vendor_infoframe_from_display_mode(&frame, connector, mode))
+		return;
+	length = hdmi_vendor_infoframe_pack(&frame, buffer, sizeof(buffer));
+	if (length < 0)
+		return;
+	out->hb0 = buffer[0];
+	out->hb1 = buffer[1];
+	out->hb2 = buffer[2];
+	memcpy(out->sb, buffer + 3, length - 3);
+	out->valid = true;
+}
