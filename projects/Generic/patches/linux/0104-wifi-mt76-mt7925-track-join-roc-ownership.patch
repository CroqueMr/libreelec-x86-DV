mt76: mt7925: release only the active non-MLO association grant

Linux 7.2.6 can authorize an open station before mgd_complete_tx().
Remember the successful association grant at prepare time. Its firmware
timer and any later grant invalidate that ownership before a delayed
authorization can cancel an off-channel request. Serialize expiry with
grant allocation, including a timer worker delayed past the next grant.

diff --git a/drivers/net/wireless/mediatek/mt76/mt7925/main.c b/drivers/net/wireless/mediatek/mt76/mt7925/main.c
--- a/drivers/net/wireless/mediatek/mt76/mt7925/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/main.c
@@ -511,19 +511,28 @@
 void mt7925_roc_work(struct work_struct *work)
 {
 	struct mt792x_phy *phy;
+	bool notify;
 
 	phy = (struct mt792x_phy *)container_of(work, struct mt792x_phy,
 						roc_work);
 
-	if (!test_and_clear_bit(MT76_STATE_ROC, &phy->mt76->state))
+	mt792x_mutex_acquire(phy->dev);
+	/* An earlier timer's worker may run after a new grant. */
+	if (timer_pending(&phy->roc_timer) ||
+	    !test_and_clear_bit(MT76_STATE_ROC, &phy->mt76->state)) {
+		mt792x_mutex_release(phy->dev);
 		return;
-
-	mt792x_mutex_acquire(phy->dev);
+	}
+
+	/* Managed association does not request a mac80211 off-channel ROC. */
+	notify = !phy->roc_join_owner;
+	phy->roc_join_owner = NULL;
 	ieee80211_iterate_active_interfaces(phy->mt76->hw,
 					    IEEE80211_IFACE_ITER_RESUME_ALL,
 					    mt7925_roc_iter, phy);
 	mt792x_mutex_release(phy->dev);
-	ieee80211_remain_on_channel_expired(phy->mt76->hw);
+	if (notify)
+		ieee80211_remain_on_channel_expired(phy->mt76->hw);
 }
 
 static int mt7925_abort_roc(struct mt792x_phy *phy,
@@ -540,6 +549,29 @@
 	mt792x_mutex_release(phy->dev);
 
 	return err;
+}
+
+/* Only the association which acquired the PHY may release its channel. */
+static void mt7925_abort_join_roc(struct mt792x_vif *mvif)
+{
+	struct mt792x_phy *phy = mvif->phy;
+
+	mt792x_mutex_acquire(phy->dev);
+	if (phy->roc_join_owner == &mvif->bss_conf &&
+	    test_and_clear_bit(MT76_STATE_ROC, &phy->mt76->state)) {
+		phy->roc_join_owner = NULL;
+		timer_delete_sync(&phy->roc_timer);
+		mt7925_mcu_abort_roc(phy, &mvif->bss_conf, phy->roc_token_id);
+	}
+	mt792x_mutex_release(phy->dev);
+}
+
+static bool mt7925_is_legacy_assoc(struct ieee80211_vif *vif,
+				   struct ieee80211_prep_tx_info *info)
+{
+	return vif->type == NL80211_IFTYPE_STATION && !ieee80211_vif_is_mld(vif) &&
+	       (info->subtype == IEEE80211_STYPE_ASSOC_REQ ||
+		info->subtype == IEEE80211_STYPE_REASSOC_REQ);
 }
 
 static int mt7925_set_roc(struct mt792x_phy *phy,
@@ -553,6 +585,7 @@
 	if (test_and_set_bit(MT76_STATE_ROC, &phy->mt76->state))
 		return -EBUSY;
 
+	phy->roc_join_owner = NULL;
 	phy->roc_grant = false;
 
 	err = mt7925_mcu_set_roc(phy, mconf, chan, duration, type,
@@ -562,7 +595,7 @@
 		goto out;
 	}
 
-	if (!wait_event_timeout(phy->roc_wait, phy->roc_grant, 4 * HZ)) {
+	if (!wait_event_timeout(phy->roc_wait, smp_load_acquire(&phy->roc_grant), 4 * HZ)) {
 		mt7925_mcu_abort_roc(phy, mconf, phy->roc_token_id);
 		clear_bit(MT76_STATE_ROC, &phy->mt76->state);
 		err = -ETIMEDOUT;
@@ -581,6 +614,7 @@
 	if (WARN_ON_ONCE(test_and_set_bit(MT76_STATE_ROC, &phy->mt76->state)))
 		return -EBUSY;
 
+	phy->roc_join_owner = NULL;
 	phy->roc_grant = false;
 
 	err = mt7925_mcu_set_mlo_roc(phy, mconf, sel_links, 5, ++phy->roc_token_id);
@@ -589,7 +623,7 @@
 		goto out;
 	}
 
-	if (!wait_event_timeout(phy->roc_wait, phy->roc_grant, 4 * HZ)) {
+	if (!wait_event_timeout(phy->roc_wait, smp_load_acquire(&phy->roc_grant), 4 * HZ)) {
 		mt7925_mcu_abort_roc(phy, mconf, phy->roc_token_id);
 		clear_bit(MT76_STATE_ROC, &phy->mt76->state);
 		err = -ETIMEDOUT;
@@ -1222,11 +1256,9 @@
 	struct ieee80211_link_sta *link_sta = &sta->deflink;
 	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
 
-	if (mvif->roc_join_held && !sta->tdls &&
-	    (ev == MT76_STA_EVENT_AUTHORIZE || ev == MT76_STA_EVENT_DISASSOC)) {
-		mvif->roc_join_held = false;
-		mt7925_abort_roc(mvif->phy, &mvif->bss_conf);
-	}
+	if (!sta->tdls &&
+	    (ev == MT76_STA_EVENT_AUTHORIZE || ev == MT76_STA_EVENT_DISASSOC))
+		mt7925_abort_join_roc(mvif);
 
 	if (ev != MT76_STA_EVENT_ASSOC)
 		return 0;
@@ -1376,7 +1408,6 @@
 
 	if (vif->type == NL80211_IFTYPE_STATION) {
 		mvif->wep_sta = NULL;
-		mvif->roc_join_held = false;
 		ewma_rssi_init(&mvif->bss_conf.rssi);
 	}
 
@@ -2014,11 +2045,15 @@
 	struct mt792x_dev *dev = mt792x_hw_dev(hw);
 	u16 duration = info->duration ? info->duration :
 		       jiffies_to_msecs(HZ);
+	int err;
 
 	mt792x_mutex_acquire(dev);
-	mt7925_set_roc(mvif->phy, &mvif->bss_conf,
-		       mvif->bss_conf.mt76.ctx->def.chan, duration,
-		       MT7925_ROC_REQ_JOIN);
+	err = mt7925_set_roc(mvif->phy, &mvif->bss_conf,
+			     mvif->bss_conf.mt76.ctx->def.chan, duration,
+			     MT7925_ROC_REQ_JOIN);
+	/* Open networks can authorize before mgd_complete_tx(). */
+	if (!err && mt7925_is_legacy_assoc(vif, info))
+		mvif->phy->roc_join_owner = &mvif->bss_conf;
 	mt792x_mutex_release(dev);
 }
 
@@ -2028,16 +2063,9 @@
 {
 	struct mt792x_vif *mvif = (struct mt792x_vif *)vif->drv_priv;
 
-	/* Keep the join ROC until the station is authorized, so that it
-	 * covers the 4-way handshake. mt7925_mac_sta_event() releases it.
-	 * On MLD, the active ROC is the MLO ROC, which must be released
-	 * before the link activation work sets its own.
-	 */
-	if (vif->type == NL80211_IFTYPE_STATION && !ieee80211_vif_is_mld(vif) &&
-	    info->success &&
-	    (info->subtype == IEEE80211_STYPE_ASSOC_REQ ||
-	     info->subtype == IEEE80211_STYPE_REASSOC_REQ)) {
-		mvif->roc_join_held = true;
+	if (mt7925_is_legacy_assoc(vif, info)) {
+		if (!info->success)
+			mt7925_abort_join_roc(mvif);
 		return;
 	}
 
diff --git a/drivers/net/wireless/mediatek/mt76/mt7925/mcu.c b/drivers/net/wireless/mediatek/mt76/mt7925/mcu.c
--- a/drivers/net/wireless/mediatek/mt76/mt7925/mcu.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/mcu.c
@@ -331,11 +331,12 @@
 		ieee80211_iterate_active_interfaces_atomic(hw,
 						IEEE80211_IFACE_ITER_RESUME_ALL,
 						mt7925_mcu_roc_iter, grant);
-	dev->phy.roc_grant = true;
-	wake_up(&dev->phy.roc_wait);
 	duration = le32_to_cpu(grant->max_interval);
 	mod_timer(&dev->phy.roc_timer,
 		  jiffies + msecs_to_jiffies(duration));
+	/* Expiry work checks this timer when the waiter releases the mutex. */
+	smp_store_release(&dev->phy.roc_grant, true);
+	wake_up(&dev->phy.roc_wait);
 }
 
 static void
diff --git a/drivers/net/wireless/mediatek/mt76/mt792x.h b/drivers/net/wireless/mediatek/mt76/mt792x.h
--- a/drivers/net/wireless/mediatek/mt76/mt792x.h
+++ b/drivers/net/wireless/mediatek/mt76/mt792x.h
@@ -226,6 +226,7 @@
 	struct work_struct roc_work;
 	struct timer_list roc_timer;
 	wait_queue_head_t roc_wait;
+	struct mt792x_bss_conf *roc_join_owner; /* MT7925 non-MLO association */
 	u8 roc_token_id;
 	bool roc_grant;
 };
