+	       sizeof(display->hotplug.hdmi_wait_encoders));
+	display->hotplug.hdmi_ready_encoders = 0;
+	display->hotplug.hdmi_running_encoders = 0;
+	display->hotplug.hdmi_cancelled_encoders = 0;
