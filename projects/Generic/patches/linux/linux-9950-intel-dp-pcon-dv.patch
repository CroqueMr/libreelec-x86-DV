+/*
+ * Standard Dolby Vision through an onboard DP-to-HDMI protocol converter.
+ *
+ * The converter turns DP InfoFrame SDPs from the transcoder's DIPs into HDMI
+ * InfoFrames; that is how HDR10 already works (GMP DIP, DRM InfoFrame). The
+ * Dolby VSIF goes the same way through the GMP DIP. The VS DIP must not be
+ * used: on the verified converter it blanks the HDMI output. Verified on
+ * hardware with the NUC Display Lab (nuc-hardware-lab v0.3.0-dvlab, report
+ * #13); see docs/cb1/INTEL-DP-CONVERTER.md.
+ */
+static const struct dmi_system_id intel_dp_pcon_dv_dmi[] = {
+	{
+		/* INUSUAL INUC 11i5FL (Tiger Lake): onboard DP-to-HDMI
+		 * converters on ports B and E, Sony Bravia 7, 4K23.976/59.94. */
+		.matches = {
+			DMI_MATCH(DMI_BOARD_VENDOR, "Intel Corporation"),
+			DMI_EXACT_MATCH(DMI_BOARD_NAME, "CM11EBV58W"),
+		},
+	},
+	{ }
+};
+
+bool intel_dp_pcon_dv_allowed(const struct intel_digital_port *dig_port)
+{
+	struct intel_display *display = to_intel_display(&dig_port->base);
+	const struct intel_bios_encoder_data *devdata = dig_port->base.devdata;
+
+	if (!display->params.enable_dv_lab || DISPLAY_VER(display) < 11 ||
+	    !display->params.dv_pcon || intel_bios_encoder_is_lspcon(devdata) ||
+	    !intel_bios_encoder_supports_hdmi(devdata))
+		return false;
+	return display->params.dv_pcon > 0 || dmi_check_system(intel_dp_pcon_dv_dmi);
+}
+
+/* The sink behind this port is HDMI through a protocol converter. */
+static bool intel_dp_pcon_dv_route(struct intel_dp *intel_dp)
+{
+	return drm_dp_is_branch(intel_dp->dpcd) &&
+		(intel_dp->downstream_ports[0] & DP_DS_PORT_TYPE_MASK) == DP_DS_PORT_TYPE_HDMI &&
+		intel_dp_has_hdmi_sink(intel_dp);
+}
+
+static int intel_dp_pcon_dv_compute_config(struct intel_dp *intel_dp,
+					   struct intel_crtc_state *crtc_state,
+					   const struct drm_connector_state *conn_state)
+{
+	static DEFINE_RATELIMIT_STATE(limit, 30 * HZ, 2);
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_digital_port *dig_port = dp_to_dig_port(intel_dp);
+	struct intel_connector *connector = intel_dp->attached_connector;
+	const struct drm_display_mode *mode = &crtc_state->hw.adjusted_mode;
+	const struct drm_property_blob *edid = connector->base.edid_blob_ptr;
+	struct hdmi_avi_infoframe *avi = &crtc_state->infoframes.avi.avi;
+	struct hdmi_dolby_vendor_infoframe *dv = &crtc_state->infoframes.hdmi.vendor.dolby;
+	struct dvbridge_sink_caps caps;
+	struct intel_dv_lab_link link;
+	int ret;
+
+	if (!to_intel_digital_connector_state(conn_state)->dv_lab_standard)
+		return 0;
+
+	caps = dvbridge_parse_edid(edid ? edid->data : NULL, edid ? edid->length : 0);
+	link = (struct intel_dv_lab_link) {
+		.requested = true,
+		.lab_enabled = display->params.enable_dv_lab,
+		.sink_standard = caps.status == DV_EDID_STANDARD,
+		.hdmi = intel_dp_has_hdmi_sink(intel_dp) &&
+			connector->base.display_info.has_hdmi_infoframe,
+		.native_hdmi = false,
+		.verified_bridge = intel_dp_pcon_dv_allowed(dig_port) &&
+			intel_dp_pcon_dv_route(intel_dp),
+		.rgb = crtc_state->output_format == INTEL_OUTPUT_FORMAT_RGB &&
+			crtc_state->sink_format == INTEL_OUTPUT_FORMAT_RGB,
+		.limited_range = crtc_state->limited_color_range,
+		.hdr_blob = !!conn_state->hdr_output_metadata,
+		.cloned = hweight32(crtc_state->uapi.encoder_mask) > 1,
+		.progressive = !(mode->flags & (DRM_MODE_FLAG_INTERLACE |
+			DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_DBLCLK | DRM_MODE_FLAG_3D_MASK)),
+		.requested_bpc = conn_state->max_requested_bpc,
+		.pipe_bpp = crtc_state->pipe_bpp,
+		.colorspace = conn_state->colorspace,
+		.width = mode->hdisplay,
+		.height = mode->vdisplay,
+		.rounded_refresh = drm_mode_vrefresh(mode),
+	};
+	ret = intel_dv_lab_validate(&link);
+	if (!ret && link.width == 3840 && link.rounded_refresh > 30 &&
+	    !caps.supports_2160p60)
+		ret = -EOPNOTSUPP;
+	/* Only the modern Dolby VSIF was verified through a converter. */
+	if (!ret && (caps.legacy_vsif || !intel_dv_lab_avi_vic(drm_match_cea_mode(mode))))
+		ret = -EOPNOTSUPP;
+	if (ret) {
+		if (__ratelimit(&limit))
+			drm_err(display->drm,
+				"DVBridge: DP converter link rejected errno=%d connector=%u route=%d edid=%s legacy_vsif=%d hdmi=%d rgb=%d limited=%d hdr_blob=%d cloned=%d bpc=%u pipe_bpp=%u colorspace=%u mode=%ux%u@%u\n",
+				ret, connector->base.base.id, link.verified_bridge,
+				dvbridge_edid_reason(caps.status), caps.legacy_vsif,
+				link.hdmi, link.rgb, link.limited_range, link.hdr_blob,
+				link.cloned, link.requested_bpc, link.pipe_bpp,
+				link.colorspace, link.width, link.height,
+				link.rounded_refresh);
+		return ret;
+	}
+
+	/* The AVI the native-HDMI DV path sends: RGB is a byte tunnel. */
+	ret = drm_hdmi_avi_infoframe_from_display_mode(avi, &connector->base, mode);
+	if (ret)
+		return ret;
+	avi->video_code = intel_dv_lab_avi_vic(drm_match_cea_mode(mode));
+	avi->colorspace = HDMI_COLORSPACE_RGB;
+	avi->colorimetry = HDMI_COLORIMETRY_NONE;
+	avi->extended_colorimetry = 0;
+	avi->quantization_range = HDMI_QUANTIZATION_RANGE_FULL;
+	drm_hdmi_avi_infoframe_content_type(avi, conn_state);
+	ret = hdmi_avi_infoframe_check(avi);
+	if (ret)
+		return ret;
+
+	hdmi_dolby_vendor_infoframe_init(dv);
+	dv->signal = true;
+	ret = hdmi_dolby_vendor_infoframe_check(dv);
+	if (ret)
+		return ret;
+
+	crtc_state->dither_force_disable = true;
+	crtc_state->infoframes.enable |=
+		intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_AVI) |
+		intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR);
+	return 0;
+}
+
+/* HDMI InfoFrame (header, checksum, payload) -> DP 1.4 InfoFrame SDP, the
+ * layout intel_dp_hdr_metadata_infoframe_sdp_pack() uses, in 32 bytes (the
+ * AVI DIP's size): the Dolby VSIF's PB27 (reserved, zero) is not carried;
+ * the 36-byte GMP DIP is zero-padded by hsw_write_infoframe(). */
+static void intel_dp_pcon_dv_sdp(const u8 *hdmi, ssize_t len, u8 *sdp)
+{
+	memset(sdp, 0, VIDEO_DIP_DATA_SIZE);
+	sdp[1] = hdmi[0];	/* HB1: 0x80 + InfoFrame type */
+	sdp[2] = 0x1d;
+	sdp[3] = 0x13 << 2;
+	sdp[4] = hdmi[1];	/* DB0: version */
+	sdp[5] = hdmi[2];	/* DB1: length */
+	memcpy(&sdp[6], &hdmi[HDMI_INFOFRAME_HEADER_SIZE],
+	       min_t(ssize_t, len - HDMI_INFOFRAME_HEADER_SIZE, VIDEO_DIP_DATA_SIZE - 6));
+}
+
+static void intel_dp_pcon_dv_write(struct intel_encoder *encoder,
+				   const struct intel_crtc_state *crtc_state)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	u8 buf[VIDEO_DIP_DATA_SIZE] = {}, sdp[VIDEO_DIP_DATA_SIZE];
+	ssize_t len;
+
+	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_DP_MST) ||
+	    !(crtc_state->infoframes.enable &
+	      intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR)) ||
+	    !intel_dp_pcon_dv_allowed(enc_to_dig_port(encoder)))
+		return;
+
+	len = hdmi_avi_infoframe_pack_only(&crtc_state->infoframes.avi.avi, buf, sizeof(buf));
+	if (drm_WARN_ON(display->drm, len < HDMI_INFOFRAME_HEADER_SIZE))
+		return;
+	intel_dp_pcon_dv_sdp(buf, len, sdp);
+	hsw_write_infoframe(encoder, crtc_state, HDMI_INFOFRAME_TYPE_AVI, sdp, sizeof(sdp));
+
+	memset(buf, 0, sizeof(buf));
+	len = hdmi_dolby_vendor_infoframe_pack(&crtc_state->infoframes.hdmi.vendor.dolby,
+					       buf, sizeof(buf));
+	if (drm_WARN_ON(display->drm, len != HDMI_INFOFRAME_HEADER_SIZE + 27 ||
+			buf[HDMI_INFOFRAME_HEADER_SIZE + 26]))
+		return;
+	intel_dp_pcon_dv_sdp(buf, len, sdp);
+	/* The GMP DIP: the VS DIP blanks the verified converter's output. */
+	hsw_write_infoframe(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA, sdp, sizeof(sdp));
+}
+
 int
 intel_dp_compute_config(struct intel_encoder *encoder,
 			struct intel_crtc_state *pipe_config,
@@ -3704,7 +3884,9 @@ intel_dp_compute_config(struct intel_encoder *encoder,
 	if (to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color &&
 	    !intel_dp_hdr10_deep_requested(encoder, conn_state))
 		return -EINVAL;
-	if (ret && !to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color)
+	/* Dolby Vision must never exceed the converter's TMDS limit. */
+	if (ret && !to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color &&
+	    !to_intel_digital_connector_state(conn_state)->dv_lab_standard)
 		ret = intel_dp_compute_formats(encoder, pipe_config, conn_state, false);
 	if (ret)
 		return ret;
@@ -3781,6 +3963,10 @@ intel_dp_compute_config(struct intel_encoder *encoder,
 	intel_dp_compute_vsc_sdp(intel_dp, pipe_config, conn_state);
 	intel_dp_compute_hdr_metadata_infoframe_sdp(intel_dp, pipe_config, conn_state);
 
+	ret = intel_dp_pcon_dv_compute_config(intel_dp, pipe_config, conn_state);
+	if (ret)
+		return ret;
+
 	return intel_dp_tunnel_atomic_compute_stream_bw(state, intel_dp, connector,
 							pipe_config);
 }
@@ -5463,6 +5649,8 @@ void intel_dp_set_infoframes(struct intel_encoder *encoder,
 	intel_write_dp_sdp(encoder, crtc_state, DP_SDP_ADAPTIVE_SYNC);
 
 	intel_write_dp_sdp(encoder, crtc_state, HDMI_PACKET_TYPE_GAMUT_METADATA);
+
+	intel_dp_pcon_dv_write(encoder, crtc_state);
 }
 
 static
@@ -7206,6 +7394,16 @@ intel_dp_add_properties(struct intel_dp *intel_dp, struct drm_connector *_connec
 		intel_attach_dp_colorspace_property(&connector->base);
 	}
 
