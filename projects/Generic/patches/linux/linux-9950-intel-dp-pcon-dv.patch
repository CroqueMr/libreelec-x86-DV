 		drm_connector_attach_hdr_output_metadata_property(&connector->base);
 		if (DISPLAY_VER(display) >= 9 && !intel_dp_is_edp(intel_dp))
@@ -7642,9 +7840,11 @@ int intel_dp_sdp_min_guardband(const struct intel_crtc_state *crtc_state,
 {
 	int sdp_guardband = 0;
 
+	/* Dolby Vision through a converter also uses the GMP DIP (VENDOR). */
 	if (assume_all_enabled ||
 	    crtc_state->infoframes.enable &
-	    intel_hdmi_infoframe_enable(HDMI_PACKET_TYPE_GAMUT_METADATA))
+	    (intel_hdmi_infoframe_enable(HDMI_PACKET_TYPE_GAMUT_METADATA) |
+	     intel_hdmi_infoframe_enable(HDMI_INFOFRAME_TYPE_VENDOR)))
 		sdp_guardband = max(sdp_guardband,
 				    intel_dp_get_lines_for_sdp(crtc_state,
 							       HDMI_PACKET_TYPE_GAMUT_METADATA));
--- a/drivers/gpu/drm/i915/display/intel_dp.h
+++ b/drivers/gpu/drm/i915/display/intel_dp.h
@@ -130,6 +130,7 @@ int intel_dp_effective_data_rate(int pixel_clock, int bpp_x16,
 				 int bw_overhead);
 int intel_dp_max_link_data_rate(struct intel_dp *intel_dp,
 				int max_dprx_rate, int max_dprx_lanes);
+bool intel_dp_pcon_dv_allowed(const struct intel_digital_port *dig_port);
 bool intel_dp_joiner_needs_dsc(struct intel_display *display,
 			       int num_joined_pipes);
 bool intel_dp_has_joiner(struct intel_dp *intel_dp);
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -621,6 +621,71 @@ static u32 hsw_infoframes_enabled(struct intel_encoder *encoder,
 	return val & mask;
 }
 
+/*
+ * Standard DV through an onboard DP-to-HDMI converter (intel_dp_pcon_dv_*):
+ * the AVI and the Dolby VSIF are DP InfoFrame SDPs in the AVI and GMP DIPs.
+ * Read them back as the HDMI InfoFrames the state computed, so the state
+ * checker compares like with like: a GMP DIP carrying a Dolby VSIF SDP is
+ * reported as the vendor InfoFrame, not as HDR metadata.
+ */
+static bool hsw_pcon_dv_sdp_type(struct intel_display *display,
+				 enum transcoder trans, unsigned int dip, u8 type)
+{
+	u32 dw0 = intel_de_read(display, dip == HDMI_PACKET_TYPE_GAMUT_METADATA ?
+				HSW_TVIDEO_DIP_GMP_DATA(display, trans, 0) :
+				HSW_TVIDEO_DIP_AVI_DATA(display, trans, 0));
+
+	return (dw0 & 0xff) == 0 && ((dw0 >> 8) & 0xff) == type;
+}
+
+static u32 hsw_pcon_dv_infoframes_enabled(struct intel_encoder *encoder,
+					  const struct intel_crtc_state *pipe_config)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	u32 val = hsw_infoframes_enabled(encoder, pipe_config);
+
+	if ((val & VIDEO_DIP_ENABLE_GMP_HSW) &&
+	    hsw_pcon_dv_sdp_type(display, pipe_config->cpu_transcoder,
+				 HDMI_PACKET_TYPE_GAMUT_METADATA, HDMI_INFOFRAME_TYPE_VENDOR)) {
+		val &= ~VIDEO_DIP_ENABLE_GMP_HSW;
+		val |= VIDEO_DIP_ENABLE_VS_HSW;
+	}
+	return val;
+}
+
+static void hsw_pcon_dv_read_infoframe(struct intel_encoder *encoder,
+				       const struct intel_crtc_state *crtc_state,
+				       unsigned int type, void *frame, ssize_t len)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	unsigned int dip = type == HDMI_INFOFRAME_TYPE_VENDOR ?
+		HDMI_PACKET_TYPE_GAMUT_METADATA : type;
+	u8 sdp[VIDEO_DIP_DATA_SIZE], *out = frame, sum;
+	int i, n;
+
+	/* Only a DP-mode transcoder carries the SDPs; an HDMI-mode one may
+	 * still hold a stale Dolby SDP in its (disabled) GMP DIP. */
+	if ((type != HDMI_INFOFRAME_TYPE_VENDOR && type != HDMI_INFOFRAME_TYPE_AVI) ||
+	    intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI) ||
+	    len < VIDEO_DIP_DATA_SIZE ||
+	    !hsw_pcon_dv_sdp_type(display, crtc_state->cpu_transcoder, dip, type)) {
+		hsw_read_infoframe(encoder, crtc_state, type, frame, len);
+		return;
+	}
+	hsw_read_infoframe(encoder, crtc_state, dip, sdp, sizeof(sdp));
+	/* HDMI DIP layout: HB0-HB2, the ECC hole, PB0 (checksum), PB1.. */
+	memset(frame, 0, len);
+	out[0] = sdp[1];
+	out[1] = sdp[4];
+	out[2] = sdp[5];
+	n = min_t(int, sdp[5], VIDEO_DIP_DATA_SIZE - 6);
+	memcpy(&out[5], &sdp[6], n);
+	sum = out[0] + out[1] + out[2];
+	for (i = 0; i < n; i++)
+		sum += out[5 + i];
+	out[4] = 256 - sum;
+}
+
 static const u8 infoframe_type_to_idx[] = {
 	HDMI_PACKET_TYPE_GENERAL_CONTROL,
 	HDMI_PACKET_TYPE_GAMUT_METADATA,
@@ -3397,6 +3462,11 @@ void intel_infoframe_init(struct intel_digital_port *dig_port)
 			dig_port->read_infoframe = lspcon_read_infoframe;
 			dig_port->set_infoframes = lspcon_set_infoframes;
 			dig_port->infoframes_enabled = lspcon_infoframes_enabled;
+		} else if (intel_dp_pcon_dv_allowed(dig_port)) {
+			dig_port->write_infoframe = hsw_write_infoframe;
+			dig_port->read_infoframe = hsw_pcon_dv_read_infoframe;
+			dig_port->set_infoframes = hsw_set_infoframes;
+			dig_port->infoframes_enabled = hsw_pcon_dv_infoframes_enabled;
 		} else {
 			dig_port->write_infoframe = hsw_write_infoframe;
 			dig_port->read_infoframe = hsw_read_infoframe;
