+bool intel_hdmi_uses_gmp_hdr(const struct intel_crtc_state *crtc_state)
+{
+	return intel_hdmi_has_gmp_hdr(to_intel_display(crtc_state)) &&
+		crtc_state->has_hdmi_sink && crtc_state->cpu_transcoder != TRANSCODER_EDP;
+}
