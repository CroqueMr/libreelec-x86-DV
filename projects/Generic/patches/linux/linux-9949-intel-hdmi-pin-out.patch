+/* A link change can reset an active Alder Lake-P HDMI audio pin. */
+static void adlp_restore_pin_out(struct hda_codec *codec,
+				 struct hdmi_spec_per_pin *per_pin)
+{
+	struct hdmi_spec *spec = codec->spec;
+	hda_nid_t pin = per_pin->pin_nid;
+	int ctl;
+
+	if (codec->core.vendor_id != 0x8086281c || !per_pin->setup || !per_pin->channels ||
+	    !per_pin->sink_eld.eld_valid || per_pin->pcm_idx < 0 ||
+	    !test_bit(per_pin->pcm_idx, &spec->pcm_in_use))
+		return;
+
+	if (snd_hda_set_dev_select(codec, pin, per_pin->dev_id))
+		return;
+
+	/* A single-entry HDMI pin has no device selector to read back. */
+	if (snd_hda_get_dev_select(codec, pin) != per_pin->dev_id &&
+	    (per_pin->dev_id || per_pin->sink_eld.info.conn_type != 0 ||
+	     snd_hdac_read_parm_uncached(&codec->core, pin, AC_PAR_DEVLIST_LEN) != 0))
+		return;
+
+	ctl = snd_hda_codec_read(codec, pin, 0, AC_VERB_GET_PIN_WIDGET_CONTROL, 0);
+	if (ctl >= 0 && !(ctl & PIN_OUT))
+		snd_hda_codec_write(codec, pin, 0, AC_VERB_SET_PIN_WIDGET_CONTROL,
+				    ctl | PIN_OUT);
+}
