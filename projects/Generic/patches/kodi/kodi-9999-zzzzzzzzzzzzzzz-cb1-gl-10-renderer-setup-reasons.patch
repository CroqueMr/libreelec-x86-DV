Subject: [PATCH] DV: say why the bridge renderer could not be set up

Initialize() only reported renderer-init when attaching, creating the
packer or wrapping the scanout failed. Name the step, and for a
refused attach whether the shared context was quarantined, still had
work in flight, or had a failed libplacebo GPU.

--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -471,6 +471,14 @@ bool CDVBridgeGLES::Context::Initialize(bool allowSoftware)
   return m_state->owner != nullptr;
 }
 
+const char* CDVBridgeGLES::Context::AttachRefusal() const
+{
+  if (m_state->quarantined) return "context-quarantined";
+  if (!m_state->inFlight.empty()) return "context-in-flight";
+  if (m_state->gl && pl_gpu_is_failed(m_state->gl->gpu)) return "context-gpu-failed";
+  return "renderer-create";
+}
+
 dvbridge_renderer* CDVBridgeGLES::Context::Attach()
 {
   if (m_state->quarantined || !m_state->inFlight.empty()) return nullptr;
@@ -1592,7 +1600,13 @@ bool CDVBridgeGLES::Initialize(bool allowSoftware, bool hdr10, std::shared_ptr<C
 #endif
   m_renderer = m_context->Attach();
   m_packer = dvbridge_gl_packer_create(DVBRIDGE_VERTEX, DVBRIDGE_FRAGMENT);
-  return m_renderer && m_packer && RebindOutputSurface(hdr10, sdr, framebuffer);
+  if (!m_renderer)
+    return Failure(m_context->AttachRefusal());
+  if (!m_packer)
+    return Failure("packer-create");
+  if (!RebindOutputSurface(hdr10, sdr, framebuffer))
+    return Failure("scanout-wrap");
+  return true;
 }
 
 bool CDVBridgeGLES::RebindOutputSurface(bool hdr10, bool sdr, unsigned int framebuffer)
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.h
@@ -56,6 +56,8 @@ public:
     ~Context();
     bool Initialize(bool allowSoftware);
     dvbridge_renderer* Attach();
+    // Why Attach() returned null.
+    const char* AttachRefusal() const;
     void Detach(dvbridge_renderer* renderer);
     dvbridge_dv_policy_status Poll(bool allowAhead = false);
     bool Close();
