+std::string RPUPrimaries(unsigned index)
+{
+  static constexpr const char* names[] = {"P3-D65", "BT.709", "BT.2020", "BT.601 NTSC",
+      "BT.601 PAL", "DCI-P3", "ACES", "S-Gamut", "S-Gamut3.Cine"};
