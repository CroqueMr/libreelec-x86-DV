Subject: [PATCH] DV GL: report subtitle bounds from the GL overlay renderer

The DV composite places subtitles from the bounds and textures the
overlay renderer records. Record them from the GL renderer as the GLES
one does, keeping the glyph extent for ASS subtitles.

HDR bitmap subtitles and a UHD disc's BD-J menus are converted from PQ
as on GLES.

--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
@@ -832,7 +832,7 @@ std::shared_ptr<COverlay> CRenderer::Convert(SElement& e)
       r = it->second;
   }
 
-#if defined(HAS_GLES)
+#if defined(HAS_GLES) || defined(HAS_GL)
   if (r && o.IsOverlayType(DVDOVERLAY_TYPE_IMAGE) &&
       static_cast<CDVDOverlayImage&>(o).m_isHDROverlay &&
       r->m_paletteOutputState != BitmapPaletteOutputState())
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererGL.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererGL.cpp
@@ -19,17 +19,32 @@
 #include "cores/VideoPlayer/DVDCodecs/Overlay/DVDOverlaySpu.h"
 #include "rendering/MatrixGL.h"
 #include "rendering/gl/RenderSystemGL.h"
+#include "settings/SettingsComponent.h"
 #include "utils/GLUtils.h"
 #include "utils/MathUtils.h"
 #include "utils/log.h"
 #include "windowing/WinSystem.h"
+#ifdef HAVE_DVBRIDGE
+#include "windowing/gbm/WinSystemGbmDVContext.h"
+#endif
 
+#include <algorithm>
 #include <cmath>
+#include <cstring>
 
 #define USE_PREMULTIPLIED_ALPHA 1
 
 using namespace OVERLAY;
 
+static void RecordSubtitleBounds(const CRect& rect, unsigned texture)
+{
+#ifdef HAVE_DVBRIDGE
+  if (auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmDVContext*>(
+          CServiceBroker::GetWinSystem()))
+    window->RecordDVSubtitle(rect, texture);
+#endif
+}
+
 static void LoadTexture(GLenum target
                       , GLsizei width, GLsizei height, GLsizei stride
                       , GLfloat* u, GLfloat* v
@@ -85,6 +100,9 @@ std::shared_ptr<COverlay> COverlay::Create(const CDVDOverlayImage& o, CRect& rSo
 
 COverlayTextureGL::COverlayTextureGL(const CDVDOverlayImage& o, CRect& rSource)
 {
+  m_isHDROverlay = o.m_isHDROverlay;
+  m_paletteOutputState = m_isHDROverlay ? BitmapPaletteOutputState() : 0;
+
   glGenTextures(1, &m_texture);
   glBindTexture(GL_TEXTURE_2D, m_texture);
 
@@ -93,7 +111,19 @@ COverlayTextureGL::COverlayTextureGL(const CDVDOverlayImage& o, CRect& rSource)
   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
   glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
 
-  if (o.palette.empty())
+  if (o.palette.empty() && m_isHDROverlay && m_paletteOutputState)
+  {
+    // A UHD disc's BD-J graphics are PQ code values; convert them as a PQ palette is.
+    m_pma = false;
+    std::vector<uint32_t> rgba(static_cast<size_t>(o.width) * o.height);
+    for (int y = 0; y < o.height; ++y)
+      std::memcpy(rgba.data() + static_cast<size_t>(y) * o.width,
+                  o.pixels.data() + static_cast<size_t>(y) * o.linesize,
+                  static_cast<size_t>(o.width) * 4);
+    OVERLAY::PreparePQPixels(rgba, m_paletteOutputState);
+    LoadTexture(GL_TEXTURE_2D, o.width, o.height, o.width * 4, &m_u, &m_v, false, rgba.data());
+  }
+  else if (o.palette.empty())
   {
     m_pma = false;
     const uint32_t* rgba = reinterpret_cast<const uint32_t*>(o.pixels.data());
@@ -101,9 +131,47 @@ COverlayTextureGL::COverlayTextureGL(const CDVDOverlayImage& o, CRect& rSource)
   }
   else
   {
+    std::vector<uint32_t> convertedPalette;
+    const std::vector<uint32_t>* paletteOverride = nullptr;
+    const auto options = CServiceBroker::GetSettingsComponent()->GetSubtitlesSettings()->GetBitmapOptions();
+    if (o.GetSource() == DVDOverlaySource::SUBTITLE &&
+        (o.m_isHDROverlay ? options.hdrBrightness != 100 || options.hdrSaturation != 100
+                           : options.sdrBrightness != 100 || options.sdrSaturation != 100))
+    {
+      convertedPalette = o.palette;
+      KODI::SUBTITLES::AdjustBitmapPalette(convertedPalette, o.m_isHDROverlay, options, o.GetSource());
+      paletteOverride = &convertedPalette;
+    }
+    if (m_isHDROverlay && (m_paletteOutputState & 1u))
+    {
+      if (!paletteOverride) convertedPalette = o.palette;
+      OVERLAY::ConvertPQPaletteToSRGB(convertedPalette);
+      paletteOverride = &convertedPalette;
+    }
+
     std::vector<uint32_t> rgba(o.width * o.height);
     m_pma = !!USE_PREMULTIPLIED_ALPHA;
-    convert_rgba(o, m_pma, rgba);
+    convert_rgba(o, m_pma, rgba, paletteOverride);
+
+    // the direct back-buffer draw in Render bypasses the composite's
+    // limited-range encode, so apply it to the pixels here
+    //! @todo Move this into the overlay shader once limited-range and
+    //! full-range GUI shader variants are kept compiled in parallel and
+    //! selectable per draw; then this draw selects the limited variant.
+    if (m_isHDROverlay && (m_paletteOutputState & 2u))
+    {
+      for (uint32_t& px : rgba)
+      {
+        const uint32_t a = (px >> PIXEL_ASHIFT) & 0xff;
+        const uint32_t r = (px >> PIXEL_RSHIFT) & 0xff;
+        const uint32_t g = (px >> PIXEL_GSHIFT) & 0xff;
+        const uint32_t b = (px >> PIXEL_BSHIFT) & 0xff;
+        px = (a << PIXEL_ASHIFT) | (((r * 219 + a * 16 + 127) / 255) << PIXEL_RSHIFT) |
+             (((g * 219 + a * 16 + 127) / 255) << PIXEL_GSHIFT) |
+             (((b * 219 + a * 16 + 127) / 255) << PIXEL_BSHIFT);
+      }
+    }
+
     LoadTexture(GL_TEXTURE_2D, o.width, o.height, o.width * 4, &m_u, &m_v, false, rgba.data());
   }
 
@@ -260,6 +328,23 @@ COverlayGlyphGL::COverlayGlyphGL(ASS_Image* images, float width, float height)
     vt += 4;
   }
 
+  // ASS's nominal extent is the whole screen. Keep its actual glyph extent.
+  for (size_t i = 0; i < m_vertex.size(); i++)
+  {
+    const VERTEX& vertex = m_vertex[i];
+    if (i == 0)
+    {
+      m_glyphBounds = CRect(vertex.x, vertex.y, vertex.x, vertex.y);
+    }
+    else
+    {
+      m_glyphBounds.x1 = std::min(m_glyphBounds.x1, vertex.x);
+      m_glyphBounds.y1 = std::min(m_glyphBounds.y1, vertex.y);
+      m_glyphBounds.x2 = std::max(m_glyphBounds.x2, vertex.x);
+      m_glyphBounds.y2 = std::max(m_glyphBounds.y2, vertex.y);
+    }
+  }
+
   glBindTexture(GL_TEXTURE_2D, 0);
 }
 
@@ -273,6 +358,12 @@ void COverlayGlyphGL::Render(SRenderState& state)
   if ((m_texture == 0) || (m_vertex.empty()))
     return;
 
+  RecordSubtitleBounds(CRect(state.x + state.width * m_glyphBounds.x1,
+                             state.y + state.height * m_glyphBounds.y1,
+                             state.x + state.width * m_glyphBounds.x2,
+                             state.y + state.height * m_glyphBounds.y2),
+                       m_texture);
+
   glEnable(GL_BLEND);
 
   glBindTexture(GL_TEXTURE_2D, m_texture);
@@ -392,6 +483,7 @@ void COverlayTextureGL::Render(SRenderState& state)
 
     rd.SetRect(left, top, right, bottom);
   }
+  RecordSubtitleBounds(rd, m_texture);
 
   CRenderSystemGL* renderSystem = dynamic_cast<CRenderSystemGL*>(CServiceBroker::GetRenderSystem());
 
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererGL.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererGL.h
@@ -56,6 +56,7 @@ namespace OVERLAY {
     };
 
     std::vector<VERTEX> m_vertex;
+    CRect m_glyphBounds;
 
     GLuint m_texture = 0;
     float m_u;
