Subject: [PATCH] Skip draining generated keepalive samples at sink close

--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.h
@@ -138,6 +138,7 @@
   std::chrono::milliseconds m_extSilenceTimeout;
   bool m_extAppFocused;
   bool m_extStreaming;
+  bool m_hasSubmittedAudio{false};
   bool m_extReserved{false};
   std::chrono::duration<double> m_reservedCacheTotal{};
   std::chrono::duration<double> m_reservedLatency{};
--- a/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
+++ b/xbmc/cores/AudioEngine/Engines/ActiveAE/ActiveAESink.cpp
@@ -436,6 +436,7 @@
         {
         case CSinkDataProtocol::DRAIN:
           m_sink->Drain();
+          m_hasSubmittedAudio = false;
           msg->Reply(CSinkDataProtocol::ACC);
           m_state = S_TOP_CONFIGURED_IDLE;
           m_extTimeout = 10s;
@@ -567,6 +568,7 @@
           else
           {
             m_sink->Drain();
+            m_hasSubmittedAudio = false;
             m_state = S_TOP_CONFIGURED_IDLE;
             if (m_extAppFocused)
               m_extTimeout = 10s;
@@ -1045,14 +1047,15 @@
 
 void CActiveAESink::CloseSink(const bool drain)
 {
-  if (!m_sink)
-    return;
-
-  if (drain)
-    m_sink->Drain();
-
-  m_sink->Deinitialize();
-  m_sink.reset();
+  if (m_sink)
+  {
+    // Samples generated by the sink only keep the device awake.
+    if (drain && m_hasSubmittedAudio)
+      m_sink->Drain();
+    m_sink->Deinitialize();
+    m_sink.reset();
+  }
+  m_hasSubmittedAudio = false;
 }
 
 void CActiveAESink::ReturnBuffers()
@@ -1072,6 +1075,7 @@
 
 unsigned int CActiveAESink::OutputSamples(CSampleBuffer* samples)
 {
+  m_hasSubmittedAudio |= samples != &m_sampleOfSilence;
   uint8_t **buffer = samples->pkt->data;
   uint8_t *packBuffer;
   unsigned int frames = samples->pkt->nb_samples;
