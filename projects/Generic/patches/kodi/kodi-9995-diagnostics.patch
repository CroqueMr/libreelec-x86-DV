diff --git a/xbmc/cores/VideoSourceSideData.cpp b/xbmc/cores/VideoSourceSideData.cpp
--- /dev/null
+++ b/xbmc/cores/VideoSourceSideData.cpp
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "VideoSourceSideData.h"
+
+#include "utils/Base64.h"
+#include "utils/JSONVariantWriter.h"
+#include "utils/Variant.h"
+
+#include <array>
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <new>
+
+namespace
+{
+constexpr size_t MAX_RAW_RPU = 1024 * 1024;
+constexpr std::array<uint8_t, 6> HDR10PLUS_HEADER{0xb5, 0, 0x3c, 0, 1, 4};
+
+void PutBE(std::vector<uint8_t>& bytes, uint32_t value, unsigned count)
+{
+  for (unsigned i = count; i; --i)
+    bytes.push_back(static_cast<uint8_t>(value >> (8 * (i - 1))));
+}
+
+bool Scaled(AVRational value, uint32_t scale, uint32_t maximum, uint32_t& result)
+{
+  if (value.den <= 0 || value.num < 0)
+    return false;
+  const uint64_t product = uint64_t(value.num) * scale;
+  // Round rational source fields to the nearest representable wire unit.
+  const uint64_t rounded = (product + uint64_t(value.den) / 2) / value.den;
+  if (rounded > maximum)
+    return false;
+  result = static_cast<uint32_t>(rounded);
+  return true;
+}
+
+bool Mastering(const AVMasteringDisplayMetadata& value, std::vector<uint8_t>& bytes)
+{
+  // The wire format cannot mark individual unknown fields; omit partial records.
+  if (!value.has_primaries || !value.has_luminance)
+    return false;
+  std::vector<uint8_t> result;
+  uint32_t scaled;
+  for (unsigned primary : {1u, 2u, 0u}) // FFmpeg RGB -> SEI GBR
+    for (unsigned axis = 0; axis < 2; ++axis)
+    {
+      if (!Scaled(value.display_primaries[primary][axis], 50000, 65535, scaled))
+        return false;
+      PutBE(result, scaled, 2);
+    }
+  for (const auto& point : value.white_point)
+  {
+    if (!Scaled(point, 50000, 65535, scaled))
+      return false;
+    PutBE(result, scaled, 2);
+  }
+  for (const auto& luminance : {value.max_luminance, value.min_luminance})
+  {
+    if (!Scaled(luminance, 10000, std::numeric_limits<uint32_t>::max(), scaled))
+      return false;
+    PutBE(result, scaled, 4);
+  }
+  bytes = std::move(result);
+  return true;
+}
+
+// Validate exactly the public FFmpeg9 serializer's rational arithmetic/counts.
+// Its internal integer multiplication must not overflow before division.
+bool HDRValue(AVRational q, int scale, unsigned bits, bool wide = false)
+{
+  return q.den > 0 && q.num >= 0 && (wide || q.num <= std::numeric_limits<int>::max() / scale) &&
+      uint64_t(q.num) * scale / q.den < (uint64_t{1} << bits);
+}
+
+bool HDR10Plus(const AVDynamicHDRPlus& value)
+{
+  // FFmpeg9 writes application version 1 and has no safe general multi-window
+  // color-saturation serialization. Omit unsupported forms, never rewrite facts.
+  if (value.application_version != 1 || value.num_windows != 1 ||
+      value.targeted_system_display_actual_peak_luminance_flag > 1 ||
+      value.mastering_display_actual_peak_luminance_flag > 1 ||
+      !HDRValue(value.targeted_system_display_maximum_luminance, 1, 27, true))
+    return false;
+  const auto peak = [](bool present, unsigned rows, unsigned cols, const auto& values)
+  {
+    if (!present) return true;
+    if (rows < 2 || rows > 25 || cols < 2 || cols > 25) return false;
+    for (unsigned i = 0; i < rows; ++i)
+      for (unsigned j = 0; j < cols; ++j)
+        if (!HDRValue(values[i][j], 15, 4)) return false;
+    return true;
+  };
+  if (!peak(value.targeted_system_display_actual_peak_luminance_flag,
+            value.num_rows_targeted_system_display_actual_peak_luminance,
+            value.num_cols_targeted_system_display_actual_peak_luminance,
+            value.targeted_system_display_actual_peak_luminance) ||
+      !peak(value.mastering_display_actual_peak_luminance_flag,
+            value.num_rows_mastering_display_actual_peak_luminance,
+            value.num_cols_mastering_display_actual_peak_luminance,
+            value.mastering_display_actual_peak_luminance)) return false;
+  const auto& p = value.params[0];
+  if (p.num_distribution_maxrgb_percentiles > 15 || p.num_bezier_curve_anchors > 15 ||
+      p.tone_mapping_flag > 1 || p.color_saturation_mapping_flag > 1 ||
+      (!p.tone_mapping_flag && p.color_saturation_mapping_flag) ||
+      !HDRValue(p.average_maxrgb, 100000, 17, true) ||
+      !HDRValue(p.fraction_bright_pixels, 1000, 10)) return false;
+  for (const auto& max : p.maxscl)
+    if (!HDRValue(max, 100000, 17, true)) return false;
+  for (unsigned i = 0; i < p.num_distribution_maxrgb_percentiles; ++i)
+    if (p.distribution_maxrgb[i].percentage > 100 ||
+        !HDRValue(p.distribution_maxrgb[i].percentile, 100000, 17, true)) return false;
+  if (p.tone_mapping_flag)
+  {
+    if (!HDRValue(p.knee_point_x, 4095, 12) || !HDRValue(p.knee_point_y, 4095, 12)) return false;
+    for (unsigned i = 0; i < p.num_bezier_curve_anchors; ++i)
+      if (!HDRValue(p.bezier_curve_anchors[i], 1023, 10)) return false;
+    if (p.color_saturation_mapping_flag && !HDRValue(p.color_saturation_weight, 8, 6)) return false;
+  }
+  return true;
+}
+}
+
+std::shared_ptr<const VideoSourceSideData> VideoSourceSideData::Capture(
+    uint64_t generation, uint64_t serial, AVCodecID codec, const AVFrame* frame,
+    const AVDOVIDecoderConfigurationRecord* config,
+    const AVMasteringDisplayMetadata* mastering, const AVContentLightMetadata* light) noexcept
+{
+  try
+  {
+    auto result = std::shared_ptr<VideoSourceSideData>(new VideoSourceSideData(generation, serial));
+    const auto section = [&](unsigned bit, const auto& capture)
+    {
+      try { if (!capture()) result->m_rejected |= bit; }
+      catch (const std::bad_alloc&) { result->m_rejected |= bit; }
+    };
+    if (config && config->dv_profile)
+      section(1, [&]
+      {
+        if (config->dv_profile > 127 || config->dv_level > 63 ||
+            config->dv_bl_signal_compatibility_id > 15 || config->dv_md_compression > 3)
+          return false;
+        result->m_config.assign(24, 0);
+        auto& bytes = result->m_config;
+        bytes[0] = config->dv_version_major; bytes[1] = config->dv_version_minor;
+        bytes[2] = config->dv_profile << 1 | config->dv_level >> 5;
+        bytes[3] = (config->dv_level & 31) << 3 | !!config->rpu_present_flag << 2 |
+            !!config->el_present_flag << 1 | !!config->bl_present_flag;
+        bytes[4] = config->dv_bl_signal_compatibility_id << 4 | config->dv_md_compression << 2;
+        return true;
+      });
+    if (frame)
+    {
+      if (const auto* sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER))
+        section(2, [&]
+        {
+          if (!sd->data || !sd->size || sd->size > MAX_RAW_RPU - 2) return false;
+          std::vector<uint8_t> bytes;
+          if (codec == AV_CODEC_ID_HEVC)
+            bytes = {0x7c, 1}; // pinned FFmpeg9 excludes this NAL header
+          else if (codec != AV_CODEC_ID_AV1 || sd->size < 8 ||
+                   std::memcmp(sd->data, "\xb5\x00\x3b\x00\x00\x08\x00", 7))
+            return false;
+          bytes.insert(bytes.end(), sd->data, sd->data + sd->size);
+          result->m_rpu = std::move(bytes);
+          return true;
+        });
+      if (const auto* sd = av_frame_get_side_data(frame, AV_FRAME_DATA_DYNAMIC_HDR_PLUS))
+        section(4, [&]
+        {
+          if (!sd->data || sd->size != sizeof(AVDynamicHDRPlus)) return false;
+          const auto& value = *reinterpret_cast<const AVDynamicHDRPlus*>(sd->data);
+          if (!HDR10Plus(value)) return false;
+          result->m_hdr10plus = std::make_unique<AVDynamicHDRPlus>(value);
+          return true;
+        });
+      if (const auto* sd = av_frame_get_side_data(frame, AV_FRAME_DATA_MASTERING_DISPLAY_METADATA))
+      {
+        mastering = sd->data && sd->size == sizeof(*mastering) ?
+            reinterpret_cast<const AVMasteringDisplayMetadata*>(sd->data) : nullptr;
+        if (!mastering) result->m_rejected |= 8;
+      }
+      if (const auto* sd = av_frame_get_side_data(frame, AV_FRAME_DATA_CONTENT_LIGHT_LEVEL))
+      {
+        light = sd->data && sd->size == sizeof(*light) ?
+            reinterpret_cast<const AVContentLightMetadata*>(sd->data) : nullptr;
+        if (!light) result->m_rejected |= 16;
+      }
+    }
+    if (mastering) section(8, [&] { return Mastering(*mastering, result->m_mdcv); });
+    if (light) section(16, [&]
+    {
+      if (light->MaxCLL > 65535 || light->MaxFALL > 65535) return false;
+      std::vector<uint8_t> bytes;
+      PutBE(bytes, light->MaxCLL, 2); PutBE(bytes, light->MaxFALL, 2);
+      result->m_cll = std::move(bytes);
+      return true;
+    });
+    return result;
+  }
+  catch (const std::bad_alloc&) { return {}; } // diagnostics must not stop decoding
+}
+
+const std::string& VideoSourceSideData::JSON() const
+{
+  std::call_once(m_jsonOnce, [&]
+  {
+    try
+    {
+      CVariant object(CVariant::VariantTypeObject);
+      const auto add = [&](const char* key, const auto& bytes)
+      {
+        if (!bytes.empty())
+          object[key] = Base64::Encode(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+      };
+      add("dovi.config", m_config); add("dovi.rpu", m_rpu);
+      add("mdcv", m_mdcv); add("cll", m_cll);
+      if (m_hdr10plus)
+      {
+        // Stack storage avoids a raw allocation whose ownership could escape on failure.
+        std::array<uint8_t, AV_HDR_PLUS_MAX_PAYLOAD_SIZE + HDR10PLUS_HEADER.size()> bytes{};
+        std::copy(HDR10PLUS_HEADER.begin(), HDR10PLUS_HEADER.end(), bytes.begin());
+        uint8_t* data = bytes.data() + HDR10PLUS_HEADER.size();
+        size_t size = AV_HDR_PLUS_MAX_PAYLOAD_SIZE;
+        if (av_dynamic_hdr_plus_to_t35(m_hdr10plus.get(), &data, &size) >= 0)
+          object["hdr10plus"] = Base64::Encode(reinterpret_cast<const char*>(bytes.data()),
+                                              size + HDR10PLUS_HEADER.size());
+      }
+      if (!CJSONVariantWriter::Write(object, m_json, true)) m_json = "{}";
+    }
+    catch (const std::bad_alloc&) { m_json.clear(); }
+  });
+  return m_json;
+}
diff --git a/xbmc/cores/VideoSourceSideData.h b/xbmc/cores/VideoSourceSideData.h
--- /dev/null
+++ b/xbmc/cores/VideoSourceSideData.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstdint>
+
+extern "C"
+{
+#include <libavcodec/codec_id.h>
+#include <libavutil/dovi_meta.h>
+#include <libavutil/frame.h>
+#include <libavutil/hdr_dynamic_metadata.h>
+#include <libavutil/mastering_display_metadata.h>
+}
+
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// Original source facts, owned with a picture and published only after acceptance.
+// Logical data is immutable; only the on-demand wire representation is cached.
+class VideoSourceSideData
+{
+public:
+  static std::shared_ptr<const VideoSourceSideData> Capture(
+      uint64_t generation, uint64_t serial, AVCodecID codec, const AVFrame* frame,
+      const AVDOVIDecoderConfigurationRecord* config,
+      const AVMasteringDisplayMetadata* mastering = nullptr,
+      const AVContentLightMetadata* light = nullptr) noexcept;
+  uint64_t Generation() const { return m_generation; }
+  uint64_t Serial() const { return m_serial; }
+  unsigned RejectedSections() const { return m_rejected; }
+  const std::string& JSON() const;
+
+private:
+  VideoSourceSideData(uint64_t generation, uint64_t serial)
+    : m_generation(generation), m_serial(serial) {}
+  const uint64_t m_generation, m_serial;
+  unsigned m_rejected{};
+  std::vector<uint8_t> m_config, m_rpu, m_mdcv, m_cll;
+  std::unique_ptr<const AVDynamicHDRPlus> m_hdr10plus;
+  mutable std::once_flag m_jsonOnce;
+  mutable std::string m_json;
+};
diff --git a/xbmc/utils/DVBridgeDiagnosticState.h b/xbmc/utils/DVBridgeDiagnosticState.h
--- /dev/null
+++ b/xbmc/utils/DVBridgeDiagnosticState.h
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <array>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace DVBRIDGE
+{
+// Enabled without Kodi's global debug mode. Developers can disable the entire
+// supplement in one place; it must never change output or retry decisions.
+inline bool DiagnosticsEnabled()
+{
+  static const bool enabled = [] {
+    const char* setting = std::getenv("DVBRIDGE_DIAGNOSTICS");
+    return !setting || setting[0] != '0' || setting[1] != '\0';
+  }();
+  return enabled;
+}
+
+inline uint64_t DiagnosticNowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+struct DiagnosticProperty
+{
+  bool inventory;
+  std::optional<uint64_t> value;
+  DiagnosticProperty(bool known, std::optional<uint64_t> cached) : inventory(known),
+      value(known ? cached : std::nullopt) {}
+  const char* Presence() const { return !inventory ? "unknown" : value ? "present" : "absent"; }
+  uint64_t Code() const { return !inventory ? 0 : value ? 2 : 1; }
+  std::string Value() const { return value ? std::to_string(*value) : "unavailable"; }
+  bool operator==(const DiagnosticProperty&) const = default;
+};
+
+enum class DiagnosticEvent { Normal, Failure, Final, Connection };
+
+// One active native stream, shared by every producer. Pure observation: none of
+// these facts are consumed by output selection, retry, or GPU synchronization.
+// Callers serialize through DiagnosticLog's private diagnostic mutex.
+class DiagnosticSession
+{
+public:
+  void Open() { *this = {}; }
+  void Candidate(uint64_t now)
+  {
+    if (!m_requested && !m_stream && !m_ended)
+    { m_requested = true; m_waitStart = now; m_stage = "stream-candidate"; }
+  }
+  void Observe(uint64_t now, uint64_t stream, uint64_t picture, uint64_t revision,
+               uint64_t policy, const char* stage, bool requested, bool paused)
+  {
+    if (!stream || stream < m_stream || (stream == m_stream && m_ended)) return;
+    if (stream != m_stream)
+    {
+      // Binding the first picture identifies the candidate already observed by
+      // this playback. It must not grant a second budget or failure exemption.
+      if (m_stream) *this = {};
+      m_stream = stream; m_waitStart = now;
+    }
+    if (revision != m_revision || policy != m_policy)
+    {
+      // A seek/policy generation may clear its reason, never the stream's line
+      // budget or first-failure exemption (oscillation cannot refill either).
+      m_failure = nullptr; m_waitStart = now; m_waited = false;
+    }
+    if (!requested || paused || !m_requested || m_paused) m_waitStart = now;
+    m_requested = requested; m_paused = paused;
+    m_picture = picture; m_revision = revision; m_policy = policy; m_stage = stage;
+  }
+  bool Admit(uint64_t now, DiagnosticEvent event)
+  {
+    if (event == DiagnosticEvent::Final)
+    {
+      if ((!m_stream && !m_requested) || m_ended) return false;
+      m_ended = true;
+      return true;
+    }
+    if (event == DiagnosticEvent::Failure && !m_firstFailure)
+    { m_firstFailure = true; return true; }
+    if (event == DiagnosticEvent::Connection) return true;
+    // Clamp backwards observations: no unsigned wrap can refill the budget.
+    if (now < m_lastNow) now = m_lastNow;
+    m_lastNow = now;
+    while (m_size && now >= m_lines[m_head] && now - m_lines[m_head] >= 30000)
+    { m_head = (m_head + 1) % m_lines.size(); --m_size; }
+    if (m_size == m_lines.size()) { ++m_suppressed; return false; }
+    m_lines[(m_head + m_size) % m_lines.size()] = now;
+    ++m_size;
+    return true;
+  }
+  bool WaitDue(uint64_t now)
+  {
+    if (m_ended || !m_requested || m_paused || m_presented ||
+        now < m_waitStart || now - m_waitStart < 5000 ||
+        (m_waited && (now < m_lastWait || now - m_lastWait < 30000))) return false;
+    m_waited = true; m_lastWait = now; return true;
+  }
+  void Presented(uint64_t stream) { if (stream == m_stream) m_presented = true; }
+  void Paused(uint64_t now, bool paused)
+  {
+    if (m_paused != paused) { m_waitStart = now; m_waited = false; }
+    m_paused = paused;
+  }
+  void Failure(const char* stage) { if (!m_failure) m_failure = stage; m_stage = stage; }
+  void Stage(const char* stage) { m_stage = stage; }
+  void DisableRequest() { m_requested = false; m_stage = "not-requested"; }
+  void Truncated() { ++m_truncated; }
+  void Suppress() { ++m_suppressed; }
+  bool FailureReported() const { return m_firstFailure; }
+  uint64_t Stream() const { return m_stream; }
+  uint64_t Picture() const { return m_picture; }
+  uint64_t Revision() const { return m_revision; }
+  uint64_t Policy() const { return m_policy; }
+  uint64_t Suppressed() const { return m_suppressed; }
+  uint64_t Truncations() const { return m_truncated; }
+  bool FirstPresented() const { return m_presented; }
+  const char* Stage() const { return m_stage ? m_stage : "unavailable"; }
+  const char* FirstFailure() const { return m_failure ? m_failure : "none"; }
+private:
+  std::array<uint64_t, 24> m_lines{};
+  size_t m_head{}, m_size{};
+  uint64_t m_lastNow{}, m_suppressed{}, m_truncated{};
+  uint64_t m_stream{}, m_picture{}, m_revision{}, m_policy{};
+  uint64_t m_waitStart{}, m_lastWait{};
+  const char* m_stage{}, *m_failure{}; // Static labels only.
+  bool m_requested{}, m_paused{}, m_presented{}, m_firstFailure{}, m_ended{}, m_waited{};
+};
+
+class DiagnosticInterval
+{
+public:
+  bool Due(uint64_t now)
+  {
+    if (m_reported && (now<m_last || now-m_last<5000)) return false;
+    m_reported=true;m_last=now;return true;
+  }
+private:
+  uint64_t m_last{};
+  bool m_reported{};
+};
+
+// A bounded first-event/change budget plus a 30-second summary. Alternating
+// failures/recoveries cannot reset the budget and turn this into per-frame IO.
+class DiagnosticFailures
+{
+public:
+  bool Record(uint64_t now, const char* stage = "failure", int error = 0)
+  {
+    ++m_count;
+    if (!m_consecutive) m_firstConsecutive=now;
+    ++m_consecutive;
+    const bool changed = stage != m_stage || error != m_error;
+    m_stage = stage;
+    m_error = error;
+    if (!m_reported || now - m_window >= 30000)
+    {
+      m_window = now;
+      m_reports = 0;
+    }
+    if ((!m_reported || changed || now - m_last >= 30000) && m_reports < 4)
+    {
+      m_reported = true;
+      ++m_reports;
+      m_last = now;
+      return true;
+    }
+    return false;
+  }
+  bool Recovered(uint64_t now)
+  {
+    if (!m_consecutive)
+      return false;
+    m_consecutive = 0;
+    ++m_recoveries;
+    if (m_recoveries == 1 || now - m_lastRecovery >= 30000)
+    {
+      m_lastRecovery = now;
+      return true;
+    }
+    return false;
+  }
+  uint64_t Count() const { return m_count; }
+  uint64_t Recoveries() const { return m_recoveries; }
+  bool ReferenceDue(uint64_t now,bool eligible)
+  {
+    if (!eligible || !m_consecutive) { m_firstConsecutive=now; return false; }
+    if (m_referenceWarned || m_consecutive<30 || now<m_firstConsecutive ||
+        now-m_firstConsecutive<5000) return false;
+    m_referenceWarned=true;
+    return true;
+  }
+  void Reset() { *this = {}; }
+
+private:
+  uint64_t m_count{0}, m_consecutive{0}, m_recoveries{0};
+  uint64_t m_window{0}, m_last{0}, m_lastRecovery{0};
+  unsigned m_reports{0};
+  const char* m_stage{nullptr}; // Callers pass static stage labels.
+  int m_error{0};
+  bool m_reported{false};
+  uint64_t m_firstConsecutive{};
+  bool m_referenceWarned{};
+};
+} // namespace DVBRIDGE
diff --git a/xbmc/utils/DVBridgeKernelLog.h b/xbmc/utils/DVBridgeKernelLog.h
--- /dev/null
+++ b/xbmc/utils/DVBridgeKernelLog.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace DVBRIDGE
+{
+// /dev/kmsg records: priority,sequence,monotonic_us,flags;message\ncontext.
+// Only kernel-origin DV/display incidents are copied, never general system logs.
+class KernelLogFilter
+{
+public:
+  std::optional<std::string> Accept(std::string_view record, uint64_t nowUs)
+  {
+    uint64_t priority, sequence, timestamp;
+    if (!Number(record, priority) || !Number(record, sequence) || !Number(record, timestamp))
+      return {};
+    const auto separator = record.find(';');
+    if (separator == record.npos || priority > 7)
+      return {};
+    if (m_seen && sequence <= m_sequence)
+      return {};
+    if (m_seen && sequence-m_sequence>1)
+    {
+      m_pendingLost+=sequence-m_sequence-1;
+      m_lost+=sequence-m_sequence-1;
+    }
+    m_seen = true;
+    m_sequence = sequence;
+    if (timestamp > nowUs || nowUs - timestamp > 60000000)
+      return {};
+    auto message = record.substr(separator + 1);
+    message = message.substr(0, message.find('\n'));
+    // i915/xe faults can explain a failed flip without a DV-specific rejection.
+    // Restrict these additional records to warning-or-worse display incidents.
+    const bool intel = message.find("i915 ") != message.npos ||
+                       message.find("xe ") != message.npos;
+    const bool incident = priority <= 4 && intel &&
+        (message.find("GPU HANG") != message.npos ||
+         message.find("Resetting") != message.npos ||
+         message.find("reset failed") != message.npos ||
+         message.find("underrun") != message.npos ||
+         message.find("flip_done timed out") != message.npos ||
+         message.find("vblank wait timed out") != message.npos ||
+         message.find("link training failed") != message.npos ||
+         message.find("link-status BAD") != message.npos);
+    if (message.find("DVBridge:") == message.npos && !incident)
+      return {};
+    // Kernel escapes untrusted characters. Bound the copied record as well.
+    const std::string text(message.substr(0, 2048));
+    const bool truncated=message.size()>2048;
+    m_truncated|=truncated;
+    for (const auto& recent : m_recent)
+      if (recent.first == text && nowUs - recent.second < 30000000)
+        return {};
+    m_recent.emplace_back(text, nowUs);
+    if (m_recent.size() > 16)
+      m_recent.pop_front();
+    auto result="boot_us=" + std::to_string(timestamp) + " seq=" + std::to_string(sequence) +
+           (m_pendingLost ? " lost="+std::to_string(m_pendingLost) : "")+" " + text+
+           (truncated ? " [truncated]" : "");
+    m_pendingLost=0;
+    return result;
+  }
+  bool Incomplete() const { return m_lost || m_truncated; }
+
+private:
+  static bool Number(std::string_view& input, uint64_t& value)
+  {
+    const auto comma = input.find(',');
+    if (comma == input.npos || comma == 0)
+      return false;
+    const auto result = std::from_chars(input.data(), input.data() + comma, value);
+    if (result.ec != std::errc{} || result.ptr != input.data() + comma)
+      return false;
+    input.remove_prefix(comma + 1);
+    return true;
+  }
+  uint64_t m_sequence{0};
+  bool m_seen{false};
+  uint64_t m_pendingLost{},m_lost{};
+  bool m_truncated{};
+  std::deque<std::pair<std::string, uint64_t>> m_recent;
+};
+}
