diff --git a/xbmc/utils/DVBridgeDiagnosticState.h b/xbmc/utils/DVBridgeDiagnosticState.h
--- /dev/null
+++ b/xbmc/utils/DVBridgeDiagnosticState.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+
+namespace DVBRIDGE
+{
+// Enabled without Kodi's global debug mode. Developers can disable the entire
+// supplement in one place; it must never change output or retry decisions.
+inline bool DiagnosticsEnabled()
+{
+  static const bool enabled = [] {
+    const char* setting = std::getenv("DVBRIDGE_DIAGNOSTICS");
+    return !setting || setting[0] != '0' || setting[1] != '\0';
+  }();
+  return enabled;
+}
+
+inline uint64_t DiagnosticNowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+class DiagnosticInterval
+{
+public:
+  bool Due(uint64_t now)
+  {
+    if (m_reported && (now<m_last || now-m_last<5000)) return false;
+    m_reported=true;m_last=now;return true;
+  }
+private:
+  uint64_t m_last{};
+  bool m_reported{};
+};
+
+// A bounded first-event/change budget plus a 30-second summary. Alternating
+// failures/recoveries cannot reset the budget and turn this into per-frame IO.
+class DiagnosticFailures
+{
+public:
+  bool Record(uint64_t now, const char* stage = "failure", int error = 0)
+  {
+    ++m_count;
+    if (!m_consecutive) m_firstConsecutive=now;
+    ++m_consecutive;
+    const bool changed = stage != m_stage || error != m_error;
+    m_stage = stage;
+    m_error = error;
+    if (!m_reported || now - m_window >= 30000)
+    {
+      m_window = now;
+      m_reports = 0;
+    }
+    if ((!m_reported || changed || now - m_last >= 30000) && m_reports < 4)
+    {
+      m_reported = true;
+      ++m_reports;
+      m_last = now;
+      return true;
+    }
+    return false;
+  }
+  bool Recovered(uint64_t now)
+  {
+    if (!m_consecutive)
+      return false;
+    m_consecutive = 0;
+    ++m_recoveries;
+    if (m_recoveries == 1 || now - m_lastRecovery >= 30000)
+    {
+      m_lastRecovery = now;
+      return true;
+    }
+    return false;
+  }
+  uint64_t Count() const { return m_count; }
+  uint64_t Recoveries() const { return m_recoveries; }
+  bool ReferenceDue(uint64_t now,bool eligible)
+  {
+    if (!eligible || !m_consecutive) { m_firstConsecutive=now; return false; }
+    if (m_referenceWarned || m_consecutive<30 || now<m_firstConsecutive ||
+        now-m_firstConsecutive<5000) return false;
+    m_referenceWarned=true;
+    return true;
+  }
+  void Reset() { *this = {}; }
+
+private:
+  uint64_t m_count{0}, m_consecutive{0}, m_recoveries{0};
+  uint64_t m_window{0}, m_last{0}, m_lastRecovery{0};
+  unsigned m_reports{0};
+  const char* m_stage{nullptr}; // Callers pass static stage labels.
+  int m_error{0};
+  bool m_reported{false};
+  uint64_t m_firstConsecutive{};
+  bool m_referenceWarned{};
+};
+} // namespace DVBRIDGE
diff --git a/xbmc/utils/DVBridgeKernelLog.h b/xbmc/utils/DVBridgeKernelLog.h
--- /dev/null
+++ b/xbmc/utils/DVBridgeKernelLog.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace DVBRIDGE
+{
+// /dev/kmsg records: priority,sequence,monotonic_us,flags;message\ncontext.
+// Only kernel-origin DV/display incidents are copied, never general system logs.
+class KernelLogFilter
+{
+public:
+  std::optional<std::string> Accept(std::string_view record, uint64_t nowUs)
+  {
+    uint64_t priority, sequence, timestamp;
+    if (!Number(record, priority) || !Number(record, sequence) || !Number(record, timestamp))
+      return {};
+    const auto separator = record.find(';');
+    if (separator == record.npos || priority > 7)
+      return {};
+    if (m_seen && sequence <= m_sequence)
+      return {};
+    if (m_seen && sequence-m_sequence>1)
+    {
+      m_pendingLost+=sequence-m_sequence-1;
+      m_lost+=sequence-m_sequence-1;
+    }
+    m_seen = true;
+    m_sequence = sequence;
+    if (timestamp > nowUs || nowUs - timestamp > 60000000)
+      return {};
+    auto message = record.substr(separator + 1);
+    message = message.substr(0, message.find('\n'));
+    // i915/xe faults can explain a failed flip without a DV-specific rejection.
+    // Restrict these additional records to warning-or-worse display incidents.
+    const bool intel = message.find("i915 ") != message.npos ||
+                       message.find("xe ") != message.npos;
+    const bool incident = priority <= 4 && intel &&
+        (message.find("GPU HANG") != message.npos ||
+         message.find("Resetting") != message.npos ||
+         message.find("reset failed") != message.npos ||
+         message.find("underrun") != message.npos ||
+         message.find("flip_done timed out") != message.npos ||
+         message.find("vblank wait timed out") != message.npos ||
+         message.find("link training failed") != message.npos ||
+         message.find("link-status BAD") != message.npos);
+    if (message.find("DVBridge:") == message.npos && !incident)
+      return {};
+    // Kernel escapes untrusted characters. Bound the copied record as well.
+    const std::string text(message.substr(0, 2048));
+    const bool truncated=message.size()>2048;
+    m_truncated|=truncated;
+    for (const auto& recent : m_recent)
+      if (recent.first == text && nowUs - recent.second < 30000000)
+        return {};
+    m_recent.emplace_back(text, nowUs);
+    if (m_recent.size() > 16)
+      m_recent.pop_front();
+    auto result="boot_us=" + std::to_string(timestamp) + " seq=" + std::to_string(sequence) +
+           (m_pendingLost ? " lost="+std::to_string(m_pendingLost) : "")+" " + text+
+           (truncated ? " [truncated]" : "");
+    m_pendingLost=0;
+    return result;
+  }
+  bool Incomplete() const { return m_lost || m_truncated; }
+
+private:
+  static bool Number(std::string_view& input, uint64_t& value)
+  {
+    const auto comma = input.find(',');
+    if (comma == input.npos || comma == 0)
+      return false;
+    const auto result = std::from_chars(input.data(), input.data() + comma, value);
+    if (result.ec != std::errc{} || result.ptr != input.data() + comma)
+      return false;
+    input.remove_prefix(comma + 1);
+    return true;
+  }
+  uint64_t m_sequence{0};
+  bool m_seen{false};
+  uint64_t m_pendingLost{},m_lost{};
+  bool m_truncated{};
+  std::deque<std::pair<std::string, uint64_t>> m_recent;
+};
+}
