+                                            DVHandoff handoff)
+{
+  return Configure(picture, fps, orientation,
+                   handoff == DVHandoff::HDR10 ? RetainedOutput::HDR10 : RetainedOutput::NativeDV);
+}
+
+bool CRendererVAAPIGL::HDR10AILookahead() const
+{
+  return m_aiBuffers > NUM_BUFFERS && m_aiLookahead;
+}
