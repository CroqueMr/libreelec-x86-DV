+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || !drm->CB1PresentationTime()) return std::nullopt;
+  return std::make_pair(drm->CB1PresentationPts(), drm->CB1PresentationTime());
+}
