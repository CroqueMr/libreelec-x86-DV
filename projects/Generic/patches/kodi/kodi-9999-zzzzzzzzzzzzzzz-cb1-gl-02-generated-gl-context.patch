+  caps.nativeDV = SupportsNativeDVOutput();
+  caps.hdr10 = SupportsHDR10Conversion();
+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const auto* display = GetDisplayInfo();
