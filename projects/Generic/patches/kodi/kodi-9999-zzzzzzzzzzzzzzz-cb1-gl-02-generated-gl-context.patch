+  if (m_DRM->SetMode(res) && m_DRM->SetVideoMode(res,nullptr) && EndDVBridge())
+    return true;
+  m_DRM->SetMode(previous);
+  m_DRM->SetVideoMode(previous,nullptr);
+  return false;
+}
