+void CWinSystemGbmGLContext::RefreshDVOutputCapabilities()
+{
+  if (eglGetCurrentContext() == EGL_NO_CONTEXT ||
+      eglGetCurrentContext() != m_eglContext.GetEGLContext()) return;
