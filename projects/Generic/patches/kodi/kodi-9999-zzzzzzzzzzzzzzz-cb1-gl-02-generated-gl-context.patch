+DVBRIDGE::OutputCapabilities CWinSystemGbmGLContext::GetDVOutputCapabilities(
+    const VideoPicture* picture, bool allowModeSwitch) const
+{
+  return GetDVOutputCapabilities(picture, DVBRIDGE::FrameOutputSettings(), allowModeSwitch);
+}
+
+DVBRIDGE::OutputCapabilities CWinSystemGbmGLContext::GetDVOutputCapabilities(
+    const VideoPicture* picture, const DVBRIDGE::OutputPreferences& preferences, bool allowModeSwitch) const
+{
+  std::lock_guard lock(m_dvCapabilityMutex);
+  auto caps = m_dvCapabilities;
+  caps.hdr10MaxBpc = m_hdr10MaxBpc.load();
+  caps.playerLed = DVBRIDGE::SelectLldvTransport(m_dvLldvStatus,
+      preferences.lldvFormat, allowModeSwitch).connectorId != 0;
+  if (allowModeSwitch)
+  {
+    caps.nativeDV = m_dvAvailableNativeDV;
+    caps.hdr10 = m_dvAvailableHDR10;
+  }
+  if (!picture) return caps;
+  caps.sourceKnown = true;
+  caps.stereoSource = !picture->stereoMode.empty();
+  caps.isDV = picture->doviSourceInfo.profile || picture->hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION;
+  caps.isHLG = !caps.isDV && picture->hdrType == StreamHdrType::HDR_TYPE_HLG;
+  caps.isHDR10 = !caps.isDV && !caps.isHLG && DVBRIDGE::IsHDR10Family(picture->hdrType);
+  caps.hdr10PlusSource = !caps.isDV && picture->hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS;
+  caps.isHDR10Plus = caps.hdr10PlusSource && picture->sourceSideData &&
+      picture->sourceSideData->Generation() == picture->doviSourceInfo.informationGeneration &&
+      picture->sourceSideData->Serial() && picture->sourceSideData->HDR10Plus();
+  if (caps.stereoSource) return caps;
+  if (caps.isHDR10 || caps.isHLG)
+  {
+#ifdef CB1_HAS_HDR10_AI
+    caps.processing=caps.hdr10Processing;
+    const bool valid = m_dvImportUsable && m_dvImportBinding.Valid() &&
+        m_dvImportBinding == picture->doviSourceBinding &&
+        m_dvImportGeneration == caps.generation &&
+        picture->doviSourcePts != AV_NOPTS_VALUE &&
+        !(picture->iFlags & DVP_FLAG_INTERLACED) && picture->stereoMode.empty();
+    caps.isHDR10Plus = caps.isHDR10Plus && valid && DVBRIDGE::HDR10PlusDVWholeSource(
+        m_dvImportGeometry.crop, m_dvImportGeometry.source_width, m_dvImportGeometry.source_height);
+    for (auto& mode : caps.processing)
+      if (!valid) mode = {false,DVBRIDGE::OutputReason::SourceIneligible};
+#endif
+    return caps;
+  }
+  if (!caps.isDV) return caps;
+  const auto binding = picture->doviSourceBinding.Valid() ?
+      picture->doviSourceBinding : picture->doviMetadata.Binding();
+  if (!m_dvImportBinding.Valid() || m_dvImportBinding != binding ||
+      m_dvImportGeneration != caps.generation)
+  {
+    caps.processingKnown = false;
+    return caps;
+  }
+  const auto& metadata = picture->doviMetadata;
+  auto importGeometry=m_dvImportGeometry;
+  importGeometry.ignore_l5=false;
+  const bool paired = picture->doviEnhancement && picture->doviEnhancementBinding.Valid() &&
+      picture->doviEnhancementBinding == metadata.Binding() &&
+      picture->doviEnhancement->pts == picture->doviSourcePts;
+  dvbridge_color color{};
+  unsigned margins[4];
+  const bool valid = m_dvImportUsable && metadata.Binding().Valid() &&
+      picture->doviSourcePts != AV_NOPTS_VALUE && !(picture->iFlags & DVP_FLAG_INTERLACED) &&
+      picture->stereoMode.empty() &&
+      dvbridge_frame_area(margins, metadata.Data(), metadata.Size(), importGeometry) &&
+      dvbridge_map_color(&color, metadata.Data(), metadata.Size(), paired);
+  dvbridge_hdr10_session session{};
+  const bool basic = valid && dvbridge_hdr10_session_init(&session, metadata.Data(), metadata.Size());
+  for (unsigned mode = 1; mode < caps.processing.size(); ++mode)
+  {
+    if (!valid)
+      caps.processing[mode] = {false, DVBRIDGE::OutputReason::SourceIneligible};
+    else if (mode == DVBRIDGE_MODE_HDR10_BASIC && !basic)
+      caps.processing[mode] = {false, DVBRIDGE::OutputReason::SourceIneligible};
+    else if ((mode == DVBRIDGE_MODE_MASTER_REFERENCE || mode == DVBRIDGE_MODE_PLAYER_LED) && caps.processing[mode].usable)
+    {
+      pl_cb1_dovi_reference raw{};
+      if(cb1_master_reference_map(&raw,metadata.Data(),metadata.Size(),paired)!=CB1_MASTER_READY ||
+         (mode == DVBRIDGE_MODE_MASTER_REFERENCE && !cb1_master_reference_transport(metadata.Data(),metadata.Size())))
+        caps.processing[mode]={false,DVBRIDGE::OutputReason::SourceIneligible};
+      const auto masterChroma = picture->chroma_position == AVCHROMA_LOC_UNSPECIFIED ?
+          (picture->doviSourceInfo.profile == 7 ? AVCHROMA_LOC_TOPLEFT : AVCHROMA_LOC_LEFT) : picture->chroma_position;
+      const auto enhancementChroma = picture->doviEnhancement &&
+          picture->doviEnhancement->chroma_location == AVCHROMA_LOC_UNSPECIFIED ?
+          AVCHROMA_LOC_TOPLEFT : picture->doviEnhancement ? picture->doviEnhancement->chroma_location : AVCHROMA_LOC_UNSPECIFIED;
+      const bool masterPhase = (masterChroma == AVCHROMA_LOC_LEFT ||
+          masterChroma == AVCHROMA_LOC_TOPLEFT) &&
+          (!raw.residual || masterChroma == enhancementChroma);
+      if(!masterPhase) caps.processing[mode]={false,DVBRIDGE::OutputReason::SourceIneligible};
+    }
+    else if ((mode == DVBRIDGE_MODE_HDR10_EXPERT || mode == DVBRIDGE_MODE_ENHANCED_DV) && caps.processing[mode].usable && preferences.ProfileValid(static_cast<dvbridge_mode>(mode)))
+    {
+      auto policy = preferences.Policy();
+      policy.mode = static_cast<dvbridge_mode>(mode);
+      if (mode != DVBRIDGE_MODE_ENHANCED_DV)
+        policy.adaptive = DVBRIDGE_ADAPTIVE_A;
+      policy.tv = mode==DVBRIDGE_MODE_HDR10_EXPERT ?
+          dvbridge_tv_profile{preferences.expertPeak,DVBRIDGE_PANEL_OLED,
+              static_cast<dvbridge_gamut>(preferences.expertGamut)} :
+          dvbridge_tv_profile{preferences.peak,static_cast<dvbridge_panel>(preferences.panel),
+              static_cast<dvbridge_gamut>(preferences.gamut)};
+      policy.expert_black_nits=mode==DVBRIDGE_MODE_HDR10_EXPERT?preferences.expertBlack:0;
+      pl_color_space nominal{};
+      dvbridge_hdr10_metadata signal{};
+      if (!dvbridge_reference_map(&color, &nominal, &signal, &policy,
+                                 metadata.Data(), metadata.Size(), paired))
+        caps.processing[mode] = {false, DVBRIDGE::OutputReason::SourceIneligible};
+    }
+  }
+  return caps;
+}
+
+DVBRIDGE::OutputSelection CWinSystemGbmGLContext::SelectedDVOutput(const VideoPicture* picture) const
+{
+  const auto preferences = DVBRIDGE::FrameOutputSettings(picture && picture->hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS,
+      picture && !picture->doviSourceInfo.profile && picture->hdrType == StreamHdrType::HDR_TYPE_HLG);
+  auto caps = GetDVOutputCapabilities(picture, preferences);
+  return SelectedDVOutput(picture, preferences, caps);
+}
+
+DVBRIDGE::OutputSelection CWinSystemGbmGLContext::SelectedDVOutput(const VideoPicture* picture,
+    const DVBRIDGE::OutputPreferences& preferences, DVBRIDGE::OutputCapabilities& caps) const
+{
+  const auto binding = picture ? (picture->doviSourceBinding.Valid() ?
+      picture->doviSourceBinding : picture->doviMetadata.Binding()) : DVBRIDGE::SourceBinding{};
+  auto reason = DVBRIDGE::OutputReason::None;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (binding.stream == m_dvActivationStream && preferences.revision == m_dvActivationPolicy)
+    {
+      caps.nativeDV &= !m_dvNativeFailed;
+      caps.hdr10 &= !m_dvHDR10Failed;
+      if (m_dvPlayerLedFailed) caps.processing[DVBRIDGE_MODE_PLAYER_LED] =
+          {false, DVBRIDGE::OutputReason::ActivationFailed};
+      if (m_dvSDRFailed) caps.processing[DVBRIDGE_MODE_SDR] =
+          {false, DVBRIDGE::OutputReason::ActivationFailed};
+      reason = m_dvActivationReason;
+    }
+  }
+  auto result = DVBRIDGE::SelectOutput(preferences, caps);
+#ifdef CB1_HAS_HDR10_AI
+  if ((caps.isHDR10 || caps.isHLG) && result.route == DVBRIDGE::OutputRoute::NativeDV)
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    const bool current=binding.stream==m_aiActivation.stream &&
+        binding.revision==m_aiActivation.revision && preferences.revision==m_aiPolicy;
+    if (!current || !m_aiReady || m_aiFallback)
+      result = {DVBRIDGE::OutputRoute::Vanilla, result.policy,
+          current && m_aiFallback ? DVBRIDGE::OutputReason::ActivationFailed :
+                                    DVBRIDGE::OutputReason::ProcessingPending};
+  }
+#endif
+  if (reason != DVBRIDGE::OutputReason::None) result.reason = reason;
+  return result;
+}
+
+#ifdef CB1_HAS_HDR10_AI
+#ifndef CB1_L1L3_BUNDLE_DIR
+#define CB1_L1L3_BUNDLE_DIR "/usr/share/cb1/l1l3"
+#endif
+bool CWinSystemGbmGLContext::HDR10AILookaheadActive() const
+{
+  std::lock_guard lock(m_dvCapabilityMutex);
+  return m_aiActive;
+}
+
+bool CWinSystemGbmGLContext::PrepareHDR10AIQueue(const VideoPicture& picture,
+    std::span<const CDVBridgeGLES::Layer> queue, bool end, bool paused,
+    uint64_t presentationDeadline)
+{
+  const auto preferences = DVBRIDGE::FrameOutputSettings(picture.hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS,
+      !picture.doviSourceInfo.profile && picture.hdrType == StreamHdrType::HDR_TYPE_HLG);
+  const auto caps = GetDVOutputCapabilities(&picture, preferences);
+  const auto binding = picture.doviSourceBinding;
+  const auto requested=DVBRIDGE::SelectOutput(preferences,caps);
+  if ((!caps.isHDR10 && !caps.isHLG) || requested.route!=DVBRIDGE::OutputRoute::NativeDV)
+  {
+    const bool failed=caps.sourceKnown && !caps.stereoSource && (caps.isHDR10 || caps.isHLG) &&
+        preferences.hdr10Source!=DVBRIDGE::HDR10SourceMode::Native &&
+        requested.reason!=DVBRIDGE::OutputReason::None &&
+        requested.reason!=DVBRIDGE::OutputReason::ProcessingPending;
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      m_aiActive=m_aiReady=false;
+      if (failed && !m_dvFatalConsumed) m_dvFatalReason=requested.reason;
+      if (!failed)
+      {
+        m_aiActivation={};
+        m_aiPolicy=0;
+        m_aiFallback=false;
+      }
+    }
+    const bool ready=!m_dvContext || m_dvContext->StopHDR10AI();
+    const bool pending=requested.reason==DVBRIDGE::OutputReason::ProcessingPending;
+    if (ready)
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      m_aiSelectionPolicy=pending ? 0 : preferences.revision;
+    }
+    return ready && !failed && !pending;
+  }
+  // The ordinary commit retires the prior renderer before AI can prime it again.
+  if (m_dvOrdinaryFrame || m_dvEndPending || m_dvStopPending) return false;
+  if (queue.empty() || !(queue.front().binding == binding)) return false;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (binding.stream != m_aiActivation.stream ||
+        binding.revision != m_aiActivation.revision || preferences.revision != m_aiPolicy)
+    {
+      m_aiActivation = binding;
+      m_aiPolicy = preferences.revision;
+      m_aiReady = m_aiFallback = false;
+    }
+    m_aiActive=!m_aiFallback;
+    if (m_aiFallback) return false;
+  }
+  if (!m_dvContext) m_dvContext = std::make_shared<CDVBridgeGLES::Context>();
+  auto decision = HDR10AISource::Decision::Native;
+  cb1_ai_result prediction{};
+  if (m_dvContext->Initialize(false))
+  {
+    // Kodi's display-reset delay is not time spent waiting for an AI prediction.
+    paused |= (picture.hdrType == StreamHdrType::HDR_TYPE_HDR10 || caps.isHLG) && m_dispReset;
+    decision = m_dvContext->PrepareHDR10AIQueue(queue, preferences,
+        CB1_L1L3_BUNDLE_DIR, DVBRIDGE::DiagnosticNowMs(), end, &prediction, paused,
+        presentationDeadline);
+  }
+  else m_dvContext->HDR10AI().RecordStatus("analysis-context",CB1_AI_INCOMPATIBLE);
+  if (decision == HDR10AISource::Decision::Prepare &&
+      (!m_dvBridge || !m_dvBridge->CommittedHDR10AI()))
+  {
+    // Prime the output before Kodi starts the playback clock.
+    {
+      std::lock_guard lock(m_dvCapabilityMutex);
+      m_aiReady = true;
+    }
+    auto status = CDVBridgeGLES::FrameStatus::Pending;
+    const bool outputReady = PrepareDVOutputFrame(picture) && BeginDVBridge();
+    if (outputReady)
+      status = m_dvBridge->PrepareHDR10AIFrame(queue.front(),
+          m_dvImportGeometry, preferences, prediction, m_dvSelection.policy);
+    const auto result = status == CDVBridgeGLES::FrameStatus::Ready ||
+        status == CDVBridgeGLES::FrameStatus::Reused ? CB1_AI_READY :
+        status == CDVBridgeGLES::FrameStatus::Failed ||
+        status == CDVBridgeGLES::FrameStatus::Unsupported ? CB1_AI_INCOMPATIBLE : CB1_AI_PENDING;
+    m_dvContext->HDR10AI().RecordStatus(outputReady ? "rgb-prepare" : "rgb-output-setup",result);
+    decision = m_dvContext->HDR10AI().Preparation(binding, result, DVBRIDGE::DiagnosticNowMs());
+  }
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_aiReady |= decision == HDR10AISource::Decision::Prepare;
+    m_aiFallback = decision == HDR10AISource::Decision::Native;
+    m_aiActive = !m_aiFallback;
+    if (decision != HDR10AISource::Decision::Wait)
+      m_aiSelectionPolicy=preferences.revision;
+  }
+  if (decision == HDR10AISource::Decision::Native)
+  {
+    const auto& source = m_dvContext->HDR10AI();
+    const auto metrics = source.Metrics();
+    DVBRIDGE::DiagnosticLog(LOGWARNING,
+        "CB1 HDR10 AI: requested rendering failed stream={} revision={} policy={} stage={} status={} queue={} coverage_s={} pictures={} gpu_submissions={} readback_bytes={} inferences={} prepared={} committed={} end={} paused={} head={} last_submitted={}",
+        binding.stream, binding.revision, preferences.revision,
+        source.DiagnosticStage(),int(source.DiagnosticStatus()),queue.size(),
+        queue.back().pts-queue.front().pts,metrics.pictures,metrics.gpu_submissions,
+        metrics.readback_bytes,metrics.inferences,source.AwaitingPresentation(),bool(source.Committed()),
+        end,paused,binding.picture,source.LastSubmitted());
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (!m_dvFatalConsumed) m_dvFatalReason=DVBRIDGE::OutputReason::ActivationFailed;
+  }
+  return decision == HDR10AISource::Decision::Prepare;
+}
+#endif
+
+void CWinSystemGbmGLContext::ResetDVActivation(const VideoPicture* picture)
+{
+  if (!picture) return;
+  const auto binding = picture->doviSourceBinding.Valid() ?
+      picture->doviSourceBinding : picture->doviMetadata.Binding();
+  const auto revision = DVBRIDGE::FrameOutputSettings().revision;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (binding.stream == m_dvActivationStream && revision == m_dvActivationPolicy) return;
+    m_dvActivationStream = binding.stream;
+    m_dvActivationPolicy = revision;
+    m_dvNativeFailed = m_dvHDR10Failed = m_dvSDRFailed = m_dvPlayerLedFailed = m_dvFallbackActive = false;
+    m_dvActivationReason = DVBRIDGE::OutputReason::None;
+    m_dvFailedStream = m_dvFailedPolicy = 0;
+  }
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM)) drm->ResetDVActivation();
+}
+
+bool CWinSystemGbmGLContext::RecoverDVActivation()
+{
+  if (!m_dvRecoveryPending) return true;
+  if (!PollRejectedDVSurface()) return false;
+  // Retire the rejected GPU work before restoring properties with clean pixels.
+  if (!m_dvContext || m_dvContext->Poll() != DVBRIDGE_DV_IDLE) return false;
+  const bool superseded = m_dvSuperseded;
+  if (!EndDVBridge())
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_dvActivationReason = DVBRIDGE::OutputReason::RestoreFailed;
+    return false;
+  }
+  // Supersession retired the candidate and restored connector/session state,
+  // but it was not an activation failure of either the old or the new target.
+  if (superseded)
+  {
+    m_dvConfiguredOutput.reset();
+    m_dvRecoveryPending = false;
+    return true;
+  }
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  bool fallback;
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    fallback = m_dvFallbackActive;
+  }
+  const bool retry = drm && !fallback && drm->CanRetryDVActivation(true);
+  if (!retry)
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::NativeDV) m_dvNativeFailed = true;
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::HDR10) m_dvHDR10Failed = true;
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::SDR) m_dvSDRFailed = true;
+    if (m_dvRejectedRoute == DVBRIDGE::OutputRoute::PlayerLed) m_dvPlayerLedFailed = true;
+    m_dvFallbackActive = true;
+    m_dvActivationReason = DVBRIDGE::OutputReason::ActivationFailed;
+    m_dvFailedStream = m_dvActivationStream;
+    m_dvFailedPolicy = m_dvActivationPolicy;
+  }
+  m_dvConfiguredOutput.reset();
+  DVBRIDGE::StreamTelemetry::NativeFailure(DVBRIDGE::OutputReason::ActivationFailed,
+      drm ? drm->DVActivationError() : 0,drm ? drm->DVActivationFailures() : 0,true);
+  DVBRIDGE::StreamTelemetry::PublishNativePending(
+      CServiceBroker::GetDataCacheCore().GetVideoProcessingGeneration());
+  m_dvRecoveryPending = false;
+  return true;
+}
+
+DVBRIDGE::OutputReason CWinSystemGbmGLContext::ConsumeDVPlaybackFailure(DVBRIDGE::SourceBinding binding)
+{
+  std::lock_guard lock(m_dvCapabilityMutex);
+  if (!binding.Valid() || binding.stream != m_dvFatalBinding.stream ||
+      binding.revision != m_dvFatalBinding.revision || m_dvFatalConsumed)
+    return DVBRIDGE::OutputReason::None;
+  if (m_dvFatalReason != DVBRIDGE::OutputReason::None) m_dvFatalConsumed = true;
+  return m_dvFatalReason;
+}
+
+void CWinSystemGbmGLContext::RefreshHDR10LinkDepth()
+{
+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector || connector->GetType().rfind("HDMI", 0) != 0 ||
+      !connector->SupportsProperty("max bpc"))
+  {
+    m_hdr10MaxBpc = 0;
+    return;
+  }
+
+  // Native DV and LLDV temporarily own an 8-bit scanout. HDR10 setup stages
+  // the saved connector depth when it releases that transport.
+  const auto restored = m_dvState.Before("max bpc");
+  auto depth = GetEffectiveMaxBpc(restored);
+  if (restored && *restored != 0)
+    depth = std::min(depth, *restored);
+  if (const auto range = connector->GetRangePropertyLimits("max bpc"); range && depth != 0)
+    depth = std::min(depth, range->second);
+  m_hdr10MaxBpc = depth;
+}
+
+bool CWinSystemGbmGLContext::SupportsHDR10Conversion(bool requireCurrentMode)
+{
+  if (!IsHDRDisplay() || !GetDisplayHDRCapabilities().SupportsHDR10())
+    return false;
+  auto* connector = m_DRM->GetConnector();
+  return connector && connector->IsConnected() && connector->SupportsProperty("HDR_OUTPUT_METADATA") &&
+      (connector->SupportsProperty("DVBRIDGE_HDR10_DEEP_COLOR") || FloatOutputUsable()) &&
+      SupportsDVOutputMode(requireCurrentMode);
+}
+
+bool CWinSystemGbmGLContext::SupportsSDRConversion() const
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const auto* mode = drm ? drm->GetSelectedMode() : nullptr;
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  return connector && connector->IsConnected() && mode && mode->hdisplay && mode->vdisplay &&
+      mode->hdisplay <= 3840 && mode->vdisplay <= 2160 &&
+      !(mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN));
+}
+
+bool CWinSystemGbmGLContext::ConfigureSDRConversion(const VideoPicture& picture)
+{
+  if (!CompleteDVBridgePage()) return false;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || (m_dvState.Captured() && !m_dvState.Stage(*drm, true))) return false;
+  if (!CaptureCB1ConnectorPreferences()) return false;
+  m_failedHDR10SetupRestore = true;
+  if (m_hdrDeepColorPrevious && !drm->AddProperty(drm->GetConnector(),
+      "DVBRIDGE_HDR10_DEEP_COLOR", *m_hdrDeepColorPrevious)) return false;
+  VideoPicture output;
+  output.color_transfer = AVCOL_TRC_BT709;
+  output.color_primaries = AVCOL_PRI_BT709;
+  output.color_space = AVCOL_SPC_BT709;
+  output.colorBits = GetOutputBitDepth();
+  SetColorimetry(&output);
+  SetHDR(nullptr); // The native method returns false for SDR, including SDR-only displays.
+  if (drm->GetConnector()->SupportsProperty("HDR_OUTPUT_METADATA") &&
+      !drm->AddProperty(drm->GetConnector(), "HDR_OUTPUT_METADATA", 0)) return false;
+  drm->StageHDR10Plus({}, picture.doviSourceInfo.informationGeneration);
+  if (!BeginDVBridge()) return false;
+  m_hdr10Session.reset();
+  m_hdr10BasicSignal.reset();
+  m_hdr10Signal.reset();
+  m_hdr10SessionStream = 0;
+  m_failedHDR10SetupRestore = false;
+  return true;
+}
+
+bool CWinSystemGbmGLContext::PrepareHDR10Scanout()
+{
+  if (m_dvSelection.route != DVBRIDGE::OutputRoute::HDR10)
+    return false;
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector || !connector->GetType().starts_with("HDMI") ||
+      !connector->SupportsProperty("DVBRIDGE_HDR10_DEEP_COLOR"))
+    return false;
+  std::string driverVersion;
+  std::ifstream("/sys/module/nvidia/version") >> driverVersion;
+  if (!driverVersion.starts_with("580."))
+    return false;
+
+  if (!m_pascalHDRScanout)
+  {
+    try
+    {
+      m_pascalHDRScanout = CPascalHDR10Scanout::Create(
+          m_GBM->GetDevice().Get(), *drm, m_nWidth, m_nHeight);
+    }
+    catch (const std::exception& error)
+    {
+      CLog::LogF(LOGWARNING, "R580 HDR10 scanout import failed: {}", error.what());
+    }
+    CLog::LogF(m_pascalHDRScanout ? LOGINFO : LOGWARNING,
+              "R580 10-bit HDR10 scanout probe: {}",
+              m_pascalHDRScanout ? "passed" : "unavailable");
+  }
+  m_pascalHDRActive = static_cast<bool>(m_pascalHDRScanout);
+  return m_pascalHDRActive;
+}
+
+unsigned int CWinSystemGbmGLContext::HDR10Framebuffer() const
+{
+  return m_pascalHDRActive ? m_pascalHDRScanout->Framebuffer() : 0;
+}
+
+bool CWinSystemGbmGLContext::ConfigureHDR10Conversion(const VideoPicture& picture)
+{
+  if (!CompleteDVBridgePage()) return false;
+  m_hdr10Signal.reset();
+  const auto stream = picture.doviMetadata.Binding().stream;
+  if (!stream) return false;
+  if (m_failedHDR10SetupRestore && !EndDVBridge())
+    return false;
+  dvbridge_hdr10_session session{};
+  if (m_hdr10Session && m_hdr10SessionStream == stream) session = *m_hdr10Session;
+  else if (!dvbridge_hdr10_session_init(&session, picture.doviMetadata.Data(), picture.doviMetadata.Size()))
+    return false;
+  auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (m_dvState.Captured() && (!atomic || !m_dvState.Stage(*atomic,true))) return false;
+  VideoPicture output;
+  output.SetParams(picture);
+  output.color_transfer = AVCOL_TRC_SMPTE2084;
+  output.color_primaries = AVCOL_PRI_BT2020;
+  output.color_space = AVCOL_SPC_BT2020_NCL;
+  output.colorBits = 10;
+  const auto& metadata = session.output;
+  if (metadata.max_luminance)
+  {
+    if (!output.hasDisplayMetadata)
+      output.displayMetadata = {};
+    output.hasDisplayMetadata = true;
+    output.displayMetadata.has_luminance = metadata.max_luminance != 0;
+    output.displayMetadata.max_luminance = {static_cast<int>(metadata.max_luminance), 1};
+    output.displayMetadata.min_luminance = {static_cast<int>(metadata.min_luminance), 10000};
+    output.hasLightMetadata = true;
+    output.lightMetadata.MaxCLL = metadata.max_cll;
+    output.lightMetadata.MaxFALL = metadata.max_fall;
+  }
+  if (!CaptureCB1ConnectorPreferences()) return false;
+  // Every rejected setup after this point must restore ordinary HDR/color state.
+  m_failedHDR10SetupRestore = true;
+  SetColorimetry(&output);
+  if (!SetHDR(&output))
+    return false;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  auto* connector = drm ? drm->GetConnector() : nullptr;
+  if (!connector)
+    return false;
+  const auto previous = connector->GetPropertyValue("DVBRIDGE_HDR10_DEEP_COLOR");
+  if (previous ? !drm->AddProperty(connector, "DVBRIDGE_HDR10_DEEP_COLOR", 1) : !FloatOutputUsable())
+    return false;
+  m_hdrDeepColorPrevious = previous;
+  if (!BeginDVBridge() || !m_dvBridge->SetHDR10Session(session,stream,UseLimitedColor()))
+  {
+    if (previous && !drm->AddProperty(connector, "DVBRIDGE_HDR10_DEEP_COLOR", *previous))
+    {
+      drm->FlipPageTransactional(nullptr, true);
+    }
+    m_hdrDeepColorPrevious.reset();
+    return false;
+  }
+  m_hdr10Session = session;
+  m_hdr10SessionStream = stream;
+  m_hdr10BasicSignal = std::make_unique<VideoPicture>();
+  m_hdr10BasicSignal->color_transfer = output.color_transfer;
+  m_hdr10BasicSignal->color_primaries = output.color_primaries;
+  m_hdr10BasicSignal->color_space = output.color_space;
+  m_hdr10BasicSignal->colorBits = output.colorBits;
+  m_hdr10BasicSignal->hasDisplayMetadata = output.hasDisplayMetadata;
+  m_hdr10BasicSignal->displayMetadata = output.displayMetadata;
+  m_hdr10BasicSignal->hasLightMetadata = output.hasLightMetadata;
+  m_hdr10BasicSignal->lightMetadata = output.lightMetadata;
+  m_hdr10Signal = {metadata.max_luminance, metadata.min_luminance,
+      metadata.max_cll, metadata.max_fall, ~0u};
+  m_failedHDR10SetupRestore = false;
+  if (DVBRIDGE::DiagnosticsEnabled())
+  {
+    if (m_dvSelection.policy.mode == DVBRIDGE_MODE_HDR10PLUS)
+      DVBRIDGE::DiagnosticLog(LOGINFO, "CB1 HDR10+ configured: pixel_mapping=none dynamic=pending-analysis framebuffer_bits={} range={}",
+          GetOutputBitDepth(), UseLimitedColor() ? "limited" : "full");
+    else
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge HDR10 configured: policy={} signal_target={} nits origin={} framebuffer_bits={} range={}",
+          m_dvSelection.policy.mode == DVBRIDGE_MODE_HDR10_EXPERT ? "Expert" : "Basic",
+        session.target.hdr.max_luma, session.output.level6 ? "RPU-L6" : "RPU-source-PQ",
+        GetOutputBitDepth(), UseLimitedColor() ? "limited" : "full");
+    if (m_hdrDeepColorPrevious)
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge HDR10: link minimum=10 bits; native HDMI bandwidth and format validation retained");
+    else
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge HDR10: framebuffer_bits={} link_depth=driver-selected wire_depth=unknown", GetOutputBitDepth());
+  }
+  return true;
+}
+
+bool CWinSystemGbmGLContext::RestoreFailedHDR10Setup()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return false;
+  if (!StageCB1ConnectorPreferences(true) || !StageOrdinaryHDR10Recovery())
+  {
+    drm->FlipPageTransactional(nullptr, true);
+    return false;
+  }
+  SetColorimetry(nullptr);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  glDisable(GL_SCISSOR_TEST);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glClearColor(0, 0, 0, 1);
+  glClear(GL_COLOR_BUFFER_BIT);
+  if (!m_dvBridge || !m_dvBridge->Advanced()) glFinish();
+  if (!m_eglContext.TrySwapBuffers())
+  {
+    drm->FlipPageTransactional(nullptr, true);
+    return false;
+  }
+  auto& surface = m_GBM->GetDevice().GetSurface();
+  auto* bo = surface.LockTransactionalBuffer();
+  const bool presented = drm->FlipPageTransactional(bo, true);
+  surface.CompleteTransactionalBuffer(presented);
+  if (!presented)
+    return false;
+  surface.EndTransactionalMode();
+  CompleteOrdinaryHDR10Recovery();
+  CompleteCB1ConnectorRestore();
+  m_failedHDR10SetupRestore = false;
+  return true;
+}
+
+bool CWinSystemGbmGLContext::ConnectorPreferencesAllowed() const
+{
+  const auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  return !HasPendingDVBridgeRestore() && !m_dvOutputSurface && !HasPendingDVOutputSurface() &&
+      !m_nativeDVProperties && !m_cb1ConnectorState.Captured() &&
+      !m_dvOrdinaryFrame && !m_dvEndPending &&
+      (!drm || !drm->HasPendingCB1Page());
+}
+
+bool CWinSystemGbmGLContext::CaptureCB1ConnectorPreferences()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || !m_cb1ConnectorState.CaptureColorPreferences(*drm, DefaultMaxBpc()))
+    return false;
+  if (!m_cb1LimitedRange)
+  {
+    m_cb1LimitedRange = RequestedLimitedColor();
+    m_cb1OrdinaryLimitedRange = OrdinaryShaderLimitedColor();
+  }
+  return true;
+}
+
+std::optional<bool> CWinSystemGbmGLContext::TransportLimitedColor() const
+{
+  return m_cb1RestoringPreferences ? m_cb1OrdinaryLimitedRange : m_cb1LimitedRange;
+}
+
+bool CWinSystemGbmGLContext::StageCB1ConnectorPreferences(bool restore)
+{
+  m_cb1RestoringPreferences = restore;
+  if (!m_cb1ConnectorState.Captured()) return true;
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  return drm && m_cb1ConnectorState.Stage(*drm, restore);
+}
+
+bool CWinSystemGbmGLContext::StageTransportPreferences()
+{
+  if (!m_cb1RestoringPreferences && m_dvState.Captured() && !m_hdrConversion)
+    return true;
+  if (!StageCB1ConnectorPreferences(m_cb1RestoringPreferences)) return false;
+  if (m_cb1RestoringPreferences) ApplyColorspace();
+  return true;
+}
+
+std::optional<uint64_t> CWinSystemGbmGLContext::RestoredConnectorProperty(const char* name) const
+{
+  return m_cb1RestoringPreferences ? m_cb1ConnectorState.Before(name) : std::nullopt;
+}
+
+void CWinSystemGbmGLContext::CompleteCB1ConnectorRestore()
+{
+  m_cb1ConnectorState.Restored();
+  m_cb1RestoringPreferences = false;
+  m_cb1LimitedRange.reset();
+  m_cb1OrdinaryLimitedRange.reset();
+  DeferConnectorPreferences();
+}
+
+bool CWinSystemGbmGLContext::BeginDVBridge()
+{
+  if (!PollRejectedDVSurface())
+  { DVBRIDGE::DiagnosticStage("output-surface-restoring"); return false; }
+  if (m_dvShutdownFence && !RetireDVContext())
+  { DVBRIDGE::DiagnosticStage("context-retiring"); return false; }
+  const auto failure = [this](const char* stage, const char* detail = "none") {
+    if (DVBRIDGE::DiagnosticsEnabled())
+      DVBRIDGE::DiagnosticFailureLog(stage,
+          m_dvSetupFailures.Record(DVBRIDGE::DiagnosticNowMs(), stage), LOGERROR,
+          "DVBridge setup: stage={} detail={} failures={} size={}x{} depth={} renderable={}",
+          stage, detail, m_dvSetupFailures.Count(), m_nWidth, m_nHeight,
+          GetOutputBitDepth(), m_renderableType);
+    return false;
+  };
+  const bool playerLed = m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed;
+  const bool sdr = m_dvSelection.route == DVBRIDGE::OutputRoute::SDR;
+  const bool hdr10 = m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 || sdr;
+  const auto* hdr10plusDisplay = GetDisplayInfo();
+  const int hdr10plusVersion = hdr10plusDisplay ? hdr10plusDisplay->HDR10PlusVersion() : -1;
+  if (m_dvBridge) m_dvBridge->SetHDR10PlusVersion(hdr10plusVersion);
+  if (playerLed ? !GetLldvConnectorStatus().currentTiming :
+      sdr ? !SupportsSDRConversion() : !SupportsDVOutputMode())
+    return failure("output-format", "unsupported-current-mode");
+  const auto selected = m_DRM->GetSelectedMode();
+  if (!selected || m_nWidth != selected->hdisplay || m_nHeight != selected->vdisplay)
+    return failure("output-format", "drawable-size");
+  if (sdr ? GetOutputBitDepth() < 8 : hdr10 ? GetOutputBitDepth() < 10 : GetOutputBitDepth() != 8)
+    return failure("output-format", "drawable-depth");
+  if (m_renderableType != EGL_OPENGL_BIT) return failure("output-format", "egl-renderable");
+  if (m_dvBridge && m_dvConfiguredOutput == m_dvSelection.policy.mode &&
+      (m_dvState.Captured() || m_hdrConversion))
+    return (!sdr || SetGuiCompositing(AVCOL_TRC_GAMMA22)) &&
+        m_guiCompositing && m_compositeShader;
+  if (!CompleteDVBridgePage())
+  { DVBRIDGE::DiagnosticStage("display-pending"); return false; }
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || (!drm->IsSelectedModeCommitted() &&
+      m_modeHold.Holding() != CModeChangeHold::Kind::START))
+    return failure("atomic-output-unavailable");
+  CDVWindowRetirement::PollOnce();
+  if (CDVBridgeGLES::Context::NewContextBlocked()) return failure("context-retained");
+  if (!m_dvContext) m_dvContext = std::make_shared<CDVBridgeGLES::Context>();
+  if (m_dvContext->GL() && m_dvContext->Poll() != DVBRIDGE_DV_IDLE)
+    return failure("context-retiring");
+  if (m_dvBridge && m_dvBridge->PlayerLed() != playerLed)
+    m_dvBridge.reset(); // Previous renderer use was retired above.
+  if (!m_dvBridge)
+  {
+    m_dvBridge = std::make_unique<CDVBridgeGLES>(playerLed);
+    if (!m_dvBridge->Initialize(false, hdr10, m_dvContext, sdr, HDR10Framebuffer()))
+      return failure("renderer-init");
+    m_dvBridge->SetHDR10PlusVersion(hdr10plusVersion);
+  }
+  m_GBM->GetDevice().UseDVOutputLifetime();
+  const bool hadConnectorState = m_cb1ConnectorState.Captured();
+  if (!CaptureCB1ConnectorPreferences())
+    return failure("connector-preferences", m_cb1ConnectorState.CaptureFailure());
+  if (!hdr10 && !m_dvState.Captured())
+  {
+    const auto* display = GetDisplayInfo();
+    if (!display) return failure("drm-state-capture", "edid-unavailable");
+    const auto sink = display->GetDolbyVisionCaps();
+    const auto* mode = drm->GetSelectedMode();
+    const double rate = mode && mode->htotal && mode->vtotal ?
+        mode->clock * 1000.0 / mode->htotal / mode->vtotal : 0.0;
+    if (!playerLed && !sink.supports_2160p60 &&
+        mode && mode->vdisplay >= 2160 && rate > 30.01)
+      return failure("output-format", "sink-dv-rate");
+    if (!(playerLed ? m_dvState.CapturePlayerLed(*drm) :
+          m_dvState.Capture(*drm, 0, sink.legacy_vsif)))
+    {
+      if (!hadConnectorState) CompleteCB1ConnectorRestore();
+      return failure("drm-state-capture", m_dvState.CaptureFailure());
+    }
+    m_presentStall.Reset();
+    if (DVBRIDGE::DiagnosticsEnabled())
+      DVBRIDGE::DiagnosticLog(LOGINFO, "DVBridge {} state captured: hdr_static_metadata={}",
+          playerLed ? "Player-Led" : "TV-Led",
+          drm->GetConnector()->SupportsProperty("HDR_OUTPUT_METADATA") ? "preserved" : "not-exposed");
+  }
+  m_hdrConversion = hdr10;
+  m_sdrConversion = sdr;
+  if (!StageCB1ConnectorPreferences(false)) return failure("connector-preferences");
+  DeferConnectorPreferences();
+  m_compositeShader.reset();
+  const bool ready = SetGuiCompositing(sdr ? AVCOL_TRC_GAMMA22 : AVCOL_TRC_SMPTE2084);
+  if (ready) m_dvConfiguredOutput = m_dvSelection.policy.mode;
+  return ready;
+}
+
+bool CWinSystemGbmGLContext::SetVideoOutput(const VideoPicture* picture)
+{
+  if (picture && DVBRIDGE::DiagnosticsEnabled())
+  {
+    const auto binding = picture->doviSourceBinding.Valid() ? picture->doviSourceBinding : picture->doviMetadata.Binding();
+    const auto preferences = DVBRIDGE::FrameOutputSettings();
+    if (picture->doviSourceInfo.profile || picture->hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+      DVBRIDGE::ObserveDiagnostic(binding.stream,binding.picture,binding.revision,
+          preferences.revision,"output-admission",preferences.output != DVBRIDGE::OutputMode::Disabled,false);
+  }
+  if (picture && m_dvStopPending)
+  {
+    m_modeHold.Cancel();
+    if (!StopDVBridgePlayback() || m_dvOrdinaryFrame) return false;
+  }
+  if (picture && !(SelectedDVOutput(picture).route == DVBRIDGE::OutputRoute::SDR ?
+      SupportsSDRConversion() : SupportsDVOutputMode()) && DVBridgeRequested(picture))
+    return true; // Configure/import first; the GUI owner must modeset before transport setup.
+  if (!CompleteDVBridgePage()) return false;
+  const auto preferences = DVBRIDGE::FrameOutputSettings();
+  if (!RecoverDVActivation()) return false;
+  ResetDVActivation(picture);
+  const auto capabilities = GetDVOutputCapabilities(picture);
+  if (picture && capabilities.isDV && preferences.output != DVBRIDGE::OutputMode::Disabled &&
+      (!capabilities.processingKnown || (picture->strDVELType == "FEL" && !picture->doviEnhancement)))
+    return true; // Configure must reach UploadTexture before source-dependent activation.
+  m_dvSelection = SelectedDVOutput(picture);
+  if (!PollRejectedDVSurface()) return false;
+  if (HasPendingDVOutputSurface() || m_dvOrdinaryFrame) return false;
+  const bool transaction = DVBridgeRequested(picture) || m_hdrConversion || m_dvState.Captured();
+  if (transaction)
+  {
+    // Same-format policy/frame work bypasses this actual transport transition.
+    const bool playerLed = m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed;
+    const bool nativeTransport = playerLed || m_dvSelection.route == DVBRIDGE::OutputRoute::NativeDV;
+    const bool wasPlayerLed = m_dvBridge && m_dvBridge->PlayerLed();
+    const bool active = nativeTransport ? m_dvState.Captured() && playerLed == wasPlayerLed :
+        m_hdrConversion;
+    m_dvActivating = DVBridgeRequested(picture) && (m_dvActivating || !active);
+    if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+      drm->SetDVActivationPending(m_dvActivating);
+    if (!m_dvOutputRetiring)
+    {
+      m_dvPriorConfiguredOutput = m_dvState.Captured() || m_hdrConversion ?
+          m_dvConfiguredOutput : std::nullopt;
+      m_dvPriorHDRConversion = m_hdrConversion;
+      m_dvPriorSDRConversion = m_sdrConversion;
+      m_dvPriorGuiCompositing = m_guiCompositing;
+      m_dvPriorGuiSDRGamma = m_guiSDRGamma;
+      m_dvPendingStream = picture ? (picture->doviSourceBinding.Valid() ?
+          picture->doviSourceBinding.stream : picture->doviMetadata.Binding().stream) : 0;
+      m_dvPendingPolicy = preferences.revision;
+      if (m_dvBridge)
+      {
+        m_dvBridge->Cancel();
+        // Cancelled readiness cannot cross an output-format transaction.
+        m_cb1FramePending = m_dvFrame = m_dvNativeGui = false;
+        m_dvOutputRetiring = true;
+        if (!m_dvContext->FenceLastUse()) return false;
+      }
+    }
+    if (m_dvContext && m_dvContext->GL() && m_dvContext->Poll() != DVBRIDGE_DV_IDLE)
+      return false;
+    if (!m_dvContext) m_dvContext = std::make_shared<CDVBridgeGLES::Context>();
+    if (!m_dvContext->Initialize(false)) return false;
+    m_dvOutputRetiring = false;
+    const bool linkChange =
+        nativeTransport != m_dvState.Captured() || (nativeTransport && playerLed != wasPlayerLed) ||
+        ((m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ||
+          m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) != m_hdrConversion) ||
+        ((m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) != m_sdrConversion);
+    if (linkChange && m_modeAnnouncement.Pending() == CHeldModeAnnouncement::Step::NONE)
+      m_modeAnnouncement.Held();
+    m_GBM->GetDevice().UseDVOutputLifetime();
+    m_priorPascalHDRActive = m_pascalHDRActive;
+    m_pascalHDRActive = false;
+    UseDVOutputSurfaceTransaction(true);
+    const bool staged = CWinSystemGbmEGLContext::SetVideoOutput(picture);
+    UseDVOutputSurfaceTransaction(false);
+    if (!staged)
+    {
+      if (!HasPendingDVOutputSurface())
+        m_pascalHDRActive = m_priorPascalHDRActive;
+      return false;
+    }
+    m_hdr10Signal.reset();
+    const bool requested = DVBridgeRequested(picture);
+    const bool hdr10 = m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ||
+        m_dvSelection.route == DVBRIDGE::OutputRoute::SDR;
+    if (requested && m_dvBridge &&
+        !m_dvBridge->RebindOutputSurface(hdr10, m_dvSelection.route == DVBRIDGE::OutputRoute::SDR,
+                                         HDR10Framebuffer()))
+    {
+      RejectDVOutputSurface();
+      return false;
+    }
+    m_hdrConversion = false;
+    m_sdrConversion = false;
+    m_dvConfiguredOutput.reset();
+    if (!requested && !PrepareOrdinaryDVOutput(picture)) return false;
+    return true;
+  }
+  // Restore with the current surface before EGL replaces its buffers.
+  if ((m_dvState.Captured() || m_hdrConversion || m_failedHDR10SetupRestore) && !EndDVBridge())
+    return false;
+  m_dvBridge.reset();
+  return CWinSystemGbmEGLContext::SetVideoOutput(picture);
+}
+
+bool CWinSystemGbmGLContext::PrepareDVOutputFrame(const VideoPicture& picture)
+{
+  const auto deferred = [](const char* stage) {
+    DVBRIDGE::DiagnosticStage(stage);
+    return false;
+  };
+  if (DVBRIDGE::DiagnosticsEnabled())
+  {
+    const auto binding = picture.doviSourceBinding.Valid() ? picture.doviSourceBinding : picture.doviMetadata.Binding();
+    const auto preferences = DVBRIDGE::FrameOutputSettings();
+    if (picture.doviSourceInfo.profile || picture.hdrType == StreamHdrType::HDR_TYPE_DOLBYVISION)
+      DVBRIDGE::ObserveDiagnostic(binding.stream,binding.picture,binding.revision,
+          preferences.revision,"output-preparation",preferences.output != DVBRIDGE::OutputMode::Disabled,false);
+  }
+  if (m_dvStopPending) return deferred("output-stop-pending");
+  if (!(SelectedDVOutput(&picture).route == DVBRIDGE::OutputRoute::SDR ?
+      SupportsSDRConversion() : SupportsDVOutputMode()) && DVBridgeRequested(&picture))
+    return deferred("output-mode-unavailable");
+  if (m_dvRollbackFailed || !RecoverDVActivation())
+  {
+    if (m_dvRollbackFailed)
+    {
+      if (DVBRIDGE::StreamTelemetry::Read().transaction.reason != DVBRIDGE::OutputReason::RestoreFailed)
+      {
+        auto atomic=std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+        DVBRIDGE::StreamTelemetry::NativeFailure(DVBRIDGE::OutputReason::RestoreFailed,
+            0,atomic ? atomic->DVActivationFailures() : 0,false);
+        DVBRIDGE::StreamTelemetry::PublishNativePending(picture.doviSourceInfo.informationGeneration);
+      }
+      std::lock_guard lock(m_dvCapabilityMutex);
+      if (!m_dvFatalConsumed) m_dvFatalReason = DVBRIDGE::OutputReason::RestoreFailed;
+    }
+    return deferred(m_dvRollbackFailed ? "output-restore-failed" : "output-restore-pending");
+  }
+  // A stopped file's GUI transaction must be presented before new video setup.
+  if (m_dvOrdinaryFrame && HasPendingDVOutputSurface())
+    return deferred("output-await-previous-scanout");
+  ResetDVActivation(&picture);
+  const auto preferences = DVBRIDGE::FrameOutputSettings(picture.hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS,
+      !picture.doviSourceInfo.profile && picture.hdrType == StreamHdrType::HDR_TYPE_HLG);
+  const auto capabilities = GetDVOutputCapabilities(&picture, preferences);
+#ifdef CB1_HAS_HDR10_AI
+  if (((!capabilities.isHDR10 && !capabilities.isHLG) ||
+       preferences.hdr10Source==DVBRIDGE::HDR10SourceMode::Native ||
+       preferences.hdr10Source==DVBRIDGE::HDR10SourceMode::SDR) &&
+      m_dvContext && !m_dvContext->StopHDR10AI()) return deferred("output-await-ai-retirement");
+#endif
+  if (capabilities.isDV && preferences.output != DVBRIDGE::OutputMode::Disabled)
+  {
+    if (!capabilities.processingKnown) return deferred("output-await-source-import");
+    if (picture.strDVELType == "FEL" && !picture.doviEnhancement) return deferred("output-await-fel");
+  }
+  auto selectionCapabilities = capabilities;
+  {
+    const auto masterBinding=picture.doviSourceBinding.Valid() ?
+        picture.doviSourceBinding : picture.doviMetadata.Binding();
+    std::lock_guard lock(m_dvCapabilityMutex);
+    m_masterSafety.Begin(masterBinding.stream,preferences.revision,masterBinding.revision,picture.pts,
+        capabilities.isDV && preferences.output==DVBRIDGE::OutputMode::MasterReference);
+  }
+  const auto selection = SelectedDVOutput(&picture, preferences, selectionCapabilities);
+  const auto binding = picture.doviSourceBinding.Valid() ?
+      picture.doviSourceBinding : picture.doviMetadata.Binding();
+  if (HasPendingDVOutputSurface() &&
+      (m_dvPendingStream != binding.stream || m_dvPendingPolicy != preferences.revision ||
+       m_dvSelection.route != selection.route || m_dvSelection.policy.mode != selection.policy.mode))
+  {
+    // A pending drawable and renderer belong to their original target. Retire
+    // and unwind that transaction before selecting any successor, even at the
+    // same bit depth. Preserve real retirement/restoration failures.
+    m_dvSuperseded = true;
+    if (!RejectDVOutputSurface() || !RecoverDVActivation())
+      return deferred("output-await-superseded-scanout");
+  }
+  m_dvSelection = selection;
+  // Retained renderer facts belong to this render-side phase, never Configure.
+  if (capabilities.sourceKnown)
+  {
+    auto identity = m_dvBridge ? m_dvBridge->SelectionIdentity(binding, preferences, m_dvSelection.policy.mode) :
+        DVBRIDGE::SourceBinding{};
+    if (!identity.Valid() && binding.Valid()) identity = {binding.stream,binding.picture,preferences.revision};
+    int requested=DVBRIDGE::PolicyCode(preferences.Policy());
+#ifdef CB1_HAS_HDR10_AI
+    if (capabilities.isHDR10 || capabilities.isHLG)
+      requested=DVBRIDGE::PolicyCode(preferences.HDR10Policy());
+#endif
+    DVBRIDGE::StreamTelemetry::NativeSelection(identity, selectionCapabilities,
+        requested,DVBRIDGE::PolicyCode(m_dvSelection.policy),m_dvSelection.reason);
+    if (m_dvSelection.reason!=DVBRIDGE::OutputReason::None)
+      DVBRIDGE::StreamTelemetry::PublishNativePending(picture.doviSourceInfo.informationGeneration);
+  }
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+    m_dvAttemptFailures = drm->DVActivationFailures();
+  const auto& source = picture.doviSourceInfo;
+  const bool requestedCircuit=capabilities.isDV ? preferences.output!=DVBRIDGE::OutputMode::Disabled :
+      (capabilities.isHDR10 || capabilities.isHLG) &&
+      preferences.hdr10Source!=DVBRIDGE::HDR10SourceMode::Native;
+  if (capabilities.sourceKnown && !capabilities.stereoSource && requestedCircuit &&
+      m_dvSelection.route==DVBRIDGE::OutputRoute::Vanilla &&
+      m_dvSelection.reason!=DVBRIDGE::OutputReason::None &&
+      m_dvSelection.reason!=DVBRIDGE::OutputReason::ProcessingPending &&
+      !(source.el && !picture.doviEnhancement))
+  {
+    std::lock_guard lock(m_dvCapabilityMutex);
+    if (!m_dvFatalConsumed) m_dvFatalReason=m_dvSelection.reason;
+    return false;
+  }
+  if (!PollRejectedDVSurface()) return deferred("output-await-rejected-scanout");
+  // A format match cannot carry a fixed target across original source streams.
+  if (m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 && m_hdrConversion &&
+      m_hdr10Session && m_hdr10SessionStream != picture.doviMetadata.Binding().stream)
+    return ConfigureHDR10Conversion(picture);
+  if (m_dvSelection.reason == DVBRIDGE::OutputReason::TVProfileRequired)
+  {
+    DVBRIDGE::DiagnosticStage("output-tv-profile-required");
+    if ((m_dvProfileLoggedRevision != preferences.revision || m_dvProfileLoggedStream != binding.stream) &&
+        DVBRIDGE::DiagnosticLog(LOGWARNING,
+            "DVBridge profile incomplete: peak={} panel={} gamut={} requirement=peak_and_gamut_required",
+            preferences.peak,preferences.panel,preferences.gamut))
+    {
+      m_dvProfileLoggedRevision = preferences.revision;
+      m_dvProfileLoggedStream = binding.stream;
+    }
+  }
+  if (m_dvConfiguredOutput == m_dvSelection.policy.mode && !m_dvOutputRetiring &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::Vanilla || m_dvState.Captured() || m_hdrConversion))
+    return m_dvSelection.route != DVBRIDGE::OutputRoute::SDR ||
+        SetGuiCompositing(AVCOL_TRC_GAMMA22);
+  const bool requested = DVBridgeRequested(&picture);
+  if (requested && m_dvBridge && !HasPendingDVOutputSurface() &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::PlayerLed) == m_dvBridge->PlayerLed() &&
+      (m_dvState.Captured() || m_hdrConversion) &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) == m_sdrConversion &&
+      (m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ||
+       m_dvSelection.route == DVBRIDGE::OutputRoute::SDR) == m_hdrConversion)
+  {
+    // Same-format policies keep the renderer and its committed history intact.
+    if (m_sdrConversion && !SetGuiCompositing(AVCOL_TRC_GAMMA22)) return false;
+    if (!CompleteDVBridgePage()) return false;
+    m_dvConfiguredOutput = m_dvSelection.policy.mode;
+    return true;
+  }
+  if (!HasPendingDVOutputSurface() && !SetVideoOutput(&picture)) return false;
+  if (requested)
+  {
+    if (CDVBridgeGLES::Context::NewContextBlocked() ||
+        (m_dvContext && m_dvContext->GL() && m_dvContext->Poll() != DVBRIDGE_DV_IDLE))
+      return false;
+    const bool ready = m_dvSelection.route == DVBRIDGE::OutputRoute::SDR ?
+        ConfigureSDRConversion(picture) : m_dvSelection.route == DVBRIDGE::OutputRoute::HDR10 ?
+        ConfigureHDR10Conversion(picture) : BeginDVBridge();
+    if (!ready) { RejectDVOutputSurface(); return false; }
+  }
+  else if ((HasPendingDVOutputSurface() || m_dvOrdinaryFrame) &&
+           !PrepareOrdinaryDVOutput(&picture)) return false;
+  m_dvConfiguredOutput = m_dvSelection.policy.mode;
+  return true;
+}
+
+bool CWinSystemGbmGLContext::PrepareOrdinaryDVOutput(const VideoPicture* picture)
+{
+  // Keep the current native metadata blob alive until its commit is accepted.
+  if (m_dvOrdinaryFrame && !m_dvStopPending) return true;
+  m_cb1RestoringPreferences = true;
+  if (m_dvStopPending)
+  {
+    SetGuiCompositing(0);
+    CServiceBroker::GetGUI()->GetWindowManager().MarkDirty();
+  }
+  SetColorimetry(picture);
+  const bool hdr = SetHDR(picture);
+  SetGuiCompositing(hdr && picture ? picture->color_transfer : 0);
+  m_dvOrdinaryFrame = true;
+  return true;
+}
+
+bool CWinSystemGbmGLContext::RejectDVOutputSurface()
+{
+  m_hdr10Signal.reset();
+  // Ordinary commit rejection stays retryable through its pending frame owner.
+  if (m_dvOrdinaryFrame) return false;
+  if (!m_dvActivating && !HasPendingDVOutputSurface()) return true;
+  if (!m_dvStopPending && !m_dvRecoveryPending)
+  {
+    m_dvRecoveryPending = true;
+    if (!m_dvSuperseded)
+    {
+      m_dvRejectedRoute = m_dvSelection.route;
+      if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+          drm && drm->DVActivationFailures() == m_dvAttemptFailures)
+        drm->FailDVActivation(EINVAL);
+    }
+  }
+  if (!HasPendingDVOutputSurface())
+  {
+    if (m_dvBridge) m_dvBridge->Cancel();
+    if (!m_dvContext || !m_dvContext->FenceLastUse()) m_dvRollbackFailed = true;
+    return !m_dvRollbackFailed;
+  }
+  if (!m_dvRejectedSurface)
+  {
+    m_dvRejectedSurface = true;
+    m_dvConfiguredOutput.reset();
+    if (m_dvBridge) m_dvBridge->Cancel();
+    // The tail covers imports, resolve and the candidate's native swap commands.
+    if (!m_dvContext || !m_dvContext->FenceLastUse()) m_dvRollbackFailed = true;
+    if (!m_eglContext.BindPriorOutputSurface()) m_dvRollbackFailed = true;
+  }
+  return PollRejectedDVSurface();
+}
+
+bool CWinSystemGbmGLContext::PollRejectedDVSurface()
+{
+  if (!m_dvRejectedSurface) return true;
+  if (m_dvRollbackFailed || !m_dvContext) return false;
+  const auto retired = m_dvContext->Poll();
+  if (retired != DVBRIDGE_DV_IDLE)
+  {
+    if (retired == DVBRIDGE_DV_FAILED) m_dvRollbackFailed = true;
+    return false;
+  }
+  if (!CompleteDVOutputSurface(false))
+  {
+    m_dvRollbackFailed = true;
+    return false;
+  }
+  // Ordinary restoration may retain a 10-bit drawable without CB1 processing.
+  m_pascalHDRActive = m_priorPascalHDRActive;
+  if (m_dvBridge && m_dvPriorConfiguredOutput &&
+      !m_dvBridge->RebindOutputSurface(m_dvPriorHDRConversion, m_dvPriorSDRConversion,
+                                       HDR10Framebuffer()))
+  {
+    m_dvRollbackFailed = true;
+    return false;
+  }
+  m_hdrConversion = m_dvPriorHDRConversion;
+  m_sdrConversion = m_dvPriorSDRConversion;
+  m_hdr10Signal.reset();
+  m_dvConfiguredOutput = m_dvPriorConfiguredOutput;
+  const bool guiReady = ConfigureGuiCompositing(m_dvPriorGuiCompositing ?
+      (m_dvPriorSDRConversion ? AVCOL_TRC_GAMMA22 : AVCOL_TRC_SMPTE2084) : 0,
+      m_dvPriorGuiSDRGamma);
+  if (m_dvPriorGuiCompositing && !guiReady)
+  {
+    m_dvRollbackFailed = true;
+    return false;
+  }
+  m_dvRejectedSurface = false;
+  return true;
+}
+
+bool KODI::WINDOWING::GBM::HasDVBridgeScreenshot(CWinSystemBase& window)
+{
+  auto* gbm = dynamic_cast<CWinSystemGbmGLContext*>(&window);
+  return gbm && gbm->HasDVBridgeScreenshot();
+}
+
+bool KODI::WINDOWING::GBM::IsDVBridgeScreenshotSDR(CWinSystemBase& window)
+{
+  auto* gbm = dynamic_cast<CWinSystemGbmGLContext*>(&window);
