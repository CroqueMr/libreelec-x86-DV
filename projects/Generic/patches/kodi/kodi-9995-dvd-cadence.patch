+
+struct AVFilterGraph;
+struct AVFilterContext;
+
+/*!
+ * \brief Runs the FFmpeg idet filter on decoded frames and feeds a cadence detector.
+ *
+ * The analysis graph is separate from the processing graph, so every decoded frame is
+ * observed even when the processing graph buffers or drops frames.
+ */
+class CFieldAnalysis
+{
+public:
+  CFieldAnalysis() = default;
+  ~CFieldAnalysis();
+  CFieldAnalysis(const CFieldAnalysis&) = delete;
+  CFieldAnalysis& operator=(const CFieldAnalysis&) = delete;
+
+  //! \return true when the confirmed cadence changed
+  bool Analyse(const AVFrame* frame);
+  std::optional<FILM_CADENCE::Cadence> Confirmed() const { return m_detector.Confirmed(); }
+  void Reset();
+  //! start from a cadence decided before playback
+  void Seed(FILM_CADENCE::Cadence cadence) { m_detector.Seed(cadence); }
+  //! called with the observation of every analysed frame
+  void SetObserver(std::function<void(const FILM_CADENCE::FrameObservation&)> observer)
+  {
+    m_observer = std::move(observer);
+  }
+
+private:
+  bool Open(const AVFrame* frame);
+  void Close();
+
+  FILM_CADENCE::CCadenceDetector m_detector;
+  //! decoder flags (interlaced, repeated field); idet rewrites the frame flags
+  std::deque<std::pair<bool, bool>> m_coded;
+  std::function<void(const FILM_CADENCE::FrameObservation&)> m_observer;
+  AVFilterGraph* m_graph = nullptr;
+  AVFilterContext* m_in = nullptr;
+  AVFilterContext* m_out = nullptr;
+  AVFrame* m_result = nullptr;
+  int m_width = 0;
+  int m_height = 0;
+  int m_format = -1;
+  bool m_failed = false;
+};
