+
+CSoftTelecineDetector::CSoftTelecineDetector(std::size_t window)
+  : m_window(std::max<std::size_t>(window, 8))
+{
+}
+
+void CSoftTelecineDetector::Reset()
+{
+  m_repeated.clear();
+  m_agree = 0;
+  m_active = false;
+  m_decided = false;
+}
+
+bool CSoftTelecineDetector::Add(bool interlaced, double repeatFields)
+{
+  bool pattern = false;
+  if (interlaced)
+  {
+    m_repeated.clear();
+  }
+  else
+  {
+    m_repeated.push_back(repeatFields > 0);
+    if (m_repeated.size() > m_window)
+      m_repeated.pop_front();
+    // The first decision is made on half a window so that the output rate is known
+    // before the display mode is chosen for long.
+    const std::size_t needed = m_decided ? m_window : m_window / 2;
+    if (m_repeated.size() >= needed)
+    {
+      const std::size_t frames = m_repeated.size();
+      const auto repeats = static_cast<std::size_t>(std::ranges::count(m_repeated, true));
+      // 3:2 is one repeat every two frames; also never two repeats in a row.
+      bool consecutive = false;
+      for (std::size_t i = 1; i < m_repeated.size(); ++i)
+        consecutive = consecutive || (m_repeated[i] && m_repeated[i - 1]);
+      pattern = !consecutive && repeats * 5 >= frames * 2 && repeats * 5 <= frames * 3;
+    }
+  }
+
+  if (pattern == m_active)
+  {
+    m_agree = 0;
+    m_decided = m_decided || m_repeated.size() >= m_window / 2;
+    return false;
+  }
+  // Entering on the first decision and leaving at an interlaced picture are immediate;
+  // any other change needs a full window of agreement.
+  if (!m_decided || interlaced || ++m_agree >= m_window)
+  {
+    m_active = pattern;
+    m_agree = 0;
+    m_decided = true;
+    return true;
+  }
+  return false;
+}
+
+double CodedFrameDuration(double timeBase, double codedRate, double containerRate)
+{
+  if (codedRate > 0)
+    return timeBase / codedRate;
+  if (containerRate > 0)
+    return timeBase / containerRate;
+  return timeBase * 1001 / 30000;
+}
+
+std::optional<double> CFilmRetimer::Retime(std::optional<double> pts, double frameDuration)
+{
+  std::optional<double> out;
+  if (m_next && pts && std::abs(*pts - *m_next) <= frameDuration)
+    out = *m_next + (*pts - *m_next) / 16; // follow the source clock, not its 3:2 steps
+  else if (pts)
+    out = pts;
+  else
+    out = m_next;
+
+  if (out)
+    m_next = *out + frameDuration;
+  return out;
+}
+
+} // namespace FILM_TIMING
