+bool IsScanCandidate(const CDVDStreamInfo& hint)
+{
+  return (hint.codec == AV_CODEC_ID_MPEG2VIDEO || hint.codec == AV_CODEC_ID_H264) &&
+         hint.height > 0 && hint.height <= 576 && !hint.stills;
+}
+
+std::optional<TitlePlan> ScanTitlePlan(ITitleData& data,
+                                       EINTERLACEMETHOD method,
+                                       const std::string& name)
+{
+  const ScanResult result = ScanTitle(data, ScanLimits{});
+  std::optional<TitlePlan> plan = result.plan;
+  if (plan && !plan->softTelecine)
+  {
+    switch (plan->cadence)
+    {
+      case Cadence::TELECINE:
+      case Cadence::FIELD_PAIRED:
+      case Cadence::INTERLACED:
+        // the output rate of the other deinterlacing methods is theirs to choose
+        if (method == VS_INTERLACEMETHOD_INVERSE_TELECINE)
+          plan->cadence = InverseTelecineCadence(plan->frameRate);
+        else if (method != VS_INTERLACEMETHOD_CADENCE_AUTO)
+          plan.reset();
+        break;
+      case Cadence::REPEATED_FRAME:
+        // only film detection on decoded frames removes repeats; H.264 can be decoded by
+        // VAAPI, whose processing does not
+        if (method != VS_INTERLACEMETHOD_CADENCE_AUTO || result.codec != AV_CODEC_ID_MPEG2VIDEO)
+          plan->cadence = Cadence::PROGRESSIVE;
+        break;
+      case Cadence::PROGRESSIVE:
+        break;
+    }
+  }
+
+  CLog::Log(LOGINFO,
+            "TitleScan: {}: {}, display {:.3f} Hz ({} frames at {} points, {} votes, repeat "
+            "score {:.1f}, {} ms)",
+            name,
+            !plan ? "no decision" : plan->softTelecine ? "soft telecine" : Name(plan->cadence),
+            plan ? DisplayRate(*plan) : 0.0, result.frames, result.segments, result.votes,
+            result.repeatScore, result.elapsedMs);
+  return plan;
+}
+
+std::unique_ptr<ITitleData> OpenFileTitleData(const std::string& path)
+{
+  auto data = std::make_unique<CFileTitleData>();
+  if (!data->Open(path))
+    return {};
+  return data;
+}
+
+} // namespace FILM_CADENCE
