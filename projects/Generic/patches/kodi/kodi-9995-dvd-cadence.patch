+//! The sectors of the first program chain of a title, read through a navigator of its own
+class CDVDTitleData : public FILM_CADENCE::ITitleData
+{
+public:
+  CDVDTitleData(DllDvdNav& dll, dvdnav_t* navigator, std::unique_ptr<CDVDInputStreamFile> stream)
+    : m_dll(dll), m_stream(std::move(stream)), m_navigator(navigator)
+  {
+  }
+  ~CDVDTitleData() override { m_dll.dvdnav_close(m_navigator); }
+
+  //! start the title and stop at its first cell
+  bool Start(int title)
+  {
+    if (m_dll.dvdnav_set_PGC_positioning_flag(m_navigator, 1) != DVDNAV_STATUS_OK ||
+        m_dll.dvdnav_title_play(m_navigator, title) != DVDNAV_STATUS_OK)
+      return false;
+    for (int i = 0; i < 1024; ++i)
+    {
+      int32_t event = 0;
+      int32_t length = 0;
+      if (m_dll.dvdnav_get_next_block(m_navigator, m_block, &event, &length) != DVDNAV_STATUS_OK ||
+          event == DVDNAV_STOP)
+        return false;
+      if (event == DVDNAV_STILL_FRAME)
+        m_dll.dvdnav_still_skip(m_navigator);
+      else if (event == DVDNAV_WAIT)
+        m_dll.dvdnav_wait_skip(m_navigator);
+      else if (event == DVDNAV_CELL_CHANGE && m_dll.dvdnav_is_domain_vts(m_navigator))
+      {
+        uint32_t position = 0;
+        return m_dll.dvdnav_get_position(m_navigator, &position, &m_sectors) ==
+                   DVDNAV_STATUS_OK &&
+               m_sectors > 0;
+      }
+    }
+    return false;
+  }
+
+  int Read(uint8_t* buffer, int size) override
+  {
+    int done = 0;
+    while (done < size && !m_end)
+    {
+      if (m_offset >= DVD_VIDEO_LB_LEN && !NextBlock())
+        break;
+      const int count = std::min(size - done, DVD_VIDEO_LB_LEN - m_offset);
+      std::memcpy(buffer + done, m_block + m_offset, count);
+      m_offset += count;
+      done += count;
+    }
+    return done;
+  }
+
+  int64_t Seek(int64_t position) override
+  {
+    m_end = position == Size();
+    if (m_end)
+      return position;
+    if (position < 0 || position > Size() ||
+        m_dll.dvdnav_sector_search(m_navigator, position / DVD_VIDEO_LB_LEN, SEEK_SET) !=
+            DVDNAV_STATUS_OK)
+      return -1;
+    m_offset = DVD_VIDEO_LB_LEN;
+    m_skip = static_cast<int>(position % DVD_VIDEO_LB_LEN);
+    return position;
+  }
+
+  int64_t Size() override { return static_cast<int64_t>(m_sectors) * DVD_VIDEO_LB_LEN; }
+
+private:
+  bool NextBlock()
+  {
+    // a few events (cell, stream or still changes) can come between two blocks
+    for (int i = 0; i < 64; ++i)
+    {
+      int32_t event = 0;
+      int32_t length = 0;
+      if (m_dll.dvdnav_get_next_block(m_navigator, m_block, &event, &length) != DVDNAV_STATUS_OK)
+        return false;
+      switch (event)
+      {
+        case DVDNAV_BLOCK_OK:
+        case DVDNAV_NAV_PACKET:
+          m_offset = m_skip;
+          m_skip = 0;
+          return true;
+        case DVDNAV_STILL_FRAME:
+          m_dll.dvdnav_still_skip(m_navigator);
+          break;
+        case DVDNAV_WAIT:
+          m_dll.dvdnav_wait_skip(m_navigator);
+          break;
+        case DVDNAV_STOP:
+          return false;
+        default:
+          break;
+      }
+      // the end of the title can lead to a menu
+      if (!m_dll.dvdnav_is_domain_vts(m_navigator))
+        return false;
+    }
+    return false;
+  }
+
+  DllDvdNav& m_dll;
+  std::unique_ptr<CDVDInputStreamFile> m_stream; //!< the image file of a disc image
+  dvdnav_t* m_navigator;
+  uint32_t m_sectors = 0;
+  uint8_t m_block[DVD_VIDEO_LB_LEN];
+  int m_offset = DVD_VIDEO_LB_LEN; //!< read position in m_block
+  int m_skip = 0; //!< bytes of the next block before the seek position
+  bool m_end = false; //!< positioned at the end of the title
+};
