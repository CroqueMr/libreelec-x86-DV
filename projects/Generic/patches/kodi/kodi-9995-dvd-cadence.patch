+
+#pragma once
+
+/*!
+ * \file FilmTiming.h
+ * \brief Presentation of film frames at their own rate (23.976 for NTSC film).
+ * Free of FFmpeg and Kodi dependencies.
+ */
+
+#include <cstddef>
+#include <deque>
+#include <optional>
+
+namespace FILM_TIMING
+{
+
+/*!
+ * \brief Detects soft telecine: progressive film frames with MPEG-2 repeat_first_field
+ * flags in a 3:2 pattern (one repeated field on every second frame).
+ *
+ * The first decision is made after half a window. Later changes need a full window of
+ * agreement, so that an occasional irregular flag does not toggle the output rate.
+ */
+class CSoftTelecineDetector
+{
+public:
+  explicit CSoftTelecineDetector(std::size_t window = 24);
+
+  /*!
+   * \param interlaced picture is coded as interlaced
+   * \param repeatFields extra fields to display, VideoPicture::iRepeatPicture (0.5 per field)
+   * \return true when the decision changed
+   */
+  bool Add(bool interlaced, double repeatFields);
+  bool Active() const { return m_active; }
+  void Reset();
+  //! Start from a decision made before playback; a change needs a full window.
+  void Seed(bool active);
+
+private:
+  const std::size_t m_window;
+  std::deque<bool> m_repeated; //!< empty after an interlaced picture
+  std::size_t m_agree = 0;
+  bool m_active = false;
+  bool m_decided = false; //!< a first decision was made
+};
+
+/*!
+ * \brief Duration of a coded frame (two fields) of a pulldown stream
+ *
+ * The rate coded in the video stream is preferred. A container can give the film rate
+ * of a soft-telecined stream: Matroska gives the average frame rate, 23.976.
+ * \param timeBase units per second of the result
+ * \param codedRate frame rate coded in the video stream, 0 if unknown
+ * \param containerRate frame rate given by the container, 0 if unknown
+ */
+double CodedFrameDuration(double timeBase, double codedRate, double containerRate);
+
+/*!
+ * \brief Duration of a film frame recovered from a 3:2 cadence
+ * \param codedFrameDuration duration of a coded frame (two fields) of the stream
+ */
+constexpr double PulldownFilmFrameDuration(double codedFrameDuration)
+{
+  return codedFrameDuration * 5 / 4;
+}
+
+/*!
+ * \brief Evenly spaced presentation times for film frames.
+ *
+ * 3:2 timestamps are within one film frame of the even film time. A larger difference is
+ * a discontinuity and restarts the timeline at the given timestamp.
+ */
+class CFilmRetimer
+{
+public:
+  std::optional<double> Retime(std::optional<double> pts, double frameDuration);
+  void Reset() { m_next.reset(); }
+
+private:
+  std::optional<double> m_next;
+};
+
+} // namespace FILM_TIMING
