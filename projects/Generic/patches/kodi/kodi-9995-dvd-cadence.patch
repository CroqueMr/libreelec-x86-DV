+void CVideoPlayerVideo::ApplyTitlePlan()
+{
+  uint64_t generation = 0;
+  const auto plan = m_processInfo.GetTitlePlan(generation);
+  if (generation == m_titlePlanGeneration)
+    return;
+  m_titlePlanGeneration = generation;
+  m_titleDisplayRate = plan ? FILM_CADENCE::DisplayRate(*plan) : 0;
+  if (plan)
+    m_softTelecine.Seed(plan->softTelecine);
+  CLog::Log(LOGDEBUG, "CVideoPlayerVideo - title plan: display rate {:.3f}", m_titleDisplayRate);
+}
+
+void CVideoPlayerVideo::PresentFilmFrame()
+{
+  ApplyTitlePlan();
+  const bool interlaced = m_picture.iFlags & DVP_FLAG_INTERLACED;
+  if (m_softTelecine.Add(interlaced, m_picture.iRepeatPicture))
+  {
+    CLog::Log(LOGINFO, "CVideoPlayerVideo - soft telecine {}",
+              m_softTelecine.Active() ? "detected, showing film frames at the film rate"
+                                      : "ended");
+    if (!m_softTelecine.Active())
+    {
+      m_fFrameRate = m_streamFrameRate;
+      m_bFpsInvalid = m_streamFpsInvalid;
+      m_processInfo.SetVideoFps(m_bFpsInvalid ? 0.0f : static_cast<float>(m_fFrameRate));
+      m_ptsTracker.Flush();
+      ResetFrameRateCalc();
+    }
+  }
+
+  if (m_softTelecine.Active() && !interlaced && m_picture.filmFrameDuration <= 0)
+    m_picture.filmFrameDuration =
+        FILM_TIMING::PulldownFilmFrameDuration(FILM_TIMING::CodedFrameDuration(
+            DVD_TIME_BASE, m_picture.codedFrameRate,
+            m_hints.fpsrate > 0 && m_hints.fpsscale > 0
+                ? static_cast<double>(m_hints.fpsrate) / m_hints.fpsscale
+                : 0));
+
+  const double duration = m_picture.filmFrameDuration;
+  if (duration <= 0)
+  {
+    m_filmRetimer.Reset();
+    return;
+  }
+
+  // The repeated fields of the 3:2 pattern are not shown: every film frame lasts the same.
+  m_picture.iRepeatPicture = 0;
+  m_picture.iDuration = duration;
+  // m_picture.pts is the predicted time when the picture has no timestamp
+  const auto retimed = m_filmRetimer.Retime(
+      m_picture.pts != DVD_NOPTS_VALUE ? std::optional<double>(m_picture.pts) : std::nullopt,
+      duration);
+  if (retimed)
+    m_picture.pts = *retimed;
+
+  const double rate = DVD_TIME_BASE / duration;
+  if (m_bFpsInvalid || std::abs(m_fFrameRate - rate) > 0.01)
+  {
+    CLog::Log(LOGDEBUG, "CVideoPlayerVideo - film frame rate {:.3f}", rate);
+    m_fFrameRate = rate;
+    m_bFpsInvalid = false;
+    m_processInfo.SetVideoFps(static_cast<float>(rate));
+  }
+}
