index 0000000..67fe904
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/FilmCadence.cpp
@@ -0,0 +1,475 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "FilmCadence.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <complex>
+#include <cstring>
+#include <functional>
+#include <numbers>
+
+namespace FILM_CADENCE
+{
+
+bool IsFilm(Cadence cadence)
+{
+  return cadence == Cadence::TELECINE || cadence == Cadence::FIELD_PAIRED ||
+         cadence == Cadence::REPEATED_FRAME;
+}
+
+Cadence InterlacedCadence(std::optional<Cadence> cadence)
+{
+  if (cadence == Cadence::TELECINE || cadence == Cadence::FIELD_PAIRED)
+    return *cadence;
+  return Cadence::INTERLACED;
+}
+
+bool CanRepeatFrames(double framesPerSecond)
+{
+  return std::abs(framesPerSecond - 30000.0 / 1001.0) < 0.1 ||
+         std::abs(framesPerSecond - 30.0) < 0.1;
+}
+
+std::string FilterGraph(Cadence cadence)
+{
+  if (cadence == Cadence::INTERLACED)
+    return "bwdif=mode=send_field:parity=auto:deint=all";
+  if (cadence == Cadence::REPEATED_FRAME)
+    return "decimate=cycle=6"; // drop the most similar frame of every six
+  if (cadence == Cadence::PROGRESSIVE)
+    return "";
+
+  // fieldmatch rebuilds frames from matching fields and flags the frames it could not
+  // match; bwdif then interpolates only those orphan frames.
+  std::string graph = "fieldmatch=order=auto:combmatch=full,"
+                      "bwdif=mode=send_frame:parity=auto:deint=interlaced";
+  if (cadence == Cadence::TELECINE)
+    graph += ",decimate"; // drop the fifth frame, a duplicate after 3:2 field matching
+  return graph;
+}
+
+Cadence InverseTelecineCadence(double framesPerSecond)
+{
+  return std::abs(framesPerSecond - 30000.0 / 1001.0) < 0.1 ||
+                 std::abs(framesPerSecond - 30.0) < 0.1
+             ? Cadence::TELECINE
+             : Cadence::FIELD_PAIRED;
+}
+
+double FilmFrameDuration(Cadence cadence, double codedFrameDuration)
+{
+  switch (cadence)
+  {
+    case Cadence::TELECINE:
+      return codedFrameDuration * 5 / 4;
+    case Cadence::FIELD_PAIRED:
+      return codedFrameDuration;
+    case Cadence::REPEATED_FRAME:
+      return codedFrameDuration * 6 / 5;
+    case Cadence::INTERLACED:
+    case Cadence::PROGRESSIVE:
+      break;
+  }
+  return 0;
+}
+
+const char* Name(Cadence cadence)
+{
+  switch (cadence)
+  {
+    case Cadence::TELECINE:
+      return "inverse telecine";
+    case Cadence::FIELD_PAIRED:
+      return "field matching";
+    case Cadence::REPEATED_FRAME:
+      return "frame repeat removal";
+    case Cadence::PROGRESSIVE:
+      return "progressive";
+    case Cadence::INTERLACED:
+      break;
+  }
+  return "video deinterlacing";
+}
+
+std::string BufferSourceArgs(int width,
+                             int height,
+                             int pixelFormat,
+                             int aspectNum,
+                             int aspectDen,
+                             int rateNum,
+                             int rateDen)
+{
+  constexpr int timeBase = 1000000; // AV_TIME_BASE
+  if (aspectNum <= 0 || aspectDen <= 0)
+    aspectNum = aspectDen = 1;
+  if (rateNum <= 0 || rateDen <= 0)
+  {
+    rateNum = 30000;
+    rateDen = 1001;
+  }
+  return "video_size=" + std::to_string(width) + "x" + std::to_string(height) +
+         ":pix_fmt=" + std::to_string(pixelFormat) + ":time_base=1/" + std::to_string(timeBase) +
+         ":pixel_aspect=" + std::to_string(aspectNum) + "/" + std::to_string(aspectDen) +
+         ":frame_rate=" + std::to_string(rateNum) + "/" + std::to_string(rateDen);
+}
+
+FieldOrder ParseFieldOrder(const char* idetValue)
+{
+  if (!idetValue)
+    return FieldOrder::UNDETERMINED;
+  if (!std::strcmp(idetValue, "tff"))
+    return FieldOrder::TFF;
+  if (!std::strcmp(idetValue, "bff"))
+    return FieldOrder::BFF;
+  if (!std::strcmp(idetValue, "progressive"))
+    return FieldOrder::PROGRESSIVE;
+  return FieldOrder::UNDETERMINED;
+}
+
+CCadenceDetector::CCadenceDetector(std::size_t window)
+  : m_window(std::max<std::size_t>(window, 10))
+{
+}
+
+void CCadenceDetector::Reset()
+{
+  m_frames.clear();
+  m_differences.clear();
+  m_index = 0;
+  m_repeatPhase = 0;
+  m_repeatRun = 0;
+  m_confirmed.reset();
+  m_candidate.reset();
+  m_agree = 0;
+}
+
+std::optional<Cadence> CCadenceDetector::Classify(std::size_t& repeatPhase) const
+{
+  const std::size_t needed = m_confirmed ? m_window : m_window / 2;
+  if (m_frames.size() < needed)
+    return std::nullopt;
+
+  FieldCounts counts;
+  for (const auto& [observation, index] : m_frames)
+    counts.Add(observation, index);
+  if (counts.interlaced * 2 < counts.frames)
+    return ClassifyProgressive(repeatPhase);
+  return ClassifyFields(counts);
+}
+
+void FieldCounts::Add(const FrameObservation& observation, uint64_t index)
+{
+  ++frames;
+  interlaced += observation.interlaced;
+  if (observation.repeatedField)
+  {
+    ++repeated;
+    ++phase[index % phase.size()];
+  }
+  progressive += observation.order == FieldOrder::PROGRESSIVE;
+  combed += observation.order == FieldOrder::TFF || observation.order == FieldOrder::BFF;
+}
+
+std::optional<Cadence> ClassifyFields(const FieldCounts& counts)
+{
+  const double frames = static_cast<double>(counts.frames);
+  const double repeated = static_cast<double>(counts.repeated);
+  // 3:2 pulldown repeats a top and a bottom field in every five frames, at the same two
+  // positions of the cycle while the cadence is unbroken.
+  if (repeated >= 0.3 * frames && repeated <= 0.5 * frames)
+  {
+    std::array<std::size_t, 5> phase = counts.phase;
+    std::ranges::sort(phase, std::greater<>());
+    if (static_cast<double>(phase[0] + phase[1]) >= 0.8 * repeated)
+      return Cadence::TELECINE;
+  }
+  if (repeated <= 0.1 * frames)
+  {
+    if (static_cast<double>(counts.progressive) >= 0.8 * frames)
+      return Cadence::FIELD_PAIRED;
+    if (static_cast<double>(counts.combed) >= 0.6 * frames)
+      return Cadence::INTERLACED;
+  }
+  return std::nullopt;
+}
+
+std::optional<Cadence> CCadenceDetector::ClassifyProgressive(std::size_t& phase) const
+{
+  constexpr std::size_t cycle = 6;
+  constexpr std::size_t cycles = 10;
+  // Below this mean difference (8-bit levels) a cycle is static and says nothing.
+  constexpr double motion = 0.2;
+  if (m_differences.size() < cycle * cycles)
+    return std::nullopt;
+
+  std::array<std::size_t, cycle> lowest{};
+  std::array<double, cycle> ratio{};
+  std::size_t moving = 0;
+  std::array<double, cycle> values{};
+  std::array<std::size_t, cycle> positions{};
+  std::size_t count = 0;
+  for (const auto& [observation, index] : m_differences)
+  {
+    if (count == 0 && index % cycle != 0)
+      continue; // start on a complete cycle
+    values[count] = observation.difference;
+    positions[count] = index % cycle;
+    if (++count < cycle)
+      continue;
+    count = 0;
+    if (std::ranges::any_of(values, [](double value) { return value < 0; }))
+      continue;
+    std::array<double, cycle> sorted = values;
+    std::ranges::sort(sorted);
+    const double median = (sorted[cycle / 2 - 1] + sorted[cycle / 2]) / 2;
+    if (median < motion)
+      continue;
+    const auto smallest = std::ranges::min_element(values) - values.begin();
+    ++moving;
+    ++lowest[positions[smallest]];
+    ratio[positions[smallest]] += values[smallest] / median;
+  }
+  if (moving < cycles * 6 / 10)
+    return std::nullopt; // mostly static: keep the current decision
+
+  const auto mode = std::ranges::max_element(lowest) - lowest.begin();
+  // 25 fps film repeats a frame at the same position of every cycle; the repeat is the
+  // smallest difference of its cycle, well below the others.
+  if (lowest[mode] * 10 >= moving * 6 && ratio[mode] / lowest[mode] <= 0.8)
+  {
+    phase = static_cast<std::size_t>(mode);
+    return Cadence::REPEATED_FRAME;
+  }
+  return Cadence::PROGRESSIVE;
+}
+
+bool CCadenceDetector::Add(const FrameObservation& observation)
+{
+  m_differences.push_back({observation, m_index});
+  while (m_differences.size() > 6 * 10)
+    m_differences.pop_front();
+  m_frames.push_back({observation, m_index++});
+  while (m_frames.size() > m_window)
+    m_frames.pop_front();
+
+  std::size_t phase = 0;
+  std::optional<Cadence> cadence = Classify(phase);
+  if (cadence == Cadence::REPEATED_FRAME)
+  {
+    m_repeatRun = phase == m_repeatPhase ? m_repeatRun + 1 : 1;
+    m_repeatPhase = phase;
+    // Animation and edited video also have duplicates, at changing positions.
+    if (m_confirmed != Cadence::REPEATED_FRAME && m_repeatRun < 3 * m_window)
+      cadence = m_confirmed ? m_confirmed : std::optional<Cadence>(Cadence::PROGRESSIVE);
+  }
+  else
+    m_repeatRun = 0;
+  if (!cadence || cadence == m_confirmed)
+  {
+    m_agree = 0;
+    return false;
+  }
+  if (cadence != m_candidate)
+  {
+    m_candidate = cadence;
+    m_agree = 0;
+  }
+  // Repeats of real film are not exact and edits move them in the cycle, so a film can
+  // look like plain progressive video for several seconds: leaving repeat removal needs
+  // twenty windows (20 s).
+  const std::size_t needed =
+      m_confirmed == Cadence::REPEATED_FRAME && cadence == Cadence::PROGRESSIVE ? 20 * m_window
+                                                                              : m_window;
+  if (m_confirmed && ++m_agree < needed)
+    return false;
+  m_confirmed = cadence;
+  m_agree = 0;
+  return true;
+}
+
+void CCadenceDetector::Seed(Cadence cadence)
+{
+  Reset();
+  m_confirmed = cadence;
+}
+
+double DisplayRate(const TitlePlan& plan)
+{
+  const double rate = plan.frameRate;
+  if (plan.softTelecine)
+    return CanRepeatFrames(rate) ? rate * 4 / 5 : rate;
+  switch (plan.cadence)
+  {
+    case Cadence::TELECINE:
+      return rate * 4 / 5;
+    case Cadence::REPEATED_FRAME:
+      // 25 fps film slowed to 24.975 by the 29.97 conversion: no display mode has that
+      // rate, the 25 Hz family repeats a frame about every 40 s.
+      return 25;
+    case Cadence::INTERLACED:
+      return rate * 2;
+    case Cadence::FIELD_PAIRED:
+    case Cadence::PROGRESSIVE:
+      break;
+  }
+  return rate;
+}
+
+CTitleScan::CTitleScan(double frameRate, bool canRemoveRepeats)
+  : m_frameRate(frameRate), m_canRemoveRepeats(canRemoveRepeats && CanRepeatFrames(frameRate))
+{
+}
+
+void CTitleScan::StartSegment()
+{
+  if (const auto vote = Classify(m_segment))
+  {
+    ++m_counts[static_cast<std::size_t>(*vote)];
+    if (*vote == Vote::PROGRESSIVE)
+    {
+      std::vector<double> differences;
+      for (const auto& frame : m_segment)
+        differences.push_back(frame.difference);
+      m_progressive.push_back(std::move(differences));
+    }
+  }
+  m_segment.clear();
+}
+
+void CTitleScan::Add(const FrameObservation& observation)
+{
+  m_segment.push_back(observation);
+}
+
+std::optional<CTitleScan::Vote> CTitleScan::Classify(
+    const std::vector<FrameObservation>& frames) const
+{
+  constexpr std::size_t minimum = 24;
+  if (frames.size() < minimum)
+    return std::nullopt;
+  FieldCounts counts;
+  std::size_t repeatFlags = 0;
+  for (std::size_t i = 0; i < frames.size(); ++i)
+  {
+    counts.Add(frames[i], i);
+    repeatFlags += !frames[i].interlaced && frames[i].repeatFirstField;
+  }
+  if (counts.interlaced * 2 >= counts.frames)
+  {
+    switch (ClassifyFields(counts).value_or(Cadence::PROGRESSIVE))
+    {
+      case Cadence::TELECINE:
+        return Vote::TELECINE;
+      case Cadence::FIELD_PAIRED:
+        return Vote::FIELD_PAIRED;
+      case Cadence::INTERLACED:
+        return Vote::INTERLACED;
+      default:
+        return std::nullopt; // static fields say nothing
+    }
+  }
+  // 3:2 soft telecine flags two frames in four; the flags do not need motion.
+  const double progressive = static_cast<double>(counts.frames - counts.interlaced);
+  const double flagged = static_cast<double>(repeatFlags);
+  if (flagged >= 0.3 * progressive && flagged <= 0.7 * progressive)
+    return Vote::SOFT_TELECINE;
+  return Vote::PROGRESSIVE;
+}
+
+double CTitleScan::RepeatPattern() const
+{
+  constexpr double motion = 0.2; // mean difference of a static frame (8-bit levels)
+  constexpr std::size_t half = 3; // the local level is the median of six differences
+  constexpr std::size_t minimum = 36; // moving frames for a segment to count
+  double power = 0;
+  std::array<double, 2> harmonic{}; // at 1/6 and 1/3 of the frame rate
+  std::size_t segments = 0;
+  for (const auto& differences : m_progressive)
+  {
+    // Differences relative to the local level, so that the amount of motion does not
+    // matter. The first difference of a segment is from an unrelated frame.
+    std::vector<double> z;
+    std::vector<bool> valid;
+    for (std::size_t i = 1 + half; i + half <= differences.size(); ++i)
+    {
+      std::array<double, 2 * half> local{};
+      std::copy(differences.begin() + static_cast<std::ptrdiff_t>(i - half),
+                differences.begin() + static_cast<std::ptrdiff_t>(i + half), local.begin());
+      std::ranges::sort(local);
+      const double level = (local[half - 1] + local[half]) / 2;
+      const bool ok = level >= motion && local[0] >= 0;
+      z.push_back(ok ? std::min(differences[i] / level, 2.0) : 0);
+      valid.push_back(ok);
+    }
+    const auto count = static_cast<std::size_t>(std::ranges::count(valid, true));
+    if (count < minimum)
+      continue;
+    double mean = 0;
+    for (std::size_t i = 0; i < z.size(); ++i)
+      mean += valid[i] ? z[i] : 0;
+    mean /= static_cast<double>(count);
+    std::array<std::complex<double>, 2> sum{};
+    for (std::size_t i = 0; i < z.size(); ++i)
+    {
+      const double value = valid[i] ? z[i] - mean : 0;
+      power += value * value;
+      for (std::size_t h = 0; h < harmonic.size(); ++h)
+        sum[h] += value * std::polar(1.0, -2 * std::numbers::pi * static_cast<double>(i) *
+                                              static_cast<double>(h + 1) / 6);
+    }
+    for (std::size_t h = 0; h < harmonic.size(); ++h)
+      harmonic[h] += std::norm(sum[h]);
+    ++segments;
+  }
+  if (!segments || power <= 0)
+    return 0;
+  // Noise has a relative power of 1 at every frequency, with a spread that falls with the
+  // square root of the number of segments.
+  const double relative = std::min(harmonic[0], harmonic[1]) / power;
+  return (relative - 1) * std::sqrt(static_cast<double>(segments));
+}
+
+std::optional<TitlePlan> CTitleScan::Decide()
+{
+  StartSegment();
+  m_votes = 0;
+  for (const std::size_t count : m_counts)
+    m_votes += count;
+  m_repeatScore = RepeatPattern();
+  const auto winner = std::ranges::max_element(m_counts) - m_counts.begin();
+  if (!m_votes || m_counts[winner] * 2 <= m_votes)
+    return std::nullopt;
+
+  TitlePlan plan;
+  plan.frameRate = m_frameRate;
+  switch (static_cast<Vote>(winner))
+  {
+    case Vote::SOFT_TELECINE:
+      plan.softTelecine = true;
+      break;
+    case Vote::TELECINE:
+      plan.cadence = Cadence::TELECINE;
+      break;
+    case Vote::FIELD_PAIRED:
+      plan.cadence = Cadence::FIELD_PAIRED;
+      break;
+    case Vote::INTERLACED:
+      plan.cadence = Cadence::INTERLACED;
+      break;
+    default:
+      if (m_canRemoveRepeats && m_repeatScore >= 3)
+        plan.cadence = Cadence::REPEATED_FRAME;
+      break;
+  }
+  return plan;
+}
+
+} // namespace FILM_CADENCE
