@@ -0,0 +1,141 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "FieldAnalysis.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <tuple>
+
+#include "utils/log.h"
+
+extern "C"
+{
+#include <libavfilter/avfilter.h>
+#include <libavfilter/buffersink.h>
+#include <libavfilter/buffersrc.h>
+#include <libavutil/dict.h>
+}
+
+using namespace FILM_CADENCE;
+
+CFieldAnalysis::~CFieldAnalysis()
+{
+  Close();
+  av_frame_free(&m_result);
+}
+
+void CFieldAnalysis::Close()
+{
+  avfilter_graph_free(&m_graph);
+  m_coded.clear();
+  m_in = nullptr;
+  m_out = nullptr;
+}
+
+void CFieldAnalysis::Reset()
+{
+  Close();
+  m_detector.Reset();
+  m_failed = false;
+}
+
+bool CFieldAnalysis::Open(const AVFrame* frame)
+{
+  Close();
+  m_width = frame->width;
+  m_height = frame->height;
+  m_format = frame->format;
+
+  m_graph = avfilter_graph_alloc();
+  if (!m_graph)
+    return false;
+
+  const std::string args = BufferSourceArgs(frame->width, frame->height, frame->format,
+                                            frame->sample_aspect_ratio.num,
+                                            frame->sample_aspect_ratio.den, 0, 0);
+  if (avfilter_graph_create_filter(&m_in, avfilter_get_by_name("buffer"), "src", args.c_str(),
+                                   nullptr, m_graph) < 0 ||
+      avfilter_graph_create_filter(&m_out, avfilter_get_by_name("buffersink"), "out", nullptr,
+                                   nullptr, m_graph) < 0)
+    return false;
+
+  // scdet gives the mean absolute difference from the previous frame (repeated frames)
+  AVFilterContext* idet = nullptr;
+  AVFilterContext* scdet = nullptr;
+  if (avfilter_graph_create_filter(&idet, avfilter_get_by_name("idet"), "idet", nullptr, nullptr,
+                                   m_graph) < 0 ||
+      avfilter_graph_create_filter(&scdet, avfilter_get_by_name("scdet"), "scdet", nullptr,
+                                   nullptr, m_graph) < 0 ||
+      avfilter_link(m_in, 0, idet, 0) < 0 || avfilter_link(idet, 0, scdet, 0) < 0 ||
+      avfilter_link(scdet, 0, m_out, 0) < 0 ||
+      avfilter_graph_config(m_graph, nullptr) < 0)
+    return false;
+
+  if (!m_result)
+    m_result = av_frame_alloc();
+  return m_result != nullptr;
+}
+
+bool CFieldAnalysis::Analyse(const AVFrame* frame)
+{
+  if (m_failed || !frame)
+    return false;
+
+  if (!m_graph || frame->width != m_width || frame->height != m_height ||
+      frame->format != m_format)
+  {
+    if (!Open(frame))
+    {
+      CLog::LogF(LOGERROR, "unable to set up the field analysis, cadence detection disabled");
+      Close();
+      m_failed = true;
+      return false;
+    }
+  }
+
+  // KEEP_REF adds a new reference and leaves the caller's frame unchanged.
+  if (av_buffersrc_add_frame_flags(m_in, const_cast<AVFrame*>(frame),
+                                   AV_BUFFERSRC_FLAG_KEEP_REF) < 0)
+    return false;
+  m_coded.emplace_back(frame->flags & AV_FRAME_FLAG_INTERLACED, frame->repeat_pict > 0);
+
+  bool changed = false;
+  while (av_buffersink_get_frame(m_out, m_result) >= 0)
+  {
+    const AVDictionaryEntry* order =
+        av_dict_get(m_result->metadata, "lavfi.idet.multiple.current_frame", nullptr, 0);
+    const AVDictionaryEntry* repeated =
+        av_dict_get(m_result->metadata, "lavfi.idet.repeated.current_frame", nullptr, 0);
+
+    FrameObservation observation;
+    if (!m_coded.empty())
+    {
+      std::tie(observation.interlaced, observation.repeatFirstField) = m_coded.front();
+      m_coded.pop_front();
+    }
+    observation.order = ParseFieldOrder(order ? order->value : nullptr);
+    observation.repeatedField =
+        repeated && (!std::strcmp(repeated->value, "top") || !std::strcmp(repeated->value, "bottom"));
+    const AVDictionaryEntry* difference =
+        av_dict_get(m_result->metadata, "lavfi.scd.mafd", nullptr, 0);
+    if (difference)
+      observation.difference = std::strtod(difference->value, nullptr);
+    if (m_observer)
+      m_observer(observation);
+    if (m_detector.Add(observation))
+    {
+      // an observed analysis (the title scan) makes its own decision
+      if (!m_observer)
+        CLog::Log(LOGINFO, "CFieldAnalysis: detected cadence: {}", Name(*m_detector.Confirmed()));
+      changed = true;
+    }
+    av_frame_unref(m_result);
+  }
+  return changed;
+}
