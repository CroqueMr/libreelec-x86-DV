+
+#pragma once
+
+/*!
+ * \file TitleScan.h
+ * \brief Cadence of a title, decided before playback from frames decoded at several
+ * points of it, so that the display mode is set once.
+ */
+
+#include "FilmCadence.h"
+
+#include <cstdint>
+#include <optional>
+
+namespace FILM_CADENCE
+{
+
+//! Seekable bytes of a title: a file, or the program stream of a DVD title
+class ITitleData
+{
+public:
+  virtual ~ITitleData() = default;
+  //! \return bytes read, 0 at the end, negative on error
+  virtual int Read(uint8_t* buffer, int size) = 0;
+  //! \return the new position, negative on error
+  virtual int64_t Seek(int64_t position) = 0;
+  //! \return the size in bytes, 0 if unknown
+  virtual int64_t Size() = 0;
+};
+
+struct ScanLimits
+{
+  int segments = 8; //!< sample points, spread over the title (a power of two)
+  double seconds = 2; //!< decoded per sample point
+  //! the scan stops after this time and decides on what it decoded (slow media)
+  int budgetMs = 1500;
+};
+
+struct ScanResult
+{
+  std::optional<TitlePlan> plan;
+  int codec = 0; //!< AVCodecID of the video stream, 0 if none
+  int height = 0;
+  int frames = 0; //!< decoded frames
+  int segments = 0; //!< sample points decoded
+  std::size_t votes = 0; //!< segments that voted for a cadence
+  double repeatScore = 0;
+  int elapsedMs = 0;
+};
+
+/*!
+ * \brief Decodes frames at several points of a title and decides its cadence.
+ *
+ * Program and transport streams are sampled at byte positions, other containers at
+ * times. A title too short for the sample points is decoded from its start.
+ */
+ScanResult ScanTitle(ITitleData& data, const ScanLimits& limits);
+
+} // namespace FILM_CADENCE
