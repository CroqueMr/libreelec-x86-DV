new file mode 100644
index 0000000..9b62024
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/TitleScan.cpp
@@ -0,0 +1,250 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "TitleScan.h"
+
+#include "FieldAnalysis.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+
+extern "C"
+{
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/mem.h>
+}
+
+using namespace FILM_CADENCE;
+
+namespace
+{
+constexpr int IO_BUFFER = 64 * 1024;
+//! a sample point gives up when its video does not start within this many bytes
+constexpr int64_t SEGMENT_BYTES = 8 * 1024 * 1024;
+
+int ReadPacket(void* opaque, uint8_t* buffer, int size)
+{
+  const int read = static_cast<ITitleData*>(opaque)->Read(buffer, size);
+  if (read == 0)
+    return AVERROR_EOF;
+  return read < 0 ? AVERROR(EIO) : read;
+}
+
+int64_t SeekData(void* opaque, int64_t offset, int whence)
+{
+  auto* data = static_cast<ITitleData*>(opaque);
+  if (whence == AVSEEK_SIZE)
+    return data->Size() > 0 ? data->Size() : -1;
+  if ((whence & ~AVSEEK_FORCE) != SEEK_SET)
+    return -1;
+  return data->Seek(offset);
+}
+
+class CScan
+{
+public:
+  CScan(ITitleData& data, const ScanLimits& limits) : m_data(data), m_limits(limits) {}
+  ~CScan()
+  {
+    av_frame_free(&m_frame);
+    av_packet_free(&m_packet);
+    avcodec_free_context(&m_decoder);
+    avformat_close_input(&m_format);
+    if (m_io)
+      av_freep(&m_io->buffer);
+    avio_context_free(&m_io);
+  }
+
+  ScanResult Run()
+  {
+    m_deadline = m_start + std::chrono::milliseconds(m_limits.budgetMs);
+    if (Open())
+      Sample();
+    m_result.elapsedMs = static_cast<int>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                              std::chrono::steady_clock::now() - m_start)
+                                              .count());
+    return m_result;
+  }
+
+private:
+  bool Open()
+  {
+    auto* buffer = static_cast<uint8_t*>(av_malloc(IO_BUFFER));
+    m_io = avio_alloc_context(buffer, IO_BUFFER, 0, &m_data, ReadPacket, nullptr, SeekData);
+    m_format = avformat_alloc_context();
+    m_packet = av_packet_alloc();
+    m_frame = av_frame_alloc();
+    if (!m_io || !m_format || !m_packet || !m_frame)
+    {
+      if (!m_io)
+        av_free(buffer);
+      return false;
+    }
+    m_format->pb = m_io;
+    m_format->flags |= AVFMT_FLAG_CUSTOM_IO;
+    m_format->probesize = 2 * 1024 * 1024;
+    m_format->max_analyze_duration = AV_TIME_BASE / 2;
+    // the end of a program stream is not read for its duration: it is sampled by bytes
+    m_format->skip_estimate_duration_from_pts = 1;
+    // reading and decoding stop at the deadline
+    m_format->interrupt_callback = {&CScan::Interrupted, this};
+    if (avformat_open_input(&m_format, nullptr, nullptr, nullptr) < 0 ||
+        avformat_find_stream_info(m_format, nullptr) < 0)
+      return false;
+
+    m_stream = av_find_best_stream(m_format, AVMEDIA_TYPE_VIDEO, -1, -1, nullptr, 0);
+    if (m_stream < 0)
+      return false;
+    const AVCodecParameters* parameters = m_format->streams[m_stream]->codecpar;
+    m_result.codec = parameters->codec_id;
+    m_result.height = parameters->height;
+    if (parameters->codec_id != AV_CODEC_ID_MPEG2VIDEO && parameters->codec_id != AV_CODEC_ID_H264)
+      return false;
+    for (unsigned int i = 0; i < m_format->nb_streams; ++i)
+      m_format->streams[i]->discard = static_cast<int>(i) == m_stream ? AVDISCARD_DEFAULT
+                                                                       : AVDISCARD_ALL;
+
+    const AVCodec* codec = avcodec_find_decoder(parameters->codec_id);
+    m_decoder = codec ? avcodec_alloc_context3(codec) : nullptr;
+    if (!m_decoder || avcodec_parameters_to_context(m_decoder, parameters) < 0)
+      return false;
+    // slice threads keep the frame order and add no delay at the end of a sample point
+    m_decoder->thread_count = 0;
+    m_decoder->thread_type = FF_THREAD_SLICE;
+    return avcodec_open2(m_decoder, codec, nullptr) >= 0;
+  }
+
+  double FrameRate() const
+  {
+    if (m_decoder->framerate.num > 0 && m_decoder->framerate.den > 0)
+      return av_q2d(m_decoder->framerate);
+    const AVRational rate = m_format->streams[m_stream]->avg_frame_rate;
+    return rate.num > 0 && rate.den > 0 ? av_q2d(rate) : 0;
+  }
+
+  bool ByBytes() const
+  {
+    const char* name = m_format->iformat->name;
+    return !std::strcmp(name, "mpeg") || !std::strcmp(name, "mpegts");
+  }
+
+  //! true if the title is long enough to be sampled at spread points
+  bool Spread() const
+  {
+    // Program streams state their peak mux rate only, and their end is not read: a title
+    // is spread if each point has 1 MiB of its own. Points of a short title can overlap.
+    if (ByBytes())
+      return m_data.Size() >= std::max(1, m_limits.segments) * int64_t{1024 * 1024};
+    const double duration =
+        m_format->duration > 0 ? static_cast<double>(m_format->duration) / AV_TIME_BASE : 0;
+    return duration >= m_limits.segments * m_limits.seconds * 1.5;
+  }
+
+  //! seek to a fraction of the title; program and transport streams by bytes
+  bool SeekTo(double fraction)
+  {
+    if (ByBytes())
+    {
+      const int64_t size = m_data.Size();
+      return size > 0 &&
+             av_seek_frame(m_format, -1, static_cast<int64_t>(fraction * size),
+                           AVSEEK_FLAG_BYTE) >= 0;
+    }
+    const int64_t begin = m_format->start_time != AV_NOPTS_VALUE ? m_format->start_time : 0;
+    const int64_t target = begin + static_cast<int64_t>(fraction * m_format->duration);
+    return avformat_seek_file(m_format, -1, INT64_MIN, target, target, 0) >= 0;
+  }
+
+  //! decode up to frames frames from the current position into the analysis
+  static int Interrupted(void* opaque)
+  {
+    return std::chrono::steady_clock::now() > static_cast<CScan*>(opaque)->m_deadline;
+  }
+
+  void Decode(CFieldAnalysis& analysis, int frames)
+  {
+    avcodec_flush_buffers(m_decoder);
+    int decoded = 0;
+    int64_t bytes = 0;
+    bool eof = false;
+    while (decoded < frames && !eof && !Interrupted(this))
+    {
+      if (av_read_frame(m_format, m_packet) < 0)
+      {
+        eof = true;
+        avcodec_send_packet(m_decoder, nullptr);
+      }
+      else
+      {
+        bytes += m_packet->size;
+        if (m_packet->stream_index == m_stream)
+          avcodec_send_packet(m_decoder, m_packet);
+        av_packet_unref(m_packet);
+        if (!decoded && bytes > SEGMENT_BYTES)
+          break;
+      }
+      while (decoded < frames && avcodec_receive_frame(m_decoder, m_frame) >= 0)
+      {
+        analysis.Analyse(m_frame);
+        av_frame_unref(m_frame);
+        ++decoded;
+      }
+    }
+    m_result.frames += decoded;
+  }
+
+  void Sample()
+  {
+    // The stream information was read from decoded frames: the rate is the coded one.
+    const double rate = FrameRate() > 0 ? FrameRate() : 30000.0 / 1001;
+    CTitleScan scan(rate, true);
+    CFieldAnalysis analysis;
+    analysis.SetObserver([&scan](const FrameObservation& observation) { scan.Add(observation); });
+
+    const int segments = std::max(1, m_limits.segments);
+    const bool spread = Spread();
+    for (int i = 0; i < (spread ? segments : 1) && !Interrupted(this); ++i)
+    {
+      // In bit-reversed order, the points decoded before the deadline are spread over
+      // the whole title.
+      int point = 0;
+      for (int bits = i, width = segments - 1; width > 0; bits >>= 1, width >>= 1)
+        point = (point << 1) | (bits & 1);
+      if (spread && !SeekTo((std::min(point, segments - 1) + 0.5) / segments))
+        continue;
+      analysis.Reset();
+      scan.StartSegment();
+      const double seconds = spread ? m_limits.seconds : segments * m_limits.seconds;
+      Decode(analysis, static_cast<int>(seconds * rate));
+      ++m_result.segments;
+    }
+    m_result.plan = scan.Decide();
+    m_result.votes = scan.Votes();
+    m_result.repeatScore = scan.RepeatScore();
+  }
+
+  ITitleData& m_data;
+  const ScanLimits m_limits;
+  const std::chrono::steady_clock::time_point m_start = std::chrono::steady_clock::now();
+  std::chrono::steady_clock::time_point m_deadline;
+  ScanResult m_result;
+  AVIOContext* m_io = nullptr;
+  AVFormatContext* m_format = nullptr;
+  AVCodecContext* m_decoder = nullptr;
+  AVPacket* m_packet = nullptr;
+  AVFrame* m_frame = nullptr;
+  int m_stream = -1;
+};
+} // namespace
+
+ScanResult FILM_CADENCE::ScanTitle(ITitleData& data, const ScanLimits& limits)
+{
+  return CScan(data, limits).Run();
+}
