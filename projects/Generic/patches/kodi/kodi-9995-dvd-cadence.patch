--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/FilmCadence.h
@@ -0,0 +1,223 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+/*!
+ * \file FilmCadence.h
+ * \brief Reconstruction of film frames from interlaced DVD video (inverse telecine).
+ * Free of FFmpeg and Kodi dependencies.
+ */
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace FILM_CADENCE
+{
+
+enum class Cadence
+{
+  TELECINE, //!< 3:2 pulldown recorded in interlaced fields (hard telecine)
+  FIELD_PAIRED, //!< both fields of a frame come from the same instant (2:2, e.g. PAL film)
+  INTERLACED, //!< every field is a different instant (video)
+  //! progressive frames, one repeated in every six (25 fps film converted to 29.97)
+  REPEATED_FRAME,
+  PROGRESSIVE, //!< progressive frames without a repeat pattern, nothing to rebuild
+};
+
+//! true if the graph of the cadence outputs complete film frames
+bool IsFilm(Cadence cadence);
+
+//! libavfilter graph that rebuilds the film frames of the cadence, or deinterlaces video
+std::string FilterGraph(Cadence cadence);
+
+//! Cadence the inverse telecine method assumes for a stream frame rate
+Cadence InverseTelecineCadence(double framesPerSecond);
+
+//! The cadence to use for interlaced frames: progressive cadences deinterlace as video
+Cadence InterlacedCadence(std::optional<Cadence> cadence);
+
+//! true if the stream frame rate can carry repeated frames of 25 fps film (29.97 or 30)
+bool CanRepeatFrames(double framesPerSecond);
+
+/*!
+ * \brief Duration of an output frame of the filter graph
+ * \param codedFrameDuration duration of a coded frame of the stream
+ */
+double FilmFrameDuration(Cadence cadence, double codedFrameDuration);
+
+const char* Name(Cadence cadence);
+
+/*!
+ * \brief Arguments of the libavfilter "buffer" source of a cadence graph.
+ *
+ * Decoded timestamps are in AV_TIME_BASE units, and decimate needs the real frame rate
+ * of the stream to time its output.
+ */
+std::string BufferSourceArgs(int width,
+                             int height,
+                             int pixelFormat,
+                             int aspectNum,
+                             int aspectDen,
+                             int rateNum,
+                             int rateDen);
+
+//! Field order of a frame, as classified by the FFmpeg idet filter ("multiple" detection)
+enum class FieldOrder
+{
+  UNDETERMINED,
+  TFF,
+  BFF,
+  PROGRESSIVE,
+};
+
+FieldOrder ParseFieldOrder(const char* idetValue);
+
+struct FrameObservation
+{
+  bool interlaced = false; //!< frame is flagged interlaced by the decoder
+  FieldOrder order = FieldOrder::UNDETERMINED;
+  bool repeatedField = false; //!< idet found a field repeated from the previous frame
+  double difference = -1; //!< mean absolute difference from the previous frame, -1 if unknown
+  bool repeatFirstField = false; //!< the frame is coded with a repeated field (soft telecine)
+};
+
+//! Field analysis of a run of frames, for the classification of interlaced-coded frames
+struct FieldCounts
+{
+  std::size_t frames = 0;
+  std::size_t interlaced = 0; //!< frames coded as interlaced
+  std::size_t repeated = 0; //!< frames with a field repeated from the previous frame
+  std::size_t progressive = 0; //!< frames idet finds progressive
+  std::size_t combed = 0; //!< frames idet finds interlaced
+  std::array<std::size_t, 5> phase{}; //!< repeated fields by position in the 5-frame cycle
+
+  void Add(const FrameObservation& observation, uint64_t index);
+};
+
+//! Cadence of interlaced-coded frames, empty if the fields do not tell
+std::optional<Cadence> ClassifyFields(const FieldCounts& counts);
+
+/*!
+ * \brief Classifies the cadence of decoded video from per-frame field analysis.
+ *
+ * Interlaced frames are classified on the window. Progressive frames are classified on
+ * the frame differences of the last ten 6-frame cycles: repeated frames of 25 fps film
+ * are the smallest difference of their cycle, at the same position in most cycles.
+ * Repeat removal starts only when that position holds for three windows, and any moving
+ * window without the pattern counts towards leaving it.
+ *
+ * The first decision is made on half a window. A later change needs a full window of
+ * agreement, so that a short scene does not toggle the processing.
+ */
+class CCadenceDetector
+{
+public:
+  explicit CCadenceDetector(std::size_t window = 30);
+
+  //! \return true when the confirmed cadence changed
+  bool Add(const FrameObservation& observation);
+  std::optional<Cadence> Confirmed() const { return m_confirmed; }
+  void Reset();
+  //! Start from a cadence decided before playback; later changes need the usual evidence.
+  void Seed(Cadence cadence);
+
+private:
+  //! \param repeatPhase set to the cycle position of the repeats for REPEATED_FRAME
+  std::optional<Cadence> Classify(std::size_t& repeatPhase) const;
+  std::optional<Cadence> ClassifyProgressive(std::size_t& phase) const;
+
+  struct Entry
+  {
+    FrameObservation observation;
+    uint64_t index;
+  };
+  const std::size_t m_window;
+  std::deque<Entry> m_frames;
+  std::deque<Entry> m_differences; //!< last ten 6-frame cycles
+  uint64_t m_index = 0;
+  std::optional<Cadence> m_confirmed;
+  std::optional<Cadence> m_candidate;
+  std::size_t m_agree = 0;
+  std::size_t m_repeatPhase = 0; //!< cycle position of the repeated frames
+  std::size_t m_repeatRun = 0; //!< frames classified as repeats at that position in a row
+};
+
+/*!
+ * \brief Cadence of a whole title, decided before playback.
+ *
+ * The display mode is chosen once from this plan, before the first frame is shown.
+ */
+struct TitlePlan
+{
+  Cadence cadence = Cadence::PROGRESSIVE; //!< processing to start with
+  bool softTelecine = false; //!< progressive film frames with repeat flags (3:2 soft telecine)
+  double frameRate = 0; //!< coded frame rate of the stream
+};
+
+//! Refresh rate that shows every output frame of the plan for the same time
+double DisplayRate(const TitlePlan& plan);
+
+/*!
+ * \brief Decides the cadence of a title from frames decoded at several points of it.
+ *
+ * Each segment of contiguous frames votes for a cadence; a cadence needs more than half
+ * of the votes. Segments without motion do not vote. Repeated frames of 25 fps film are
+ * not exact copies on real discs, so they are found on all progressive segments
+ * together: the frame differences of such film have a period of six frames, which shows
+ * as power at 1/6 and 1/3 of the frame rate. The power is measured relative to the mean,
+ * independent of where the repeat is in the cycle, so edits do not hide it.
+ */
+class CTitleScan
+{
+public:
+  /*!
+   * \param frameRate coded frame rate of the stream
+   * \param canRemoveRepeats the processing can remove repeated frames of 25 fps film
+   */
+  CTitleScan(double frameRate, bool canRemoveRepeats);
+
+  //! the next frames do not follow the previous ones
+  void StartSegment();
+  void Add(const FrameObservation& observation);
+  //! \return the plan, empty if no cadence has a majority of the segments that vote
+  std::optional<TitlePlan> Decide();
+
+  //! segments that voted in the last decision
+  std::size_t Votes() const { return m_votes; }
+  //! significance of the repeated-frame pattern in the last decision (repeats from 3)
+  double RepeatScore() const { return m_repeatScore; }
+
+private:
+  enum class Vote
+  {
+    SOFT_TELECINE,
+    TELECINE,
+    FIELD_PAIRED,
+    INTERLACED,
+    PROGRESSIVE,
+    COUNT,
+  };
+  std::optional<Vote> Classify(const std::vector<FrameObservation>& frames) const;
+  double RepeatPattern() const;
+
+  const double m_frameRate;
+  const bool m_canRemoveRepeats;
+  std::vector<FrameObservation> m_segment;
+  std::array<std::size_t, static_cast<std::size_t>(Vote::COUNT)> m_counts{};
+  std::vector<std::vector<double>> m_progressive; //!< frame differences of progressive segments
+  std::size_t m_votes = 0;
+  double m_repeatScore = 0;
+};
+
+} // namespace FILM_CADENCE
