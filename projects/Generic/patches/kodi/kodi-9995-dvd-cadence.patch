@@ -0,0 +1,290 @@
+/*
+ *  Copyright (C) 2026 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "FilmCadence.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <functional>
+
+namespace FILM_CADENCE
+{
+
+bool IsFilm(Cadence cadence)
+{
+  return cadence == Cadence::TELECINE || cadence == Cadence::FIELD_PAIRED ||
+         cadence == Cadence::REPEATED_FRAME;
+}
+
+Cadence InterlacedCadence(std::optional<Cadence> cadence)
+{
+  if (cadence == Cadence::TELECINE || cadence == Cadence::FIELD_PAIRED)
+    return *cadence;
+  return Cadence::INTERLACED;
+}
+
+bool CanRepeatFrames(double framesPerSecond)
+{
+  return std::abs(framesPerSecond - 30000.0 / 1001.0) < 0.1 ||
+         std::abs(framesPerSecond - 30.0) < 0.1;
+}
+
+std::string FilterGraph(Cadence cadence)
+{
+  if (cadence == Cadence::INTERLACED)
+    return "bwdif=mode=send_field:parity=auto:deint=all";
+  if (cadence == Cadence::REPEATED_FRAME)
+    return "decimate=cycle=6"; // drop the most similar frame of every six
+  if (cadence == Cadence::PROGRESSIVE)
+    return "";
+
+  // fieldmatch rebuilds frames from matching fields and flags the frames it could not
+  // match; bwdif then interpolates only those orphan frames.
+  std::string graph = "fieldmatch=order=auto:combmatch=full,"
+                      "bwdif=mode=send_frame:parity=auto:deint=interlaced";
+  if (cadence == Cadence::TELECINE)
+    graph += ",decimate"; // drop the fifth frame, a duplicate after 3:2 field matching
+  return graph;
+}
+
+Cadence InverseTelecineCadence(double framesPerSecond)
+{
+  return std::abs(framesPerSecond - 30000.0 / 1001.0) < 0.1 ||
+                 std::abs(framesPerSecond - 30.0) < 0.1
+             ? Cadence::TELECINE
+             : Cadence::FIELD_PAIRED;
+}
+
+double FilmFrameDuration(Cadence cadence, double codedFrameDuration)
+{
+  switch (cadence)
+  {
+    case Cadence::TELECINE:
+      return codedFrameDuration * 5 / 4;
+    case Cadence::FIELD_PAIRED:
+      return codedFrameDuration;
+    case Cadence::REPEATED_FRAME:
+      return codedFrameDuration * 6 / 5;
+    case Cadence::INTERLACED:
+    case Cadence::PROGRESSIVE:
+      break;
+  }
+  return 0;
+}
+
+const char* Name(Cadence cadence)
+{
+  switch (cadence)
+  {
+    case Cadence::TELECINE:
+      return "inverse telecine";
+    case Cadence::FIELD_PAIRED:
+      return "field matching";
+    case Cadence::REPEATED_FRAME:
+      return "frame repeat removal";
+    case Cadence::PROGRESSIVE:
+      return "progressive";
+    case Cadence::INTERLACED:
+      break;
+  }
+  return "video deinterlacing";
+}
+
+std::string BufferSourceArgs(int width,
+                             int height,
+                             int pixelFormat,
+                             int aspectNum,
+                             int aspectDen,
+                             int rateNum,
+                             int rateDen)
+{
+  constexpr int timeBase = 1000000; // AV_TIME_BASE
+  if (aspectNum <= 0 || aspectDen <= 0)
+    aspectNum = aspectDen = 1;
+  if (rateNum <= 0 || rateDen <= 0)
+  {
+    rateNum = 30000;
+    rateDen = 1001;
+  }
+  return "video_size=" + std::to_string(width) + "x" + std::to_string(height) +
+         ":pix_fmt=" + std::to_string(pixelFormat) + ":time_base=1/" + std::to_string(timeBase) +
+         ":pixel_aspect=" + std::to_string(aspectNum) + "/" + std::to_string(aspectDen) +
+         ":frame_rate=" + std::to_string(rateNum) + "/" + std::to_string(rateDen);
+}
+
+FieldOrder ParseFieldOrder(const char* idetValue)
+{
+  if (!idetValue)
+    return FieldOrder::UNDETERMINED;
+  if (!std::strcmp(idetValue, "tff"))
+    return FieldOrder::TFF;
+  if (!std::strcmp(idetValue, "bff"))
+    return FieldOrder::BFF;
+  if (!std::strcmp(idetValue, "progressive"))
+    return FieldOrder::PROGRESSIVE;
+  return FieldOrder::UNDETERMINED;
+}
+
+CCadenceDetector::CCadenceDetector(std::size_t window)
+  : m_window(std::max<std::size_t>(window, 10))
+{
+}
+
+void CCadenceDetector::Reset()
+{
+  m_frames.clear();
+  m_differences.clear();
+  m_index = 0;
+  m_repeatPhase = 0;
+  m_repeatRun = 0;
+  m_confirmed.reset();
+  m_candidate.reset();
+  m_agree = 0;
+}
+
+std::optional<Cadence> CCadenceDetector::Classify(std::size_t& repeatPhase) const
+{
+  const std::size_t needed = m_confirmed ? m_window : m_window / 2;
+  if (m_frames.size() < needed)
+    return std::nullopt;
+
+  const double frames = static_cast<double>(m_frames.size());
+  std::size_t interlaced = 0;
+  std::size_t repeated = 0;
+  std::size_t progressive = 0;
+  std::size_t combed = 0;
+  std::array<std::size_t, 5> phase{};
+  for (const auto& [observation, index] : m_frames)
+  {
+    interlaced += observation.interlaced;
+    if (observation.repeatedField)
+    {
+      ++repeated;
+      ++phase[index % phase.size()];
+    }
+    progressive += observation.order == FieldOrder::PROGRESSIVE;
+    combed += observation.order == FieldOrder::TFF || observation.order == FieldOrder::BFF;
+  }
+  if (interlaced < frames / 2)
+    return ClassifyProgressive(repeatPhase);
+
+  // 3:2 pulldown repeats a top and a bottom field in every five frames, at the same two
+  // positions of the cycle while the cadence is unbroken.
+  if (repeated >= 0.3 * frames && repeated <= 0.5 * frames)
+  {
+    std::ranges::sort(phase, std::greater<>());
+    if (phase[0] + phase[1] >= 0.8 * repeated)
+      return Cadence::TELECINE;
+  }
+  if (repeated <= 0.1 * frames)
+  {
+    if (progressive >= 0.8 * frames)
+      return Cadence::FIELD_PAIRED;
+    if (combed >= 0.6 * frames)
+      return Cadence::INTERLACED;
+  }
+  return std::nullopt;
+}
+
+std::optional<Cadence> CCadenceDetector::ClassifyProgressive(std::size_t& phase) const
+{
+  constexpr std::size_t cycle = 6;
+  constexpr std::size_t cycles = 10;
+  // Below this mean difference (8-bit levels) a cycle is static and says nothing.
+  constexpr double motion = 0.2;
+  if (m_differences.size() < cycle * cycles)
+    return std::nullopt;
+
+  std::array<std::size_t, cycle> lowest{};
+  std::array<double, cycle> ratio{};
+  std::size_t moving = 0;
+  std::array<double, cycle> values{};
+  std::array<std::size_t, cycle> positions{};
+  std::size_t count = 0;
+  for (const auto& [observation, index] : m_differences)
+  {
+    if (count == 0 && index % cycle != 0)
+      continue; // start on a complete cycle
+    values[count] = observation.difference;
+    positions[count] = index % cycle;
+    if (++count < cycle)
+      continue;
+    count = 0;
+    if (std::ranges::any_of(values, [](double value) { return value < 0; }))
+      continue;
+    std::array<double, cycle> sorted = values;
+    std::ranges::sort(sorted);
+    const double median = (sorted[cycle / 2 - 1] + sorted[cycle / 2]) / 2;
+    if (median < motion)
+      continue;
+    const auto smallest = std::ranges::min_element(values) - values.begin();
+    ++moving;
+    ++lowest[positions[smallest]];
+    ratio[positions[smallest]] += values[smallest] / median;
+  }
+  if (moving < cycles * 6 / 10)
+    return std::nullopt; // mostly static: keep the current decision
+
+  const auto mode = std::ranges::max_element(lowest) - lowest.begin();
+  // 25 fps film repeats a frame at the same position of every cycle; the repeat is the
+  // smallest difference of its cycle, well below the others.
+  if (lowest[mode] * 10 >= moving * 6 && ratio[mode] / lowest[mode] <= 0.8)
+  {
+    phase = static_cast<std::size_t>(mode);
+    return Cadence::REPEATED_FRAME;
+  }
+  return Cadence::PROGRESSIVE;
+}
+
+bool CCadenceDetector::Add(const FrameObservation& observation)
+{
+  m_differences.push_back({observation, m_index});
+  while (m_differences.size() > 6 * 10)
+    m_differences.pop_front();
+  m_frames.push_back({observation, m_index++});
+  while (m_frames.size() > m_window)
+    m_frames.pop_front();
+
+  std::size_t phase = 0;
+  std::optional<Cadence> cadence = Classify(phase);
+  if (cadence == Cadence::REPEATED_FRAME)
+  {
+    m_repeatRun = phase == m_repeatPhase ? m_repeatRun + 1 : 1;
+    m_repeatPhase = phase;
+    // Animation and edited video also have duplicates, at changing positions.
+    if (m_confirmed != Cadence::REPEATED_FRAME && m_repeatRun < 3 * m_window)
+      cadence = m_confirmed ? m_confirmed : std::optional<Cadence>(Cadence::PROGRESSIVE);
+  }
+  else
+    m_repeatRun = 0;
+  if (!cadence || cadence == m_confirmed)
+  {
+    m_agree = 0;
+    return false;
+  }
+  if (cadence != m_candidate)
+  {
+    m_candidate = cadence;
+    m_agree = 0;
+  }
+  // Repeats of real film are not exact and edits move them in the cycle, so a film can
+  // look like plain progressive video for several seconds. Each change switches the
+  // display mode: leaving repeat removal needs twenty windows (20 s).
+  const std::size_t needed =
+      m_confirmed == Cadence::REPEATED_FRAME && cadence == Cadence::PROGRESSIVE ? 20 * m_window
+                                                                              : m_window;
+  if (m_confirmed && ++m_agree < needed)
+    return false;
+  m_confirmed = cadence;
+  m_agree = 0;
+  return true;
+}
+
+} // namespace FILM_CADENCE
