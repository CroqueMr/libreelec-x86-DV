+Cadence InverseTelecineCadence(double framesPerSecond);
+
+//! The cadence to use for interlaced frames: progressive cadences deinterlace as video
+Cadence InterlacedCadence(std::optional<Cadence> cadence);
+
+//! true if the stream frame rate can carry repeated frames of 25 fps film (29.97 or 30)
+bool CanRepeatFrames(double framesPerSecond);
+
+/*!
+ * \brief Duration of an output frame of the filter graph
+ * \param codedFrameDuration duration of a coded frame of the stream
+ */
+double FilmFrameDuration(Cadence cadence, double codedFrameDuration);
+
+const char* Name(Cadence cadence);
+
+/*!
+ * \brief Arguments of the libavfilter "buffer" source of a cadence graph.
+ *
+ * Decoded timestamps are in AV_TIME_BASE units, and decimate needs the real frame rate
+ * of the stream to time its output.
+ */
+std::string BufferSourceArgs(int width,
+                             int height,
+                             int pixelFormat,
+                             int aspectNum,
+                             int aspectDen,
+                             int rateNum,
+                             int rateDen);
+
+//! Field order of a frame, as classified by the FFmpeg idet filter ("multiple" detection)
+enum class FieldOrder
+{
+  UNDETERMINED,
+  TFF,
+  BFF,
+  PROGRESSIVE,
+};
+
+FieldOrder ParseFieldOrder(const char* idetValue);
+
+struct FrameObservation
+{
+  bool interlaced = false; //!< frame is flagged interlaced by the decoder
+  FieldOrder order = FieldOrder::UNDETERMINED;
+  bool repeatedField = false; //!< idet found a field repeated from the previous frame
+  double difference = -1; //!< mean absolute difference from the previous frame, -1 if unknown
+};
+
+/*!
+ * \brief Classifies the cadence of decoded video from per-frame field analysis.
+ *
+ * Interlaced frames are classified on the window. Progressive frames are classified on
+ * the frame differences of the last ten 6-frame cycles: repeated frames of 25 fps film
+ * are the smallest difference of their cycle, at the same position in most cycles.
+ * Repeat removal starts only when that position holds for three windows, and any moving
+ * window without the pattern counts towards leaving it.
+ *
+ * The first decision is made on half a window. A later change needs a full window of
+ * agreement, so that a short scene does not toggle the processing.
+ */
+class CCadenceDetector
+{
+public:
+  explicit CCadenceDetector(std::size_t window = 30);
+
+  //! \return true when the confirmed cadence changed
+  bool Add(const FrameObservation& observation);
+  std::optional<Cadence> Confirmed() const { return m_confirmed; }
+  void Reset();
+
+private:
+  //! \param repeatPhase set to the cycle position of the repeats for REPEATED_FRAME
+  std::optional<Cadence> Classify(std::size_t& repeatPhase) const;
+  std::optional<Cadence> ClassifyProgressive(std::size_t& phase) const;
+
+  struct Entry
+  {
+    FrameObservation observation;
+    uint64_t index;
+  };
+  const std::size_t m_window;
+  std::deque<Entry> m_frames;
+  std::deque<Entry> m_differences; //!< last ten 6-frame cycles
+  uint64_t m_index = 0;
+  std::optional<Cadence> m_confirmed;
+  std::optional<Cadence> m_candidate;
+  std::size_t m_agree = 0;
+  std::size_t m_repeatPhase = 0; //!< cycle position of the repeated frames
+  std::size_t m_repeatRun = 0; //!< frames classified as repeats at that position in a row
+};
+
+} // namespace FILM_CADENCE
