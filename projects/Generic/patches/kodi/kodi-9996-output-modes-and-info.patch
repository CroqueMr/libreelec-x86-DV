+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "GUIInfoLabels.h"
+#include "cores/VideoProcessingInfo.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h"
+#include "ServiceBroker.h"
