diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackNotification.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackNotification.h
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackNotification.h
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#ifdef HAVE_DVBRIDGE
+#include "DVOutputSettings.h"
+#include "DVPlaybackInfo.h"
+#include "DVMetadataBuffer.h"
+#include <atomic>
+#include <mutex>
+#include <string>
+
+namespace DVBRIDGE
+{
+// File lifecycle arms once. Only accepted presentation consumes the message.
+class PlaybackNotification
+{
+public:
+  static bool Pending() { return m_pending.load(std::memory_order_relaxed); }
+  static uint64_t Generation() { return Pending() ? m_generation.load(std::memory_order_relaxed) : 0; }
+  static void ArmMasterRecovery() { m_masterRecovery.store(true); }
+  static void StartVideo()
+  {
+    const auto component=CServiceBroker::GetSettingsComponent();
+    const auto settings=component ? component->GetSettings() : nullptr;
+    const bool enabled=settings && settings->GetBool("dvbridge.startupmode");
+    std::lock_guard lock(m_mutex);
+    m_generation.fetch_add(1,std::memory_order_relaxed);
+    m_masterRecovery.store(false);
+    m_nativeFloor=nativeRevision.load(std::memory_order_relaxed);
+    m_ordinaryFrame=false;
+    m_nativeFrame={};
+    m_pending.store(enabled,std::memory_order_relaxed);
+  }
+  static void StopVideo()
+  {
+    std::lock_guard lock(m_mutex);
+    m_ordinaryFrame=false;
+    m_nativeFrame={};
+    m_pending.store(false,std::memory_order_relaxed);
+    m_masterRecovery.store(false);
+  }
+  static void RenderedOrdinary(uint64_t generation)
+  {
+    if (!generation || !Pending()) return;
+    const auto preferences=FrameOutputSettings();
+    std::lock_guard lock(m_mutex);
+    if (!Pending() || generation!=m_generation.load(std::memory_order_relaxed)) return;
+    m_ordinaryMode=preferences.output==OutputMode::Disabled ? 0 : 1;
+    m_nativeFrame={};
+    m_ordinaryFrame=true;
+  }
+  static void RenderedNative(uint64_t generation,const SourceBinding& binding)
+  {
+    if (!Pending()) return;
+    std::lock_guard lock(m_mutex);
+    m_nativeFrame={};
+    m_ordinaryFrame=false;
+    if (generation && generation==m_generation.load(std::memory_order_relaxed) && binding.Valid())
+      m_nativeFrame=binding;
+  }
+  static void OrdinaryOutputAccepted(bool accepted)
+  {
+    if (!Pending()) return;
+    int mode{};
+    {
+      std::lock_guard lock(m_mutex);
+      const bool notify=accepted && m_ordinaryFrame && m_pending.exchange(false);
+      m_ordinaryFrame=false;
+      if (!notify) return;
+      mode=m_ordinaryMode;
+    }
+    Emit(mode==0 ? "Disabled / Kodi playback" : "Standard / Kodi playback");
+  }
+  template<class Output> static void NativeOutputAccepted(const Output& output)
+  {
+    if ((output.flags & CDVPlaybackInfo::HDMI) && output.requested==5 && output.effective==1 &&
+        m_masterRecovery.exchange(false))
+      EmitMasterRecovery();
+    if (!Pending()) return;
+    if (!(output.flags & (CDVPlaybackInfo::HDMI | CDVPlaybackInfo::HDR10))) return;
+    {
+      std::lock_guard lock(m_mutex);
+      if (!output.picture || output.stream<=m_nativeFloor) return;
+      if (output.stream!=m_nativeFrame.stream || output.picture!=m_nativeFrame.picture) return;
+      if (!m_pending.exchange(false)) return;
+      m_ordinaryFrame=false;
+      m_nativeFrame={};
+    }
+#ifdef CB1_HAS_HDR10_AI
+    if constexpr (requires { output.hdr10AI; })
+      if (output.hdr10AI)
+      {
+        EmitAI(output.effective);
+        return;
+      }
+#endif
+    Emit(CDVPlaybackInfo::Mode(output));
+  }
+  static void Emit(const std::string& text);
+  static void EmitAI(int mode);
+  static void HDR10Recovery();
+  static void EmitMasterRecovery();
+private:
+  inline static std::atomic<bool> m_masterRecovery{false};
+  inline static std::atomic<bool> m_pending{false};
+  inline static std::atomic<uint64_t> m_generation{0};
+  inline static std::mutex m_mutex;
+  inline static bool m_ordinaryFrame{};
+  inline static int m_ordinaryMode{};
+  inline static uint64_t m_nativeFloor{};
+  inline static SourceBinding m_nativeFrame{};
+};
+}
+#endif
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVProcessingInfo.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVProcessingInfo.h
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVProcessingInfo.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "cores/VideoProcessingInfo.h"
+
+namespace DVBRIDGE
+{
+// Convert already accepted adapter facts, without retaining RPU or renderer state.
+inline VideoProcessingInfo NativeProcessingInfo(const StreamSnapshot& source)
+{
+  VideoProcessingInfo info;
+  info.informationGeneration=source.informationGeneration;
+  const auto& output=source.output;
+  auto& accepted=info.output;
+  accepted.flags=output.flags; accepted.bits=output.bits; accepted.target=output.target;
+  accepted.level6=output.level6; accepted.requested=output.requested;
+  accepted.effective=output.effective; accepted.method=output.method;
+  accepted.panel=output.panel;
+  accepted.gamut=output.gamut; accepted.manualPeak=output.manualPeak;
+  accepted.revision=output.revision; accepted.stream=output.stream; accepted.picture=output.picture;
+  accepted.format=output.format; accepted.width=output.width; accepted.height=output.height;
+  accepted.refresh=output.refresh; accepted.fallback=output.fallback;
+  accepted.authoredLegacy=output.authoredLegacy;
+  accepted.reason=static_cast<VideoProcessingReason>(output.reason);
+  accepted.minimumLinkBits=output.minimumLinkBits;
+  accepted.creativeKnown=output.creativeKnown; accepted.creativeApplied=output.creativeApplied;
+  accepted.creativeEdited=output.creativeEdited; accepted.creativeStatus=output.creativeStatus;
+  accepted.creativeReason=output.creativeReason; accepted.fastChroma=output.fastChroma;
+  accepted.fastRenderingMode=output.fastRenderingMode;
+  accepted.felUpscaling=output.felUpscaling;
+#ifdef CB1_HAS_HDR10_AI
+  accepted.hdr10AI=output.hdr10AI; accepted.aiL1L3=output.aiL1L3;
+  accepted.emittedL1Known=output.emittedL1Known; accepted.emittedL1=output.emittedL1;
+  if (output.flags) { accepted.engine=cb1_engine_version(); accepted.circuit=output.Circuit(); }
+#endif
+  if (output.flags & CDVPlaybackInfo::HDMI) info.outputType=VideoOutputType::DolbyVision;
+  else if (output.flags & CDVPlaybackInfo::HDR10) info.outputType=VideoOutputType::HDR10;
+  info.profile=source.profile; info.level=source.level; info.major=source.major; info.minor=source.minor;
+  info.bl=source.bl; info.el=source.el; info.rpu=source.rpu; info.fel=source.fel;
+  info.sourceBits=source.sourceBits; info.sourceFormat=static_cast<int>(source.sourceFormat);
+  info.sourceMastering=source.sourceMastering; info.sourceLight=source.sourceLight;
+  info.sourceMax=source.sourceMax; info.sourceMin=source.sourceMin;
+  info.sourceCLL=source.sourceCLL; info.sourceFALL=source.sourceFALL;
+  info.dropped=source.dropped; info.skipped=source.skipped; info.counters=source.counters;
+  // Generated AI metadata describes output, never the encoded HDR10 source.
+  info.metadata=source.metadata && source.profile && !accepted.hdr10AI;
+  info.transmittedBlocks=source.TransmittedBlocks();
+  if (info.metadata)
+  {
+    info.cm4=source.cm4; info.l1=source.l1; info.l5=source.l5; info.l6=source.l6;
+    info.pq=source.pq; info.area=source.area; info.maxMaster=source.maxMaster;
+    info.minMaster=source.minMaster; info.maxCLL=source.maxCLL; info.maxFALL=source.maxFALL;
+    info.framebufferBits=source.framebufferBits; info.blocks=source.blocks;
+    info.appliedBlocks=source.AppliedBlocks();
+  }
+  const auto& pending=source.transaction;
+  info.transaction.identity={pending.identity.stream,pending.identity.picture,pending.identity.revision};
+  info.transaction.requested=pending.requested; info.transaction.effective=pending.effective;
+  info.transaction.atomicError=pending.atomicError;
+  info.transaction.reason=static_cast<VideoProcessingReason>(pending.reason);
+  info.transaction.retryCount=pending.retryCount; info.transaction.restored=pending.restored;
+  info.transaction.stage=pending.stage;
+  info.transaction.hdr10AI=pending.capabilities.isHDR10 && !pending.capabilities.isDV;
+  info.referenceWarning=source.referenceWarning;
+  return info;
+}
+}
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h
@@ -0,0 +1,411 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "DVPlaybackInfo.h"
+#include "DVMetadataBuffer.h"
+#include "ServiceBroker.h"
+#include "cores/DataCacheCore.h"
+#ifdef CB1_HAS_HDR10_AI
+#include "cb1_circuit.h"
+#endif
+
+#include <array>
+#include <bitset>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+#include <tuple>
+
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+#include <libavutil/mastering_display_metadata.h>
+#include <libavutil/pixfmt.h>
+}
+
+namespace DVBRIDGE
+{
+struct StreamSnapshot
+{
+  uint64_t informationGeneration{};
+  struct Transaction
+  {
+    SourceBinding identity{};
+    int requested{},effective{};
+    const char* stage{""};
+    OutputCapabilities capabilities{};
+    OutputReason reason{OutputReason::None};
+    int atomicError{};
+    unsigned retryCount{};
+    bool restored{};
+  } transaction;
+  bool referenceWarning{};
+  // Committed output is independent of sampled source metadata and counters.
+  struct Output
+  {
+    unsigned flags{}, bits{};
+    float target{};
+    bool level6{};
+    int requested{}, effective{1}, method{}, panel{}, gamut{};
+    double manualPeak{};
+    uint64_t revision{};
+    bool fallback{};
+    uint64_t stream{}, picture{};
+    uint32_t format{};
+    unsigned width{}, height{};
+    float refresh{};
+    bool authoredLegacy{};
+    std::array<double,3> rawStatistics{};
+    float rawSum{};
+    uint32_t sampleCount{};
+    OutputReason reason{OutputReason::None};
+    unsigned minimumLinkBits{};
+    bool creativeKnown{};
+    uint32_t creativeApplied{}, creativeEdited{};
+    int creativeStatus{}, creativeReason{};
+    bool fastChroma{};
+    int fastRenderingMode{};
+    int felUpscaling{-1};
+#ifdef CB1_HAS_HDR10_AI
+    bool hdr10AI{};
+    std::array<unsigned,6> aiL1L3{};
+    bool emittedL1Known{};
+    std::array<unsigned,3> emittedL1{};
+    const char* Circuit() const
+    {
+      if (!flags) return "";
+      if (hdr10AI)
+      {
+        if (effective==1) return cb1_circuit_version(CB1_HDR10_DV_REFERENCE);
+        if (effective==4) return cb1_circuit_version(CB1_HDR10_DV_ADAPTIVE);
+      }
+      else
+      {
+        if (effective==1) return cb1_circuit_version(CB1_DV_DV_REFERENCE);
+        if (effective==2) return cb1_circuit_version(CB1_DV_HDR10_BASIC);
+        if (effective==3) return cb1_circuit_version(CB1_DV_HDR10_EXPERT);
+        if (effective==4) return cb1_circuit_version(CB1_DV_DV_ADAPTIVE);
+        if (effective==5) return cb1_circuit_version(CB1_DV_DV_MASTER_REFERENCE);
+        if (effective==6) return cb1_circuit_version(CB1_DV_DV_ADAPTIVE_B);
+      }
+      return "";
+    }
+#endif
+  } output;
+  unsigned profile{}, level{}, major{}, minor{};
+  bool bl{}, el{}, rpu{}, metadata{}, cm4{}, fel{};
+  bool l1{}, l5{}, l6{};
+  std::array<unsigned, 3> pq{};
+  std::array<unsigned, 4> area{};
+  unsigned maxMaster{}, minMaster{}, maxCLL{}, maxFALL{};
+  unsigned framebufferBits{}, sourceBits{};
+  AVPixelFormat sourceFormat{AV_PIX_FMT_NONE};
+  int dropped{}, skipped{};
+  bool counters{};
+  bool sourceMastering{}, sourceLight{};
+  double sourceMax{}, sourceMin{};
+  unsigned sourceCLL{}, sourceFALL{};
+  std::bitset<256> blocks;
+
+  std::bitset<256> AppliedBlocks() const
+  {
+    std::bitset<256> result;
+    if (!output.flags || !metadata) return result;
+    result[5]=blocks[5]; // Active-picture geometry, not a creative trim.
+    for(unsigned level=0;level<32;++level)
+      if (output.creativeApplied & (1u<<level)) result[level]=blocks[level];
+    if (output.flags & CDVPlaybackInfo::HDR10 || output.authoredLegacy)
+    {
+      result[1]=blocks[1] && pq[0]<=pq[2] && pq[2]<=pq[1] && pq[1]>0 && pq[1]<=4095;
+      result[6]=blocks[6] && (output.effective>=3 || output.level6);
+    }
+    return result;
+  }
+  std::bitset<256> TransmittedBlocks() const
+  {
+    std::bitset<256> result;
+    if (!(output.flags & CDVPlaybackInfo::HDMI) || !metadata) return result;
+    if (output.authoredLegacy) { result[1]=result[5]=true; return result; }
+    result=blocks;
+    result[6]=false; // L6 is static HDR metadata, not dynamic DV wire data.
+    result[5]=true; // Native serializer always supplies final-raster margins.
+    return result;
+  }
+};
+
+class StreamTelemetry
+{
+public:
+  static void PublishNativeInfo(uint64_t generation);
+  static void PublishNativePending(uint64_t generation);
+
+  // The adapter session fixes target/precision. Only flag transitions publish.
+  static bool Presented(unsigned flags, unsigned bits, float target, bool level6)
+  {
+    if (CDVPlaybackInfo::presented.load() == flags)
+      return false;
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_snapshot.output = {flags, bits, target, level6};
+    CDVPlaybackInfo::presented.store(flags);
+    return true;
+  }
+
+  static void ClearOutput()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_snapshot.output = {};
+    m_snapshot.transaction = {};
+    m_snapshot.referenceWarning=false;
+    m_nativeActive = false;
+    CDVPlaybackInfo::presented.store(0);
+  }
+
+  static void SourceBits(unsigned bits, AVPixelFormat format, const SourceInfo& source)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (source.informationGeneration!=m_decodedSource.informationGeneration ||
+        (m_nativeActive && source.informationGeneration!=m_nativeSource.informationGeneration))
+    {
+      m_nativeActive=false;
+      m_snapshot={};
+    }
+    m_decodedSource=source;
+    m_decodedSource.bits=bits;
+    m_decodedSource.format=static_cast<int>(format);
+  }
+
+  static void Counters(int dropped, int skipped)
+  {
+    m_dropped.store(dropped, std::memory_order_relaxed);
+    m_skipped.store(skipped, std::memory_order_relaxed);
+    m_counters.store(true, std::memory_order_relaxed);
+  }
+
+  static void StaticMetadata(const AVMasteringDisplayMetadata* mastering,
+                             const AVContentLightMetadata* light)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (mastering && mastering->has_luminance &&
+        mastering->max_luminance.den > 0 && mastering->min_luminance.den > 0)
+    {
+      m_snapshot.sourceMastering = true;
+      m_snapshot.sourceMax = av_q2d(mastering->max_luminance);
+      m_snapshot.sourceMin = av_q2d(mastering->min_luminance);
+    }
+    if (light)
+    {
+      m_snapshot.sourceLight = true;
+      m_snapshot.sourceCLL = light->MaxCLL;
+      m_snapshot.sourceFALL = light->MaxFALL;
+    }
+  }
+
+  static void Begin(unsigned profile, unsigned level, unsigned major, unsigned minor,
+                    bool bl, bool el, bool rpu)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto output = m_snapshot.output;
+    m_snapshot = {};
+    m_snapshot.output = output;
+    m_counters.store(false, std::memory_order_relaxed);
+    m_snapshot.profile = profile;
+    m_snapshot.level = level;
+    m_snapshot.major = major;
+    m_snapshot.minor = minor;
+    m_snapshot.bl = bl;
+    m_snapshot.el = el;
+    m_snapshot.rpu = rpu;
+    m_next = {};
+  }
+
+  // Called on the renderer thread only, after its metadata bounds validation.
+  static void Metadata(const AVDOVIMetadata* data, bool fel, unsigned bits)
+  {
+    const auto now = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (now < m_next)
+      return;
+    m_next = now + std::chrono::milliseconds(500);
+    StoreMetadata(m_snapshot,data,fel,bits);
+  }
+
+  static void NativePresented(const SourceInfo& source,const CDVMetadataBuffer& metadata,
+                              const StreamSnapshot::Output& output)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_nativeActive = true;
+    m_nativeSource = source;
+    const auto now=std::chrono::steady_clock::now();
+    if (metadata.Data() && (!m_snapshot.metadata || output.stream!=m_snapshot.output.stream ||
+        output.revision!=m_snapshot.output.revision || now>=m_next))
+    {
+      StoreMetadata(m_snapshot,reinterpret_cast<const AVDOVIMetadata*>(metadata.Data()),
+          (output.flags & CDVPlaybackInfo::FEL)!=0,output.bits);
+      m_next=now+std::chrono::milliseconds(500);
+    }
+    if (!metadata.Data()) { m_snapshot.metadata=false; m_snapshot.blocks.reset(); }
+    m_snapshot.output = output;
+    if (m_snapshot.transaction.identity==SourceBinding{output.stream,output.picture,output.revision})
+    {
+      m_snapshot.output.reason=m_snapshot.transaction.reason;
+      m_snapshot.output.requested=m_snapshot.transaction.requested;
+      m_snapshot.output.minimumLinkBits=(output.flags & CDVPlaybackInfo::HDR10) ? 10 : 0;
+    }
+    m_snapshot.referenceWarning=false;
+    if (m_snapshot.transaction.identity==SourceBinding{output.stream,output.picture,output.revision})
+      m_snapshot.transaction.stage="Committed";
+    CDVPlaybackInfo::presented.store(output.flags);
+  }
+
+  static void NativeRequest(SourceBinding identity,int requested,int effective,
+                            SourceBinding admissionIdentity = {})
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_snapshot.transaction.identity!=identity &&
+        (!admissionIdentity.Valid() || m_snapshot.transaction.identity!=admissionIdentity))
+      m_snapshot.transaction={};
+    auto& transaction=m_snapshot.transaction;
+    transaction.identity=identity; transaction.requested=requested;
+    transaction.effective=effective; transaction.stage="Requested";
+  }
+  static void NativeSelection(SourceBinding identity,const OutputCapabilities& capabilities,
+                              int requested,int effective,OutputReason reason)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_snapshot.transaction.identity!=identity)
+    {
+      m_snapshot.transaction={};
+      m_snapshot.transaction.stage="Admission checked";
+    }
+    auto& transaction=m_snapshot.transaction;
+    transaction.identity=identity; transaction.capabilities=capabilities;
+    transaction.requested=requested; transaction.effective=effective;
+    transaction.reason=reason;
+  }
+  static void NativeFailure(OutputReason reason,int error,unsigned retries,bool restored)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto& transaction=m_snapshot.transaction;
+    transaction.reason=reason; transaction.atomicError=error;
+    transaction.retryCount=retries; transaction.restored=restored;
+    transaction.stage=restored ? "Activation failed" : "Restoration failed";
+  }
+  static void NativeStage(SourceBinding identity,const char* stage)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_snapshot.transaction.identity==identity) m_snapshot.transaction.stage=stage;
+  }
+  static void ReferenceWarning()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_snapshot.referenceWarning=true;
+  }
+
+  static void NativeFormat(SourceBinding identity,uint32_t format,unsigned width,
+                           unsigned height,float refresh)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto& output=m_snapshot.output;
+    if (!m_nativeActive || identity.stream!=output.stream || identity.picture!=output.picture ||
+        identity.revision!=output.revision) return;
+    output.format=format; output.width=width; output.height=height; output.refresh=refresh;
+  }
+
+private:
+  static void StoreMetadata(StreamSnapshot& out,const AVDOVIMetadata* data,bool fel,unsigned bits)
+  {
+    out.metadata = true;
+    out.fel = fel;
+    out.framebufferBits = bits;
+    out.l1 = out.l5 = out.l6 = out.cm4 = false;
+    out.blocks.reset();
+    for (int i = 0; i < data->num_ext_blocks; ++i)
+    {
+      const auto* ext = av_dovi_get_ext(data, i);
+      out.blocks.set(ext->level);
+      switch (ext->level)
+      {
+        case 1:
+          out.l1 = true;
+          out.pq = {ext->l1.min_pq, ext->l1.max_pq, ext->l1.avg_pq};
+          break;
+        case 5:
+          out.l5 = true;
+          out.area = {ext->l5.left_offset, ext->l5.right_offset,
+                      ext->l5.top_offset, ext->l5.bottom_offset};
+          break;
+        case 6:
+          out.l6 = true;
+          out.maxMaster = ext->l6.max_luminance;
+          out.minMaster = ext->l6.min_luminance;
+          out.maxCLL = ext->l6.max_cll;
+          out.maxFALL = ext->l6.max_fall;
+          break;
+        case 3: case 8: case 9: case 10: case 11: case 254:
+          out.cm4 = true;
+          break;
+      }
+    }
+  }
+
+public:
+  static StreamSnapshot Read()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto result = m_snapshot;
+    result.counters = m_counters.load(std::memory_order_relaxed);
+    result.dropped = m_dropped.load(std::memory_order_relaxed);
+    result.skipped = m_skipped.load(std::memory_order_relaxed);
+    {
+      const auto& source = m_nativeActive ? m_nativeSource : m_decodedSource;
+      result.informationGeneration=source.informationGeneration;
+      result.profile = source.profile; result.level = source.level;
+      result.major = source.major; result.minor = source.minor;
+      result.bl = source.bl; result.el = source.el; result.rpu = source.rpu;
+      result.sourceBits = source.bits; result.sourceFormat = static_cast<AVPixelFormat>(source.format);
+      result.sourceMastering = source.mastering; result.sourceLight = source.light;
+      result.sourceMax = source.maxLuma; result.sourceMin = source.minLuma;
+      result.sourceCLL = source.maxCLL; result.sourceFALL = source.maxFALL;
+    }
+    return result;
+  }
+
+private:
+  inline static std::atomic<int> m_dropped{}, m_skipped{};
+  inline static std::atomic<bool> m_counters{false};
+  inline static std::mutex m_mutex;
+  inline static StreamSnapshot m_snapshot;
+  inline static SourceInfo m_nativeSource;
+  inline static SourceInfo m_decodedSource;
+  inline static bool m_nativeActive{};
+  inline static std::chrono::steady_clock::time_point m_next;
+};
+} // namespace DVBRIDGE
+
+#include "DVProcessingInfo.h"
+inline void DVBRIDGE::StreamTelemetry::PublishNativeInfo(uint64_t generation)
+{
+  // Bounded summaries refresh at 2 Hz; accepted mode/format changes publish immediately.
+  using Key=std::tuple<uint64_t,uint64_t,uint64_t,unsigned,int,uint32_t,bool,bool,int>;
+  static Key previous{};
+  static std::chrono::steady_clock::time_point next;
+  const auto source=Read();
+  const auto& output=source.output;
+  const Key key{generation,output.stream,output.revision,output.flags,output.effective,
+      output.format,output.fastChroma,output.fallback,int(output.reason)};
+  const auto now=std::chrono::steady_clock::now();
+  if (now<next && key==previous) return;
+  if (CServiceBroker::GetDataCacheCore().SetVideoProcessingInfo(generation,NativeProcessingInfo(source)))
+  {
+    previous=key;
+    next=now+std::chrono::milliseconds(500);
+  }
+}
+
+inline void DVBRIDGE::StreamTelemetry::PublishNativePending(uint64_t generation)
+{
+  auto& cache=CServiceBroker::GetDataCacheCore();
+  auto info=cache.GetVideoProcessingInfo();
+  info.transaction=NativeProcessingInfo(Read()).transaction;
+  cache.SetVideoProcessingInfo(generation,info);
+}
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/HDR10AIActivation.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/HDR10AIActivation.h
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/HDR10AIActivation.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "cb1_l1l3_model.h"
+#include <cmath>
+#include <cstdint>
+
+namespace DVBRIDGE
+{
+class HDR10AIActivation
+{
+public:
+  enum class Decision { Wait, Ignore, Native, Prepare };
+
+  void Begin(uint64_t stream, uint64_t revision, uint64_t now)
+  {
+    m_stream = stream;
+    m_revision = revision;
+    m_waitSince = now;
+    m_spent = 0;
+    m_deadline = 0;
+    m_waitScheduled = false;
+    m_active = stream && revision;
+    m_waiting = m_active;
+    m_native = m_event = m_prepared = false;
+    m_paused = false;
+  }
+  void SetPaused(bool paused, uint64_t now)
+  {
+    if (paused == m_paused) return;
+    if (paused) m_pauseSince = now;
+    else if (m_waiting && now >= m_pauseSince) m_waitSince += now - m_pauseSince;
+    m_paused = paused;
+  }
+
+  void SetPresentationDeadline(uint64_t deadline) { m_deadline = deadline; }
+
+  Decision Observe(cb1_ai_status status, cb1_ai_identity id, uint64_t now, bool required = true)
+  {
+    if (!Matches(id))
+      return Decision::Ignore;
+    if (m_native)
+      return Decision::Native;
+    if (status == CB1_AI_INCOMPATIBLE)
+      return Fallback();
+    if (m_paused && now >= m_pauseSince) now = m_pauseSince;
+    if (m_waiting)
+    {
+      if (now < m_waitSince && !m_waitScheduled)
+        return Fallback();
+      const uint64_t elapsed = now >= m_waitSince ? now - m_waitSince : 0;
+      if (elapsed > 1000 - m_spent ||
+          (now >= m_waitSince && elapsed == 1000 - m_spent && status != CB1_AI_READY))
+        return Fallback();
+      m_spent += elapsed;
+      if (now >= m_waitSince)
+      {
+        m_waitSince = now;
+        m_waitScheduled = false;
+      }
+    }
+    if (status == CB1_AI_READY)
+    {
+      m_waiting = false;
+      m_prepared = true;
+      m_identity = id;
+      return Decision::Prepare;
+    }
+    if (!m_waiting)
+    {
+      if (!required)
+        return Decision::Wait;
+      if (m_spent == 1000 && now >= m_deadline)
+        return Fallback();
+      m_waiting = true;
+      m_waitScheduled = now < m_deadline;
+      m_waitSince = m_waitScheduled ? m_deadline : now;
+    }
+    return Decision::Wait;
+  }
+
+  bool Presented(cb1_ai_identity id, bool success)
+  {
+    if (!Matches(id) || m_native || !m_prepared || id.picture != m_identity.picture)
+      return false;
+    m_prepared = false;
+    if (!success)
+      Fallback();
+    return success;
+  }
+
+  Decision CancelPrepared(cb1_ai_identity id, uint64_t now)
+  {
+    if (!Matches(id) || !m_prepared || id.picture != m_identity.picture)
+      return Decision::Ignore;
+    // Settle real waiting before retiring its owner; never refund the budget.
+    if (m_waiting && Observe(CB1_AI_PENDING, id, now) == Decision::Native)
+      return Decision::Native;
+    m_prepared = m_waiting = m_waitScheduled = false;
+    return Decision::Wait;
+  }
+
+  bool TakeFallbackEvent()
+  {
+    const bool event = m_event;
+    m_event = false;
+    return event;
+  }
+
+  void Stop() { m_active = m_prepared = m_waiting = false; }
+
+  static unsigned BufferCount(double fps)
+  {
+    return std::isfinite(fps) && fps > 0 && fps <= 60 ?
+        static_cast<unsigned>(std::ceil(fps)) + 3 : 0;
+  }
+
+private:
+  bool Matches(cb1_ai_identity id) const
+  {
+    return m_active && id.stream == m_stream && id.revision == m_revision && id.picture;
+  }
+  Decision Fallback()
+  {
+    m_native = m_event = true;
+    m_prepared = m_waiting = false;
+    return Decision::Native;
+  }
+
+  uint64_t m_stream{}, m_revision{}, m_waitSince{}, m_spent{}, m_pauseSince{}, m_deadline{};
+  cb1_ai_identity m_identity{};
+  bool m_active{}, m_waiting{}, m_native{}, m_event{}, m_prepared{}, m_paused{}, m_waitScheduled{};
+};
+}
