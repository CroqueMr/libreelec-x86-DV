+  if (fb->format == DRM_FORMAT_XRGB8888 || fb->format == DRM_FORMAT_XRGB2101010 ||
+      fb->format == DRM_FORMAT_XBGR2101010 || fb->format == DRM_FORMAT_ABGR16161616F)
