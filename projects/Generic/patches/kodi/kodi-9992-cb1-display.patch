+  const char* reason = "no-source-metadata";
+  if (metadata)
+  {
+    const auto* display = GetDisplayInfo();
+    if (GetEotf() != KODI::UTILS::Eotf::PQ)
+      reason = "output-not-pq";
+    else if (GetOutputBitDepth() < 10)
+      reason = "output-buffer-below-10-bit";
+    else if (!drm->GetConnector() || !drm->GetConnector()->SupportsProperty("HDR10PLUS_METADATA"))
+      reason = "driver-unsupported";
+    else if (!display || display->HDR10PlusVersion() < metadata->application_version)
+      reason = "display-unsupported";
+    else
+    {
+      std::array<uint8_t, CB1_HDR10PLUS_VSIF_BYTES> bytes{};
+      const auto status = cb1_hdr10plus_vsif(bytes.data(), metadata, overlay, true);
+      reason = status == CB1_HDR10PLUS_OK ? "staged" :
+          status == CB1_HDR10PLUS_INVALID ? "invalid-metadata" : "unrepresentable-metadata";
+      if (status == CB1_HDR10PLUS_OK) packet = bytes;
+    }
+  }
+  drm->StageHDR10Plus(std::move(packet), generation);
+  if (m_hdr10plusReason != reason)
+  {
+    if (!metadata || DVBRIDGE::DiagnosticLog(LOGINFO,
+        "HDR10+ output: {} app_version={} country={:#x} windows={} target={}/{} actual_peak={} mastering_peak={} saturation={} tone_mapping={} anchors={} percentiles={} slot5={}/{} slot10={}/{} generation={}",
+        reason,metadata->application_version,metadata->itu_t_t35_country_code,metadata->num_windows,
+        metadata->targeted_system_display_maximum_luminance.num,metadata->targeted_system_display_maximum_luminance.den,
+        metadata->targeted_system_display_actual_peak_luminance_flag,metadata->mastering_display_actual_peak_luminance_flag,
+        metadata->params[0].color_saturation_mapping_flag,metadata->params[0].tone_mapping_flag,
+        metadata->params[0].num_bezier_curve_anchors,metadata->params[0].num_distribution_maxrgb_percentiles,
+        metadata->params[0].distribution_maxrgb[1].percentile.num,metadata->params[0].distribution_maxrgb[1].percentile.den,
+        metadata->params[0].distribution_maxrgb[2].percentile.num,metadata->params[0].distribution_maxrgb[2].percentile.den,generation))
+    {
+      m_hdr10plusReason = reason;
+      if (metadata && (m_hdr10plusReason == "invalid-metadata" ||
+                       m_hdr10plusReason == "unrepresentable-metadata"))
+      {
+        const auto& p = metadata->params[0];
+        const auto rational = [](AVRational v) {
+          return std::to_string(v.num) + "/" + std::to_string(v.den);
+        };
+        std::string distribution, anchors;
+        for (size_t i = 0; i < std::min<size_t>(p.num_distribution_maxrgb_percentiles,
+                                               std::size(p.distribution_maxrgb)); ++i)
+          distribution += (i ? "," : "") + std::to_string(p.distribution_maxrgb[i].percentage) +
+              ":" + rational(p.distribution_maxrgb[i].percentile);
+        for (size_t i = 0; i < std::min<size_t>(p.num_bezier_curve_anchors,
+                                               std::size(p.bezier_curve_anchors)); ++i)
+          anchors += (i ? "," : "") + rational(p.bezier_curve_anchors[i]);
+        DVBRIDGE::DiagnosticLog(LOGINFO,
+            "HDR10+ statistics: distribution=[{}] maxscl=[{},{},{}] average={} bright={}",
+            distribution, rational(p.maxscl[0]), rational(p.maxscl[1]), rational(p.maxscl[2]),
