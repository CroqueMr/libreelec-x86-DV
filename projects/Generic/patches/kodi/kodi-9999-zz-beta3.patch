+  {
+    std::erase_if(modifiers, [](uint64_t mod) {
+      return IS_AMD_FMT_MOD(mod) && AMD_FMT_MOD_GET(DCC, mod);
+    });
+    if (modifiers.empty()) modifiers.push_back(DRM_FORMAT_MOD_LINEAR);
+  }
+#endif
+  return modifiers;
+}
