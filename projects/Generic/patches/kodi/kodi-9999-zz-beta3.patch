+    if (m_enabled) return false;
+    if (!m_startNs && nowNs) m_startNs = nowNs;
+    if (!eligible || !nowNs || nowNs <= m_lastNs)
+    {
+      m_warmFrames = 0;
+      m_alertNs = 0;
+      m_lastNs = nowNs;
+      return false;
+    }
+    m_lastNs = nowNs;
