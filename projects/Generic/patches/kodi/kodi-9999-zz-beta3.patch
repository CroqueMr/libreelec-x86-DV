+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include "DVOutputSettings.h"
+#include "DVPlaybackInfo.h"
+#ifdef HAVE_DVBRIDGE
+#include <array>
+
+namespace DVBRIDGE
+{
+enum class OutputRoute { Vanilla, NativeDV, HDR10 };
+struct OutputSelection
+{
+  OutputRoute route{OutputRoute::Vanilla};
+  dvbridge_policy policy{};
+  OutputReason reason{OutputReason::None};
+};
+
+inline OutputSelection SelectOutput(const OutputPreferences& preferences,
+                                    const OutputCapabilities& caps)
+{
+  OutputSelection result;
+  if (caps.stereoSource)
+    return {OutputRoute::Vanilla, {}, OutputReason::SourceIneligible};
+  if (caps.sourceKnown && caps.isHDR10 && !caps.isDV)
+  {
+    if (preferences.hdr10Source == HDR10SourceMode::Native) return result;
+    auto policy = preferences.HDR10Policy();
+    if (policy.mode == DVBRIDGE_MODE_DISABLED)
+      return {OutputRoute::Vanilla,{},OutputReason::SourceIneligible};
+    if (policy.mode != DVBRIDGE_MODE_STANDARD && !preferences.ProfileValid())
+      return {OutputRoute::Vanilla,{},OutputReason::TVProfileRequired};
+    if (!caps.nativeDV)
+      return {OutputRoute::Vanilla,{},OutputReason::NoDVTransport};
+    if (!caps.processingKnown || !caps.processing[policy.mode].usable)
+      return {OutputRoute::Vanilla,{},OutputReason::NoGPUProcessing};
+    return {OutputRoute::NativeDV,policy,OutputReason::None};
+  }
+  if (!caps.sourceKnown || !caps.isDV || preferences.output == OutputMode::Disabled)
+    return result;
+  if (!caps.processingKnown)
+  {
+    result.reason = OutputReason::NoGPUProcessing;
+    return result;
+  }
+  auto policy = preferences.Policy();
+  if (policy.mode == DVBRIDGE_MODE_HDR10PLUS && !caps.hdr10plus)
+  {
+    if (!caps.hdr10 || !caps.processing[DVBRIDGE_MODE_HDR10_BASIC].usable)
+      return {OutputRoute::Vanilla, {}, OutputReason::NoHDR10PlusTransport};
+    policy.mode = DVBRIDGE_MODE_HDR10_BASIC;
+    return {OutputRoute::HDR10, policy, OutputReason::NoHDR10PlusTransport};
+  }
+  const auto admission = [&](dvbridge_mode mode) {
+    if ((mode == DVBRIDGE_MODE_HDR10_EXPERT || mode == DVBRIDGE_MODE_ENHANCED_DV) &&
+        !preferences.ProfileValid())
+      return ModeAdmission{false, OutputReason::TVProfileRequired};
+    auto value = caps.processing[mode];
+    if (!value.usable && value.reason == OutputReason::None)
+      value.reason = OutputReason::NoGPUProcessing;
+    return value;
+  };
+  const bool requestedDV = preferences.output != OutputMode::HDR10;
+  auto candidate = admission(policy.mode);
+  if ((requestedDV ? caps.nativeDV : caps.hdr10) && candidate.usable)
+    return {requestedDV ? OutputRoute::NativeDV : OutputRoute::HDR10, policy, OutputReason::None};
+  result.reason = !(requestedDV ? caps.nativeDV : caps.hdr10) ?
+      (requestedDV ? OutputReason::NoDVTransport : OutputReason::NoHDR10Transport) : candidate.reason;
+  if (!requestedDV) return result;
+  if(policy.mode==DVBRIDGE_MODE_MASTER_REFERENCE && !preferences.allowMasterFallback)
+    return {OutputRoute::Vanilla,policy,result.reason};
+  if (!caps.hdr10)
+  {
+    result.reason = OutputReason::NoHDR10Transport;
+    return result;
+  }
+  candidate = admission(DVBRIDGE_MODE_HDR10_BASIC);
+  if (!candidate.usable)
+  {
+    result.reason = candidate.reason;
+    return result;
+  }
+  policy.mode = DVBRIDGE_MODE_HDR10_BASIC;
+  policy.master_ipt = false;
+  policy.adaptive = DVBRIDGE_ADAPTIVE_A;
+  policy.tv = {};
+  return {OutputRoute::HDR10, policy, result.reason};
+}
+} // namespace DVBRIDGE
+#endif
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
@@ -0,0 +1,188 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "ServiceBroker.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "DVMetadataBuffer.h"
+#include "utils/DVBridgeFastRendering.h"
+#include <atomic>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+#ifdef HAVE_DVBRIDGE
+#include "dvbridge_policy.h"
+#endif
+
+namespace DVBRIDGE
+{
+enum class OutputMode : int { Standard = 0, HDR10 = 1, Disabled = 2, EnhancedDV = 3, MasterReference = 4, AdaptiveB = 5 };
+enum class HDR10SourceMode : int { Native = 0, ReferenceDV = 1, EnhancedDV = 2 };
+
+// Decoder ingress sees the last complete frame-boundary preference snapshot.
+inline std::atomic<OutputMode> playbackMode{OutputMode::Standard};
+inline std::atomic<HDR10SourceMode> hdr10PlaybackMode{HDR10SourceMode::Native};
+
+#ifdef HAVE_DVBRIDGE
+inline int PolicyCode(const dvbridge_policy& policy)
+{
+  return policy.mode==DVBRIDGE_MODE_ENHANCED_DV && policy.adaptive!=DVBRIDGE_ADAPTIVE_A ? 6 : int(policy.mode);
+}
+#endif
+
+struct OutputPreferences
+{
+  OutputMode output{OutputMode::Standard};
+  HDR10SourceMode hdr10Source{HDR10SourceMode::Native};
+  int method{0}, panel{0}, gamut{0};
+  double peak{0};
+  bool optimizedDV{true};
+  bool masterIPT{false}, allowMasterFallback{true};
+  int felUpscaling{0};
+  bool processingOptimizations{false};
+  uint64_t revision{1};
+
+  bool ProfileValid() const
+  {
+    return std::isfinite(peak) && peak > 0 && peak <= 10000 &&
+        panel >= 0 && panel <= 2 && gamut >= 1 && gamut <= 3;
+  }
+
+  bool SameValues(const OutputPreferences& other) const
+  {
+    return output == other.output && hdr10Source == other.hdr10Source && method == other.method &&
+        panel == other.panel && gamut == other.gamut && optimizedDV == other.optimizedDV &&
+        masterIPT == other.masterIPT && allowMasterFallback == other.allowMasterFallback &&
+        felUpscaling == other.felUpscaling &&
+        processingOptimizations == other.processingOptimizations &&
+        std::bit_cast<uint64_t>(peak) == std::bit_cast<uint64_t>(other.peak);
+  }
+
+#ifdef HAVE_DVBRIDGE
+  int EffectiveFastRenderingMode(dvbridge_mode mode, bool /*hdr10AI*/ = false) const
+  {
+    return mode == DVBRIDGE_MODE_DISABLED || mode == DVBRIDGE_MODE_MASTER_REFERENCE ? 0 : 1;
+  }
+  bool EffectiveFastChroma(dvbridge_mode mode, bool hdr10AI = false) const
+  {
+    return EffectiveFastRenderingMode(mode, hdr10AI) == 1;
+  }
+  dvbridge_policy Policy() const
+  {
+    dvbridge_policy result{};
+    result.revision = revision;
+    switch (output)
+    {
+      case OutputMode::Disabled: result.mode = DVBRIDGE_MODE_DISABLED; break;
+      case OutputMode::Standard: result.mode = DVBRIDGE_MODE_STANDARD; break;
+      case OutputMode::EnhancedDV:
+      case OutputMode::AdaptiveB:
+        result.mode=DVBRIDGE_MODE_ENHANCED_DV;
+        result.adaptive=DVBRIDGE_ADAPTIVE_B_FP16;
+        break;
+      case OutputMode::MasterReference:
+        result.mode = DVBRIDGE_MODE_MASTER_REFERENCE; result.master_ipt = masterIPT; break;
+      case OutputMode::HDR10:
+        result.mode = method == 1 ? DVBRIDGE_MODE_HDR10_EXPERT : DVBRIDGE_MODE_HDR10_BASIC;
+        break;
+    }
+    // Basic/native paths never consume calibration. Keep invalid user values
+    // in this snapshot, rather than silently completing the stored profile.
+    if (result.mode == DVBRIDGE_MODE_HDR10_EXPERT ||
+        result.mode == DVBRIDGE_MODE_ENHANCED_DV)
+      result.tv = {peak, static_cast<dvbridge_panel>(panel), static_cast<dvbridge_gamut>(gamut)};
+    return result;
+  }
+  dvbridge_policy HDR10Policy() const
+  {
+    auto result = Policy();
+    result.adaptive=DVBRIDGE_ADAPTIVE_A;
+    result.master_ipt=false;
+    result.mode = hdr10Source == HDR10SourceMode::ReferenceDV ? DVBRIDGE_MODE_STANDARD :
+        hdr10Source == HDR10SourceMode::EnhancedDV ? DVBRIDGE_MODE_ENHANCED_DV : DVBRIDGE_MODE_DISABLED;
+    result.tv = result.mode == DVBRIDGE_MODE_ENHANCED_DV ?
+        dvbridge_tv_profile{peak,static_cast<dvbridge_panel>(panel),static_cast<dvbridge_gamut>(gamut)} : dvbridge_tv_profile{};
+    return result;
+  }
+#endif
+};
+
+inline std::mutex& OutputSettingsMutex()
+{
+  static std::mutex mutex;
+  return mutex;
+}
+
+#ifdef CB1_HAS_HDR10_AI
+// Protected by OutputSettingsMutex; confirmation retries without changing settings.
+inline uint64_t hdr10Reselection{};
+#endif
+
+inline OutputPreferences FrameOutputSettings()
+{
+  static OutputPreferences previous;
+#ifdef CB1_HAS_HDR10_AI
+  static uint64_t previousReselection{};
+#endif
+  std::lock_guard<std::mutex> lock(OutputSettingsMutex());
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int mode = settings ? settings->GetInt("dvbridge.outputmode") : 0;
+  OutputPreferences next;
+  next.output = mode == 3 ? OutputMode::AdaptiveB :
+      mode >= 0 && mode <= 5 ? static_cast<OutputMode>(mode) : OutputMode::Standard;
+  if (settings)
+  {
+    const int hdr10 = settings->GetInt("dvbridge.hdr10source");
+    next.hdr10Source = hdr10 >= 0 && hdr10 <= 2 ?
+        static_cast<HDR10SourceMode>(hdr10) : HDR10SourceMode::Native;
+    next.method = settings->GetInt("dvbridge.hdr10method");
+    next.peak = settings->GetNumber("dvbridge.tvpeak");
+    next.panel = settings->GetInt("dvbridge.tvpanel");
+    next.gamut = settings->GetInt("dvbridge.tvgamut");
+    next.felUpscaling = settings->GetInt("dvbridge.felupscaling");
+    next.masterIPT = settings->GetInt("dvbridge.masteroutput")==1;
+    next.allowMasterFallback = settings->GetBool("dvbridge.masterfallback");
+  }
+  if (next.method < 0 || next.method > 1) next.method = 0;
+  if (next.felUpscaling < 0 || next.felUpscaling > 1) next.felUpscaling = 0;
+  next.revision = previous.revision;
+  bool changed = !next.SameValues(previous);
+#ifdef CB1_HAS_HDR10_AI
+  changed |= previousReselection != hdr10Reselection;
+  previousReselection = hdr10Reselection;
+#endif
+  if (changed) next.revision = NextRevision();
+  previous = next;
+  playbackMode.store(next.output);
+  hdr10PlaybackMode.store(next.hdr10Source);
+  return next;
+}
+
+inline void SelectOutputSettings()
+{
+  FrameOutputSettings();
+}
+
+inline bool EnhancedInfoEnabled()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.enhancedinfo");
+}
+inline bool PlaybackMenuEnabled()
+{
+  return true;
+}
+inline bool AsyncPreparationEnabled()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.asyncpreparation");
+}
+inline bool FELHardwareUpscalingEnabled()
+{
+  return true;
+}
+} // namespace DVBRIDGE
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <atomic>
+#include <string>
+#include <sstream>
+#include <bitset>
+#include <array>
+#include <cstdint>
+
+namespace DVBRIDGE
+{
+enum class OutputReason { None, NoDVTransport, NoHDR10Transport,
+  NoGPUProcessing, SourceIneligible, TVProfileRequired, ActivationFailed, RestoreFailed };
+struct ModeAdmission { bool usable{}; OutputReason reason{OutputReason::None}; };
+struct OutputCapabilities
+{
+  bool sourceKnown{}, isDV{}, processingKnown{}, nativeDV{}, hdr10{};
+  bool stereoSource{};
+  uint64_t generation{};
+  std::array<ModeAdmission, 6> processing{};
+  bool isHDR10{};
+  std::array<ModeAdmission, 6> hdr10Processing{};
+};
+}
+
+// The render thread publishes one coherent snapshot only after presentation.
+// This is output telemetry, never a source-format or TV certification flag.
+struct CDVPlaybackInfo
+{
+  template<class Output> static bool IsHDR10AI(const Output& output)
+  {
+    if constexpr (requires { output.hdr10AI; }) return output.hdr10AI;
+    return false;
+  }
+  enum : unsigned { HDMI = 1, FEL = 2, CM4 = 4, HDR10 = 8 };
+  inline static std::atomic<unsigned> presented{0};
+  static int ReasonLabel(DVBRIDGE::OutputReason reason)
+  { return reason == DVBRIDGE::OutputReason::None ? 0 : 40840 + static_cast<int>(reason); }
+
+  static const char* Reason(DVBRIDGE::OutputReason reason)
+  {
+    switch(reason)
+    {
+      case DVBRIDGE::OutputReason::NoDVTransport: return "no-dv-transport";
+      case DVBRIDGE::OutputReason::NoHDR10Transport: return "no-hdr10-transport";
+      case DVBRIDGE::OutputReason::NoGPUProcessing: return "gpu-processing-unavailable";
+      case DVBRIDGE::OutputReason::SourceIneligible: return "source-ineligible";
+      case DVBRIDGE::OutputReason::TVProfileRequired: return "tv-profile-required";
+      case DVBRIDGE::OutputReason::ActivationFailed: return "activation-failed";
+      case DVBRIDGE::OutputReason::RestoreFailed: return "restoration-failed";
+      default: return "none";
+    }
+  }
+
+  static std::string Detail(std::string source, unsigned output)
+  {
+    if (!(output & (HDMI | HDR10)))
+      return source;
+    if ((output & FEL) && source.find("FEL") == std::string::npos)
+      source += " FEL";
+    source += (output & CM4) ? " · CM4 metadata" : " · CM2.9 metadata";
+    return source + ((output & HDR10) ? " · HDR10 Basic" : " · HDMI Dolby Vision");
+  }
+
+  template<class Output> static const char* Policy(const Output& output)
+  {
+    switch (output.effective)
+    {
+      case 2: return "HDR10 Reference Basic";
+      case 3: return "HDR10 Reference Expert";
+      case 4: return "Dolby Vision Adaptive HDR Mapping";
+      case 5: return "Dolby Vision Master Reference";
+      case 6: return "Dolby Vision Adaptive HDR Mapping";
+      default: return output.flags & HDR10 ? "HDR10 Reference Basic" : "Dolby Vision Standard";
+    }
+  }
+  static const char* RequestedPolicy(int mode, bool hdr10AI = false)
+  {
+    if (hdr10AI && mode == 1) return "Dolby Vision Reference (AI)";
+    if (hdr10AI && mode == 4) return "Dolby Vision Adaptive HDR Mapping (AI)";
+    switch(mode)
+    {
+      case 0:return "Dolby Vision Disabled (native Kodi)";
+      case 1:return "Dolby Vision Standard";
+      case 2:return "HDR10 Reference Basic";
+      case 3:return "HDR10 Reference Expert";
+      case 4:return "Dolby Vision Adaptive HDR Mapping";
+      case 5:return "Dolby Vision Master Reference";
+      case 6:return "Dolby Vision Adaptive HDR Mapping";
+      default:return "";
+    }
+  }
+
+  template<class Output> static std::string Mode(const Output& output)
+  {
+    if (!output.flags) return "Kodi default";
+    std::string mode = output.flags & HDR10 ? Policy(output) :
+        output.effective == 6 ? "Dolby Vision Adaptive HDR Mapping" :
+        output.effective == 5 ? "Dolby Vision Master Reference" :
+        output.effective == 4 ? "Dolby Vision Adaptive HDR Mapping" : "Dolby Vision Standard";
+    if (output.fallback)
+      mode += " / compatibility fallback";
+    return mode;
+  }
+
+  static std::string Blocks(const std::bitset<256>& blocks)
+  {
+    std::string text;
+    for(unsigned level=0;level<blocks.size();++level)
+      if(blocks[level]) text+=(text.empty() ? "" : " ")+std::string("L")+std::to_string(level);
+    return text;
+  }
+
+  static std::string Transport(uint32_t format)
+  {
+    switch(format)
+    {
+      case 0x34325258: case 0x34325241: return "RGB 4:4:4 / 8-bit";
+      case 0x30335258: case 0x30335241:
+      case 0x30334258: case 0x30334241: return "RGB 4:4:4 / 10-bit";
+      case 0x48344241: return "RGB 4:4:4 / 16-bit float";
+      default: return ""; // Unknown negotiated format is unavailable, never guessed.
+    }
+  }
+
+  template<class Output> static std::string Detail(std::string source, const Output& output)
+  {
+    if (!output.flags) return source;
+    if ((output.flags & FEL) && source.find("FEL") == std::string::npos) source += " FEL";
+    source += output.flags & CM4 ? " · CM4 metadata" : " · CM2.9 metadata";
+    source += " · " + Mode(output);
+    return source;
+  }
+};
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h
@@ -0,0 +1,412 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "DVPlaybackInfo.h"
+#include "DVMetadataBuffer.h"
+#include "ServiceBroker.h"
+#include "cores/DataCacheCore.h"
+#ifdef CB1_HAS_HDR10_AI
+#include "cb1_circuit.h"
+#endif
+
+#include <array>
+#include <bitset>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+#include <tuple>
+
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+#include <libavutil/mastering_display_metadata.h>
+#include <libavutil/pixfmt.h>
+}
+
+namespace DVBRIDGE
+{
+struct StreamSnapshot
+{
+  uint64_t informationGeneration{};
+  struct Transaction
+  {
+    SourceBinding identity{};
+    int requested{},effective{};
+    const char* stage{""};
+    OutputCapabilities capabilities{};
+    OutputReason reason{OutputReason::None};
+    int atomicError{};
+    unsigned retryCount{};
+    bool restored{};
+  } transaction;
+  bool referenceWarning{};
+  // Committed output is independent of sampled source metadata and counters.
+  struct Output
+  {
+    unsigned flags{}, bits{};
+    float target{};
+    bool level6{};
+    int requested{}, effective{1}, method{}, panel{}, gamut{};
+    double manualPeak{};
+    uint64_t revision{};
+    bool fallback{};
+    uint64_t stream{}, picture{};
+    uint32_t format{};
+    unsigned width{}, height{};
+    float refresh{};
+    bool authoredLegacy{};
+    std::array<double,3> rawStatistics{};
+    float rawSum{};
+    uint32_t sampleCount{};
+    OutputReason reason{OutputReason::None};
+    unsigned minimumLinkBits{};
+    bool creativeKnown{};
+    uint32_t creativeApplied{}, creativeEdited{};
+    int creativeStatus{}, creativeReason{};
+    bool fastChroma{};
+    bool iptTransport{};
+    int fastRenderingMode{};
+    int felUpscaling{-1};
+#ifdef CB1_HAS_HDR10_AI
+    bool hdr10AI{};
+    std::array<unsigned,6> aiL1L3{};
+    bool emittedL1Known{};
+    std::array<unsigned,3> emittedL1{};
+    const char* Circuit() const
+    {
+      if (!flags) return "";
+      if (hdr10AI)
+      {
+        if (effective==1) return cb1_circuit_version(CB1_HDR10_DV_REFERENCE);
+        if (effective==4) return cb1_circuit_version(CB1_HDR10_DV_ADAPTIVE);
+      }
+      else
+      {
+        if (effective==1) return cb1_circuit_version(CB1_DV_DV_REFERENCE);
+        if (effective==2) return cb1_circuit_version(CB1_DV_HDR10_BASIC);
+        if (effective==3) return cb1_circuit_version(CB1_DV_HDR10_EXPERT);
+        if (effective==4) return cb1_circuit_version(CB1_DV_DV_ADAPTIVE);
+        if (effective==5) return cb1_circuit_version(iptTransport ? CB1_DV_DV_MASTER_IPT : CB1_DV_DV_MASTER_REFERENCE);
+        if (effective==6) return cb1_circuit_version(CB1_DV_DV_ADAPTIVE_B);
+      }
+      return "";
+    }
+#endif
+  } output;
+  unsigned profile{}, level{}, major{}, minor{};
+  bool bl{}, el{}, rpu{}, metadata{}, cm4{}, fel{};
+  bool l1{}, l5{}, l6{};
+  std::array<unsigned, 3> pq{};
+  std::array<unsigned, 4> area{};
+  unsigned maxMaster{}, minMaster{}, maxCLL{}, maxFALL{};
+  unsigned framebufferBits{}, sourceBits{};
+  AVPixelFormat sourceFormat{AV_PIX_FMT_NONE};
+  int dropped{}, skipped{};
+  bool counters{};
+  bool sourceMastering{}, sourceLight{};
+  double sourceMax{}, sourceMin{};
+  unsigned sourceCLL{}, sourceFALL{};
+  std::bitset<256> blocks;
+
+  std::bitset<256> AppliedBlocks() const
+  {
+    std::bitset<256> result;
+    if (!output.flags || !metadata) return result;
+    result[5]=blocks[5]; // Active-picture geometry, not a creative trim.
+    for(unsigned level=0;level<32;++level)
+      if (output.creativeApplied & (1u<<level)) result[level]=blocks[level];
+    if (output.flags & CDVPlaybackInfo::HDR10 || output.authoredLegacy)
+    {
+      result[1]=blocks[1] && pq[0]<=pq[2] && pq[2]<=pq[1] && pq[1]>0 && pq[1]<=4095;
+      result[6]=blocks[6] && (output.effective>=3 || output.level6);
+    }
+    return result;
+  }
+  std::bitset<256> TransmittedBlocks() const
+  {
+    std::bitset<256> result;
+    if (!(output.flags & CDVPlaybackInfo::HDMI) || !metadata) return result;
+    if (output.authoredLegacy) { result[1]=result[5]=true; return result; }
+    result=blocks;
+    result[6]=false; // L6 is static HDR metadata, not dynamic DV wire data.
+    result[5]=true; // Native serializer always supplies final-raster margins.
+    return result;
+  }
+};
+
+class StreamTelemetry
+{
+public:
+  static void PublishNativeInfo(uint64_t generation);
+  static void PublishNativePending(uint64_t generation);
+
+  // The adapter session fixes target/precision. Only flag transitions publish.
+  static bool Presented(unsigned flags, unsigned bits, float target, bool level6)
+  {
+    if (CDVPlaybackInfo::presented.load() == flags)
+      return false;
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_snapshot.output = {flags, bits, target, level6};
+    CDVPlaybackInfo::presented.store(flags);
+    return true;
+  }
+
+  static void ClearOutput()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_snapshot.output = {};
+    m_snapshot.transaction = {};
+    m_snapshot.referenceWarning=false;
+    m_nativeActive = false;
+    CDVPlaybackInfo::presented.store(0);
+  }
+
+  static void SourceBits(unsigned bits, AVPixelFormat format, const SourceInfo& source)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (source.informationGeneration!=m_decodedSource.informationGeneration ||
+        (m_nativeActive && source.informationGeneration!=m_nativeSource.informationGeneration))
+    {
+      m_nativeActive=false;
+      m_snapshot={};
+    }
+    m_decodedSource=source;
+    m_decodedSource.bits=bits;
+    m_decodedSource.format=static_cast<int>(format);
+  }
+
+  static void Counters(int dropped, int skipped)
+  {
+    m_dropped.store(dropped, std::memory_order_relaxed);
+    m_skipped.store(skipped, std::memory_order_relaxed);
+    m_counters.store(true, std::memory_order_relaxed);
+  }
+
+  static void StaticMetadata(const AVMasteringDisplayMetadata* mastering,
+                             const AVContentLightMetadata* light)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (mastering && mastering->has_luminance &&
+        mastering->max_luminance.den > 0 && mastering->min_luminance.den > 0)
+    {
+      m_snapshot.sourceMastering = true;
+      m_snapshot.sourceMax = av_q2d(mastering->max_luminance);
+      m_snapshot.sourceMin = av_q2d(mastering->min_luminance);
+    }
+    if (light)
+    {
+      m_snapshot.sourceLight = true;
+      m_snapshot.sourceCLL = light->MaxCLL;
+      m_snapshot.sourceFALL = light->MaxFALL;
+    }
+  }
+
+  static void Begin(unsigned profile, unsigned level, unsigned major, unsigned minor,
+                    bool bl, bool el, bool rpu)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto output = m_snapshot.output;
+    m_snapshot = {};
+    m_snapshot.output = output;
+    m_counters.store(false, std::memory_order_relaxed);
+    m_snapshot.profile = profile;
+    m_snapshot.level = level;
+    m_snapshot.major = major;
+    m_snapshot.minor = minor;
+    m_snapshot.bl = bl;
+    m_snapshot.el = el;
+    m_snapshot.rpu = rpu;
+    m_next = {};
+  }
+
+  // Called on the renderer thread only, after its metadata bounds validation.
+  static void Metadata(const AVDOVIMetadata* data, bool fel, unsigned bits)
+  {
+    const auto now = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (now < m_next)
+      return;
+    m_next = now + std::chrono::milliseconds(500);
+    StoreMetadata(m_snapshot,data,fel,bits);
+  }
+
+  static void NativePresented(const SourceInfo& source,const CDVMetadataBuffer& metadata,
+                              const StreamSnapshot::Output& output)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_nativeActive = true;
+    m_nativeSource = source;
+    const auto now=std::chrono::steady_clock::now();
+    if (metadata.Data() && (!m_snapshot.metadata || output.stream!=m_snapshot.output.stream ||
+        output.revision!=m_snapshot.output.revision || now>=m_next))
+    {
+      StoreMetadata(m_snapshot,reinterpret_cast<const AVDOVIMetadata*>(metadata.Data()),
+          (output.flags & CDVPlaybackInfo::FEL)!=0,output.bits);
+      m_next=now+std::chrono::milliseconds(500);
+    }
+    if (!metadata.Data()) { m_snapshot.metadata=false; m_snapshot.blocks.reset(); }
+    m_snapshot.output = output;
+    if (m_snapshot.transaction.identity==SourceBinding{output.stream,output.picture,output.revision})
+    {
+      m_snapshot.output.reason=m_snapshot.transaction.reason;
+      m_snapshot.output.requested=m_snapshot.transaction.requested;
+      m_snapshot.output.minimumLinkBits=(output.flags & CDVPlaybackInfo::HDR10) ? 10 : 0;
+    }
+    m_snapshot.referenceWarning=false;
+    if (m_snapshot.transaction.identity==SourceBinding{output.stream,output.picture,output.revision})
+      m_snapshot.transaction.stage="Committed";
+    CDVPlaybackInfo::presented.store(output.flags);
+  }
+
+  static void NativeRequest(SourceBinding identity,int requested,int effective,
+                            SourceBinding admissionIdentity = {})
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_snapshot.transaction.identity!=identity &&
+        (!admissionIdentity.Valid() || m_snapshot.transaction.identity!=admissionIdentity))
+      m_snapshot.transaction={};
+    auto& transaction=m_snapshot.transaction;
+    transaction.identity=identity; transaction.requested=requested;
+    transaction.effective=effective; transaction.stage="Requested";
+  }
+  static void NativeSelection(SourceBinding identity,const OutputCapabilities& capabilities,
+                              int requested,int effective,OutputReason reason)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_snapshot.transaction.identity!=identity)
+    {
+      m_snapshot.transaction={};
+      m_snapshot.transaction.stage="Admission checked";
+    }
+    auto& transaction=m_snapshot.transaction;
+    transaction.identity=identity; transaction.capabilities=capabilities;
+    transaction.requested=requested; transaction.effective=effective;
+    transaction.reason=reason;
+  }
+  static void NativeFailure(OutputReason reason,int error,unsigned retries,bool restored)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto& transaction=m_snapshot.transaction;
+    transaction.reason=reason; transaction.atomicError=error;
+    transaction.retryCount=retries; transaction.restored=restored;
+    transaction.stage=restored ? "Activation failed" : "Restoration failed";
+  }
+  static void NativeStage(SourceBinding identity,const char* stage)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_snapshot.transaction.identity==identity) m_snapshot.transaction.stage=stage;
+  }
+  static void ReferenceWarning()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_snapshot.referenceWarning=true;
+  }
+
+  static void NativeFormat(SourceBinding identity,uint32_t format,unsigned width,
+                           unsigned height,float refresh)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto& output=m_snapshot.output;
+    if (!m_nativeActive || identity.stream!=output.stream || identity.picture!=output.picture ||
+        identity.revision!=output.revision) return;
+    output.format=format; output.width=width; output.height=height; output.refresh=refresh;
+  }
+
+private:
+  static void StoreMetadata(StreamSnapshot& out,const AVDOVIMetadata* data,bool fel,unsigned bits)
+  {
+    out.metadata = true;
+    out.fel = fel;
+    out.framebufferBits = bits;
+    out.l1 = out.l5 = out.l6 = out.cm4 = false;
+    out.blocks.reset();
+    for (int i = 0; i < data->num_ext_blocks; ++i)
+    {
+      const auto* ext = av_dovi_get_ext(data, i);
+      out.blocks.set(ext->level);
+      switch (ext->level)
+      {
+        case 1:
+          out.l1 = true;
+          out.pq = {ext->l1.min_pq, ext->l1.max_pq, ext->l1.avg_pq};
+          break;
+        case 5:
+          out.l5 = true;
+          out.area = {ext->l5.left_offset, ext->l5.right_offset,
+                      ext->l5.top_offset, ext->l5.bottom_offset};
+          break;
+        case 6:
+          out.l6 = true;
+          out.maxMaster = ext->l6.max_luminance;
+          out.minMaster = ext->l6.min_luminance;
+          out.maxCLL = ext->l6.max_cll;
+          out.maxFALL = ext->l6.max_fall;
+          break;
+        case 3: case 8: case 9: case 10: case 11: case 254:
+          out.cm4 = true;
+          break;
+      }
+    }
+  }
+
+public:
+  static StreamSnapshot Read()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto result = m_snapshot;
+    result.counters = m_counters.load(std::memory_order_relaxed);
+    result.dropped = m_dropped.load(std::memory_order_relaxed);
+    result.skipped = m_skipped.load(std::memory_order_relaxed);
+    {
+      const auto& source = m_nativeActive ? m_nativeSource : m_decodedSource;
+      result.informationGeneration=source.informationGeneration;
+      result.profile = source.profile; result.level = source.level;
+      result.major = source.major; result.minor = source.minor;
+      result.bl = source.bl; result.el = source.el; result.rpu = source.rpu;
+      result.sourceBits = source.bits; result.sourceFormat = static_cast<AVPixelFormat>(source.format);
+      result.sourceMastering = source.mastering; result.sourceLight = source.light;
+      result.sourceMax = source.maxLuma; result.sourceMin = source.minLuma;
+      result.sourceCLL = source.maxCLL; result.sourceFALL = source.maxFALL;
+    }
+    return result;
+  }
+
+private:
+  inline static std::atomic<int> m_dropped{}, m_skipped{};
+  inline static std::atomic<bool> m_counters{false};
+  inline static std::mutex m_mutex;
+  inline static StreamSnapshot m_snapshot;
+  inline static SourceInfo m_nativeSource;
+  inline static SourceInfo m_decodedSource;
+  inline static bool m_nativeActive{};
+  inline static std::chrono::steady_clock::time_point m_next;
+};
+} // namespace DVBRIDGE
+
+#include "DVProcessingInfo.h"
+inline void DVBRIDGE::StreamTelemetry::PublishNativeInfo(uint64_t generation)
+{
+  // Bounded summaries refresh at 2 Hz; accepted mode/format changes publish immediately.
+  using Key=std::tuple<uint64_t,uint64_t,uint64_t,unsigned,int,uint32_t,bool,bool,int>;
+  static Key previous{};
+  static std::chrono::steady_clock::time_point next;
+  const auto source=Read();
+  const auto& output=source.output;
+  const Key key{generation,output.stream,output.revision,output.flags,output.effective,
+      output.format,output.fastChroma,output.fallback,int(output.reason)};
+  const auto now=std::chrono::steady_clock::now();
+  if (now<next && key==previous) return;
+  if (CServiceBroker::GetDataCacheCore().SetVideoProcessingInfo(generation,NativeProcessingInfo(source)))
+  {
+    previous=key;
+    next=now+std::chrono::milliseconds(500);
+  }
+}
+
+inline void DVBRIDGE::StreamTelemetry::PublishNativePending(uint64_t generation)
+{
+  auto& cache=CServiceBroker::GetDataCacheCore();
+  auto info=cache.GetVideoProcessingInfo();
+  info.transaction=NativeProcessingInfo(Read()).transaction;
+  cache.SetVideoProcessingInfo(generation,info);
+}
