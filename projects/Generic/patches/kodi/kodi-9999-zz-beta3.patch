+  {
+    CLog::Log(LOGDEBUG, "CWinSystemGbmGLESContext::{} - Sending display reset to all clients",
+              __FUNCTION__);
+    m_dispReset = false;
+    std::unique_lock lock(m_resourceSection);
+
+    for (auto resource : m_resources)
+      resource->OnResetDisplay();
+  }
+}
