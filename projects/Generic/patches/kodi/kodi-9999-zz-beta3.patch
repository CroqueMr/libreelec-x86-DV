+#define CB1_L1L3_BUNDLE_DIR "/usr/share/cb1/l1l3"
+#endif
+bool CWinSystemGbmGLESContext::HDR10AILookaheadActive() const
+{
+  std::lock_guard lock(m_dvCapabilityMutex);
+  return m_aiActive;
