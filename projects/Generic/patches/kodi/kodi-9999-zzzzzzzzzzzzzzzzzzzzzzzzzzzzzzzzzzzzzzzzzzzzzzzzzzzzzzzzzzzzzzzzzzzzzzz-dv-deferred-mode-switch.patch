+bool CWinSystemGbmGLESContext::DVModeSwitchDeferred()
+{
+  constexpr uint64_t DEFER_TIMEOUT_MS = 2000;
+  const bool pending =
+      !m_dvRollbackFailed &&
+      (m_dvEndPending ||
+       (m_dvShutdownFence && m_dvContext && m_dvContext->Poll() != DVBRIDGE_DV_FAILED));
+  if (!pending)
+  {
+    m_dvModeSwitchDeferStartMs.reset();
+    return false;
+  }
+  const uint64_t now = DVBRIDGE::DiagnosticNowMs();
+  if (!m_dvModeSwitchDeferStartMs)
+  {
+    m_dvModeSwitchDeferStartMs = now;
+    CLog::Log(LOGINFO,
+              "CB1: deferring mode switch pending DV retirement (end_pending={} shutdown_fence={})",
+              m_dvEndPending, m_dvShutdownFence);
+  }
+  const uint64_t elapsed =
+      now >= *m_dvModeSwitchDeferStartMs ? now - *m_dvModeSwitchDeferStartMs : 0;
+  if (elapsed >= DEFER_TIMEOUT_MS)
+  {
+    CLog::Log(LOGWARNING,
+              "CB1: deferred mode switch timed out after {} ms (end_pending={} shutdown_fence={})",
+              elapsed, m_dvEndPending, m_dvShutdownFence);
+    m_dvModeSwitchDeferStartMs.reset();
+    return false;
+  }
+  return true;
+}
