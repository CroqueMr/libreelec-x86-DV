+bool CDVDInputStreamBluray::HoldEvent()
+{
+  if (m_hold == HOLD_EXIT || m_hold == HOLD_ERROR)
+    return true;
+
+  switch (m_event.event)
+  {
+    case BD_EVENT_SEEK:
+    case BD_EVENT_TITLE:
+    case BD_EVENT_ANGLE:
+    case BD_EVENT_PLAYLIST:
+    case BD_EVENT_PLAYITEM:
