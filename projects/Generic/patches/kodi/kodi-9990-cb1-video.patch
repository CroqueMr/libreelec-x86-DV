+      {
+        m_hold = HOLD_HELD;
+        return true;
+      }
+      break;
+    case BD_EVENT_STILL_TIME:
+      if (m_hold == HOLD_STILL)
+        m_event.event = BD_EVENT_NONE;
+      else
+        m_hold = HOLD_HELD;
+      return true;
+    default:
+      break;
+  }
+  return false;
