+std::optional<MenuPQAdjustment> GetMenuPQAdjustment()
+{
+#if defined(HAS_GLES) && defined(HAVE_DVBRIDGE)
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (!settings || !settings->GetSetting(CSettings::SETTING_DISC_MENUHDRBRIGHTNESS) ||
+      !settings->GetSetting(CSettings::SETTING_DISC_MENUHDRSATURATION))
+    return std::nullopt;
+  const int brightness = settings->GetInt(CSettings::SETTING_DISC_MENUHDRBRIGHTNESS);
+  const int saturation = settings->GetInt(CSettings::SETTING_DISC_MENUHDRSATURATION);
+  if (brightness == 100 && saturation == 100)
+    return std::nullopt;
+
+  // The same PQ destination test that moves PQ bitmaps out of the GUI composite: the HDR
+  // composite with no SDR compositor behind it.
+  const CWinSystemBase* winSystem = CServiceBroker::GetWinSystem();
+  if (!winSystem || !winSystem->IsHdrComposite() || ShouldConvertPQPaletteToSRGB(true))
+    return std::nullopt;
+  // CB1's Dolby Vision and rendering circuits compose PQ bitmaps into their own picture. A BD-J
+  // plane is present for the whole title, so moving it there changes how every frame is
+  // prepared; keep their menus on the GUI composite.
+  if (const auto* gbm = dynamic_cast<const KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(winSystem);
+      gbm && gbm->HasDVBridgeScreenshot())
+    return std::nullopt;
+  return MenuPQAdjustment{std::clamp(brightness, 50, 500) / 100.0f,
+                          std::clamp(saturation, 0, 200) / 100.0f};
+#else
+  return std::nullopt;
+#endif
+}
