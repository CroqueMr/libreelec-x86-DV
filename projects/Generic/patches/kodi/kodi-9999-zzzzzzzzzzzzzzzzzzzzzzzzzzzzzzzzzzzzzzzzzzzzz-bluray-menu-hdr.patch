diff --git a/system/shaders/GLES/2.0/gles_shader_texture_noblend.frag b/system/shaders/GLES/2.0/gles_shader_texture_noblend.frag
index f893992..74bab04 100644
--- a/system/shaders/GLES/2.0/gles_shader_texture_noblend.frag
+++ b/system/shaders/GLES/2.0/gles_shader_texture_noblend.frag
@@ -25,6 +25,9 @@ uniform sampler2D m_samp0;
 varying vec4 m_cord0;
 uniform float m_sdrPeak;
 uniform float m_pma;
+// Disc menu drawn straight into a PQ destination: x is the linear gain over the 203 nit GUI
+// reference white (0 leaves the texel alone), y the saturation, z selects limited range.
+uniform highp vec4 m_menuPQ;
 
 void main ()
 {
@@ -32,6 +35,27 @@ void main ()
 
   rgb = texture2D(m_samp0, m_cord0.xy);
 
+  if (m_menuPQ.x > 0.0)
+  {
+    highp float alpha = rgb.a;
+    highp vec3 c = rgb.rgb;
+    if (m_pma > 0.5)
+      c = alpha > 0.0 ? c / alpha : vec3(0.0);
+    c = clamp(c, 0.0, 1.0);
+    // IEC 61966-2-1 and BT.709 -> BT.2020, as gles_gui_composite.frag decodes the interface.
+    c = mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
+    highp float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
+    c = max(vec3(luma) + (c - vec3(luma)) * m_menuPQ.y, 0.0);
+    c = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956) * c;
+    c = min(c * (0.0203 * m_menuPQ.x), 1.0);
+    highp vec3 p = pow(c, vec3(0.1593017578125));
+    c = pow((0.8359375 + 18.8515625 * p) / (1.0 + 18.6875 * p), vec3(78.84375));
+    if (m_menuPQ.z > 0.5)
+      c = c * (219.0 / 255.0) + 16.0 / 255.0;
+    gl_FragColor = vec4(m_pma > 0.5 ? c * alpha : c, alpha);
+    return;
+  }
+
 #if defined(KODI_LIMITED_RANGE)
   rgb.rgb *= (235.0 - 16.0) / 255.0;
   rgb.rgb += mix(1.0, rgb.a, m_pma) * 16.0 / 255.0;
