+        !save(connector, "dithering mode", 0, true, false, "off") ||
+        !save(connector, "Colorspace", 0, true, false, "Default") ||
+        !save(crtc, "NV_CRTC_REGAMMA_TF", 0, false, false, "Default") ||
+        !save(crtc, "NV_CRTC_REGAMMA_LUT", 0, false, true) ||
+        !save(crtc, "NV_CRTC_REGAMMA_DIVISOR", unity, false, false) ||
+        !save(crtc, "NV_CRTC_COLOR_PASSTHROUGH", 0, false, false) ||
+        !save(plane, "NV_INPUT_COLORSPACE", 0, false, false, "None") ||
+        !save(plane, "NV_HDR_STATIC_METADATA", 0, false, true) ||
+        !save(plane, "NV_PLANE_LMS_CTM", 0, false, true) ||
+        !save(plane, "NV_PLANE_LMS_TO_ITP_CTM", 0, false, true) ||
+        !save(plane, "NV_PLANE_ITP_TO_LMS_CTM", 0, false, true) ||
+        !save(plane, "NV_PLANE_BLEND_CTM", 0, false, true) ||
+        !save(plane, "NV_PLANE_DEGAMMA_TF", 0, false, false, "Default") ||
+        !save(plane, "NV_PLANE_DEGAMMA_LUT", 0, false, true) ||
+        !save(plane, "NV_PLANE_DEGAMMA_MULTIPLIER", unity, false, false) ||
+        !save(plane, "NV_PLANE_TMO_LUT", 0, false, true) ||
+        !save(plane, "NV_PLANE_COLOR_PASSTHROUGH", 0, false, false))
+      return false;
+  }
+  if (!save(crtc, "CTM", 0, false, true) ||
+      !save(crtc, "GAMMA_LUT", 0, false, true) ||
+      !save(crtc, "DEGAMMA_LUT", 0, false, true) ||
+      !save(crtc, "VRR_ENABLED", 0, false, false) ||
+      !save(plane, "rotation", DRM_MODE_ROTATE_0, false, false) ||
+      !save(plane, "alpha", 65535, false, false) ||
+      !save(plane, "COLOR_PIPELINE", 0, false, false) ||
+      !save(plane, "pixel blend mode", 0, false, false, "None"))
+    return false;
+
+  // Do not silently corrupt tunnel bytes with another plane or hardware cursor.
+  auto* planes = drmModeGetPlaneResources(drm.GetFileDescriptor());
+  if (!planes)
+    return reject("plane-resources");
+  bool safe = true;
+  for (uint32_t i = 0; i < planes->count_planes; ++i)
+  {
+    auto* other = drmModeGetPlane(drm.GetFileDescriptor(), planes->planes[i]);
+    if (!other)
+    {
+      reject("plane-query");
+      safe = false;
+      break;
+    }
+    safe &= other->plane_id == plane->GetId() || other->crtc_id != crtc->GetCrtcId();
+    if (!safe)
+      reject("active-plane");
+    drmModeFreePlane(other);
+  }
+  drmModeFreePlaneResources(planes);
+  if (!safe)
+    return false;
+  m_saved = std::move(saved);
+  m_owner = &drm;
+  m_backend = backend;
+  return true;
+}
+
+bool CDVBridgeState::Stage(CDRMAtomic& drm, bool restore)
+{
+  if (!Captured() || m_owner != &drm || m_saved.front().object != drm.GetConnector())
+    return false;
+  bool valid = true;
+  for (const auto& property : m_saved)
+    valid &= drm.AddProperty(property.object, property.name.c_str(),
+                             restore ? property.original : property.transport);
+  return valid;
+}
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.h b/xbmc/windowing/gbm/drm/DVBridgeState.h
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "DRMObject.h"
+#include <string>
+#include <vector>
+
+namespace KODI::WINDOWING::GBM
+{
+class CDRMAtomic;
+class CDRMConnector;
+
+class CDVBridgeState
+{
+public:
+  enum class Backend { NONE, KERNEL, NVIDIA };
+  static Backend GetBackend(CDRMConnector& connector);
+  bool Capture(CDRMAtomic& drm, uint64_t ownVsif = 0);
+  bool Stage(CDRMAtomic& drm, bool restore);
+  void Restored() { m_saved.clear(); m_owner = nullptr; m_backend = Backend::NONE; }
+  bool Captured() const { return !m_saved.empty(); }
+  Backend CapturedBackend() const { return m_backend; }
+  const char* CaptureFailure() const { return m_captureFailure; }
+
+private:
+  struct Property
+  {
+    CDRMObject* object;
+    std::string name;
+    uint64_t original;
+    uint64_t transport;
+    CDRMPropertyBlob blob;
+    CDRMPropertyBlob transportBlob;
+  };
+  std::vector<Property> m_saved;
+  CDRMAtomic* m_owner = nullptr;
+  Backend m_backend = Backend::NONE;
+  const char* m_captureFailure = "none";
+};
+}
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeScreenshot.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeScreenshot.h
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeScreenshot.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace DVBRIDGE
+{
+// Readback only: decode the completed source-YCC carrier, including its GUI.
+// Rows retain their GL order; the screenshot buffer supplies the signed stride.
+inline bool DecodeReferenceScreenshot(const uint8_t* carrier, unsigned width, unsigned height,
+                                     const float decode[12], const float linear[9], uint16_t* rgb)
+{
+  if (!carrier || !rgb || !width || !height || (width & 1))
+    return false;
+  const auto eotf=[](double q) {
+    q=std::pow(std::max(q,0.0),32.0/2523.0);
+    return std::pow(std::max(q-3424.0/4096.0,0.0)/(2413.0/128.0-2392.0/128.0*q),16384.0/2610.0);
+  };
+  const auto oetf=[](double n) {
+    n=std::pow(std::clamp(n,0.0,1.0),2610.0/16384.0);
+    return std::pow((3424.0/4096.0+2413.0/128.0*n)/(1.0+2392.0/128.0*n),2523.0/32.0);
+  };
+  for (size_t pixel=0;pixel<size_t(width)*height;pixel+=2)
+  {
+    const uint8_t* pair=carrier+4*pixel;
+    const double cb=((unsigned(pair[0])<<4)|(pair[2]>>4))/4095.0;
+    const double cr=((unsigned(pair[4])<<4)|(pair[6]>>4))/4095.0;
+    for (unsigned side=0;side<2;side++)
+    {
+      const uint8_t* p=pair+4*side;
+      const double y=((unsigned(p[1])<<4)|(p[2]&15))/4095.0;
+      double light[3];
+      for (unsigned i=0;i<3;i++)
+        light[i]=eotf(decode[4*i]*y+decode[4*i+1]*cb+decode[4*i+2]*cr+decode[4*i+3]);
+      uint16_t* out=rgb+4*(pixel+side);
+      for (unsigned i=0;i<3;i++)
+        out[i]=static_cast<uint16_t>(std::lround(65535.0*oetf(
+            linear[3*i]*light[0]+linear[3*i+1]*light[1]+linear[3*i+2]*light[2])));
+      out[3]=65535;
+    }
+  }
+  return true;
+}
+}
