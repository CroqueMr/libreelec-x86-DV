+uint32_t CDRMUtils::DrmOpaqueFbGetFromBo(struct gbm_bo* bo)
+{
+  auto* fb = DrmFbGetFromBo(bo);
+  if (!fb)
+    return 0;
+  if (fb->format == DRM_FORMAT_XRGB8888)
+    return fb->fb_id;
+  if (fb->format != DRM_FORMAT_ARGB8888)
+    return 0;
+  if (fb->opaque_fb_id)
+    return fb->opaque_fb_id;
