+// Render-thread confined. The owning GL context must retire GPU use before destruction.
+class HDR10AISource
+{
+public:
+  using Decision = DVBRIDGE::HDR10AIActivation::Decision;
+  HDR10AISource() = default;
+  HDR10AISource(const HDR10AISource&) = delete;
