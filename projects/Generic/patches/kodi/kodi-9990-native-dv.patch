+  // extra pixel storage. Never let scanout alpha blend a packed DV transport.
+  uint32_t handles[4]{}, strides[4]{}, offsets[4]{};
+  uint64_t modifiers[4]{};
+#if defined(HAS_GBM_MODIFIERS)
+  const int planes = gbm_bo_get_plane_count(bo);
