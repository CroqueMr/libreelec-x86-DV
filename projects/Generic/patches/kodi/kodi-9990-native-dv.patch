+      m_fd, gbm_bo_get_width(bo), gbm_bo_get_height(bo), DRM_FORMAT_XRGB8888,
+      handles, strides, offsets, modifiers, &fb->opaque_fb_id, flags);
+  if (result != 0)
+  {
+    fb->opaque_fb_id = 0;
+    CLog::LogF(LOGERROR, "Cannot create opaque transport framebuffer: {}", strerror(errno));
+  }
