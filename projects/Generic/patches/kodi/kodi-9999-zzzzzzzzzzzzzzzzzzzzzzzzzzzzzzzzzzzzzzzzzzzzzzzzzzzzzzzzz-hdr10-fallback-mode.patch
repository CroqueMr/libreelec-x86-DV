+bool CWinSystemGbm::SupportsDVOutputTiming(RESOLUTION resolution) const
+{
+  const auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  if (!connector || !connector->IsConnected() || resolution < RES_DESKTOP)
+    return false;
+
+  const auto& display = CDisplaySettings::GetInstance();
+  const auto& info = display.GetResolutionInfo(resolution);
+  const auto* end = info.strId.data() + info.strId.size();
+  int index = -1;
+  const auto parsed = std::from_chars(info.strId.data(), end, index);
+  if (parsed.ec != std::errc{} || parsed.ptr != end || index < 0 ||
+      index >= connector->GetModesCount())
+    return false;
+
+  // The connector mode list can change before Kodi rebuilds its resolution catalogue.
+  return UsableDVOutputTiming(connector->GetModeForIndex(index), &info);
+}
