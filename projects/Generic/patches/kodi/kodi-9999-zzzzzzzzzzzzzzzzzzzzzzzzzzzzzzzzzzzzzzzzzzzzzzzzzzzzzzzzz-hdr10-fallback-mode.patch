+bool UsableDVOutputTiming(const drmModeModeInfo* mode, const RESOLUTION_INFO* expected = nullptr)
+{
+  if (!mode || !mode->hdisplay || (mode->hdisplay & 1) || !mode->vdisplay ||
+      mode->hdisplay > 3840 || mode->vdisplay > 2160 ||
+      uint64_t(mode->hdisplay) * mode->vdisplay < 5 * 3072u ||
+      (mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN)))
+    return false;
+  const double rate = mode->htotal && mode->vtotal
+                          ? mode->clock * 1000.0 / mode->htotal / mode->vtotal
+                          : 0.0;
+  return CResolutionUtils::IsCB1RefreshRate(rate) &&
+         (!expected || (!(mode->flags & DRM_MODE_FLAG_3D_MASK) &&
+                        !(expected->dwFlags & D3DPRESENTFLAG_MODEMASK) &&
+                        mode->hdisplay == expected->iScreenWidth &&
+                        mode->vdisplay == expected->iScreenHeight &&
+                        std::abs(rate - expected->fRefreshRate) < 0.01));
+}
