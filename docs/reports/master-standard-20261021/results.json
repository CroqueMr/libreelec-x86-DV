  "definitions": {
    "fidelity": [
      {
        "label": "Mean absolute error",
        "definition": "Sum of absolute Standard-minus-Master code differences divided by all active-picture component samples. Chroma counts one value per 4:2:2 pair."
      },
      {
        "label": "Maximum",
        "definition": "Largest absolute difference in any active-picture 12-bit component sample over all 600 source seconds."
      },
      {
        "label": "p99.9",
        "definition": "Exact 99.9th percentile of all absolute sample errors, computed from the complete 4096-bin histogram."
      },
      {
        "label": "Above 16 / 64 codes",
        "definition": "Share of component samples with an absolute error strictly greater than the stated code count. These are descriptive bins, not visibility thresholds."
      }
    ],
    "gains": [
      {
        "label": "Headroom gain",
        "definition": "Standard mean presentation headroom minus Master Reference mean presentation headroom, using the pooled frame samples from two matched 90-second windows per mode."
      },
      {
        "label": "GFX decrease",
        "definition": "Master Reference GFX busy percentage minus Standard GFX busy percentage, in percentage points. Relative decrease divides this difference by Master Reference GFX busy percentage."
      },
      {
        "label": "GFX occupancy saved per nominal frame",
        "definition": "Difference in GFX busy fractions multiplied by the 41.708333 ms nominal frame period at 24000/1001 fps. This is engine occupancy normalized per source frame, not a measurement of frame latency or presentation headroom."
      },
      {
        "label": "Paired gain range",
        "definition": "Range of the two matched-window mean differences. This is observed repeatability, not a confidence interval."
      }
    ],
    "performance": [
      {
        "label": "Headroom",
        "definition": "Deadline minus the later of render completion and host submission. The next deadline is based on the previous accepted scanout plus one display period. Means, p1 and minima describe valid consecutive presentations, not offscreen shader timings."
      },
      {
        "label": "GPU rendering load",
        "definition": "Delta of Kodi DRM fdinfo gfx-engine busy nanoseconds divided by elapsed wall-clock nanoseconds, expressed as a percentage. This excludes separate decode-engine counters."
      }
    ],
    "curves": [
      {
        "label": "Maximum (%)",
        "definition": "Maximum across all useful-picture samples in all frames of each second, divided by 4095 and multiplied by 100. Percentage of the full 12-bit digital code range, not image-quality loss."
      },
      {
        "label": "Whole-image mean (%)",
        "definition": "Mean absolute difference across the entire useful picture, pixel-weighted over every frame of each second, divided by 4095 and multiplied by 100. Letterbox and metadata carrier rows are excluded."
      }
    ]
  },
