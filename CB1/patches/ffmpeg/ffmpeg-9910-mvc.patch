+    highest_view = av_log2(views_active_output);
+    if (highest_view >= H264_MAX_MVC_VIEWS) {
+        av_log(h->avctx, AV_LOG_ERROR, "Too many views requested: %x\n",
+               views_active_output);
+        return AVERROR(EINVAL);
+    }
