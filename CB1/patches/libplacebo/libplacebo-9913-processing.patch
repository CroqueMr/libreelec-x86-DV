+        GLSL("color[%d]=clamp(texture("$",vec2((sig[%d]*1023.0+0.5)/1024.0,"$")).r,"$","$");\n",
+             channel, texture, channel, row, low, high);
+        return true;
+    }
+    if (!(p->narrow_components & component)) return false;
+    GLSL("s="$";\n", SH_FLOAT_DYN(curve->mmr_constant[0]));
