+    GLSLH("uvec2 "$"(uvec2 a){return "$"(~a,uvec2(1u,0u));}\n", neg, add);
+    GLSLH("uvec2 "$"(uvec2 a,uint b){uint hi,lo;umulExtended(a.x,b,hi,lo);return uvec2(lo,hi+a.y*b);}\n", mul);
+    GLSLH("uvec2 "$"(uvec2 a,uint s){if(s==0u)return a;if(s<32u)return uvec2((a.x>>s)|(a.y<<(32u-s)),uint(int(a.y)>>int(s)));"
+          "if(s<64u)return uvec2(uint(int(a.y)>>int(s-32u)),uint(int(a.y)>>31));return uvec2(uint(int(a.y)>>31));}\n", shr);
+    GLSLH("uvec2 "$"(uvec2 a,uint s){if(s==0u)return a;if(s<32u)return uvec2(a.x<<s,(a.y<<s)|(a.x>>(32u-s)));"
+          "if(s<64u)return uvec2(0u,a.x<<(s-32u));return uvec2(0u);}\n", shl);
