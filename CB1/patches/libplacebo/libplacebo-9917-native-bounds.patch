Subject: [PATCH] colorspace: opt-in native Dolby Vision reconstruction bounds

diff --git a/src/include/libplacebo/colorspace.h b/src/include/libplacebo/colorspace.h
--- a/src/include/libplacebo/colorspace.h
+++ b/src/include/libplacebo/colorspace.h
@@ -128,6 +128,27 @@
 PL_API bool pl_bit_encoding_equal(const struct pl_bit_encoding *b1,
                                   const struct pl_bit_encoding *b2);
 
+// CB1 raw fixed-point components. Shared layout; no decoder-owned pointers.
+struct pl_cb1_dovi_component {
+    uint8_t num_pivots, method[8], order[8];
+    uint16_t pivots[9];
+    int64_t poly[8][3], constant[8], mmr[8][3][7];
+};
+
+#define PL_HAVE_CB1_MASTER_REFERENCE 1
+struct pl_cb1_dovi_reference {
+    uint32_t contract;
+    uint8_t bl_depth, el_depth, output_depth, denom;
+    bool residual;
+    struct pl_cb1_dovi_component comp[3];
+    struct {
+        uint16_t offset;
+        uint64_t slope, threshold, maximum;
+    } nlq[3];
+};
+#define PL_CB1_DOVI_REFERENCE_ABI ((PL_HAVE_CB1_MASTER_REFERENCE << 16) | (unsigned)sizeof(struct pl_cb1_dovi_reference))
+PL_API unsigned pl_cb1_dovi_reference_abi(void);
+
 // Parsed metadata from the Dolby Vision RPU
 struct pl_dovi_metadata {
     // Colorspace transformation metadata
@@ -164,6 +185,10 @@
         float deadzone_slope;     // (2^el_bit_depth - 1) * S / 2^coef_log2_denom
         float deadzone_threshold; // (T - S/2) / 2^coef_log2_denom
     } nlq[3];
+    // CB1 native reconstruction bounds; default off preserves other callers.
+#define PL_HAVE_CB1_NATIVE_BOUNDS 1
+    bool cb1_native_bounds;
+    float cb1_nlq_max[3];
 };
 
 // Struct describing the underlying color system and representation. This
diff --git a/src/include/libplacebo/shaders/colorspace.h b/src/include/libplacebo/shaders/colorspace.h
--- a/src/include/libplacebo/shaders/colorspace.h
+++ b/src/include/libplacebo/shaders/colorspace.h
@@ -44,15 +44,9 @@
 // Reconstruct normalized opponent components, without display-management color
 // conversion. Caller owns their representation and subsequent transport.
 #define PL_HAVE_CB1_DOVI_TRANSPORT 1
-#define PL_HAVE_CB1_PROCESSING 7
+#define PL_HAVE_CB1_PROCESSING 9
 
 // CB1-owned source contract. No decoder objects cross this boundary.
-struct pl_cb1_dovi_component {
-    uint8_t num_pivots, method[8], order[8];
-    uint16_t pivots[9];
-    int64_t poly[8][3], constant[8], mmr[8][3][7];
-};
-
 struct pl_cb1_dovi_processing {
     uint32_t groups, narrow_components, poly_components;
     uint8_t bit_depth, denominator;
@@ -62,6 +56,10 @@
 };
 #define PL_CB1_PROCESSING_ABI ((PL_HAVE_CB1_PROCESSING << 16) | (unsigned)sizeof(struct pl_cb1_dovi_processing))
 PL_API unsigned pl_cb1_processing_abi(void);
+// Source subpasses return exact raw BL codes in RGB and EL code in R.
+// Produces the reconstructed integer code replicated in RGB, without normalization.
+PL_API bool pl_shader_dovi_reference_component(pl_shader sh,
+    const struct pl_cb1_dovi_reference *data,int component,pl_shader base,pl_shader enhancement);
 
 // Borrowed for shader preparation; null preserves the reference path.
 PL_API void pl_shader_dovi_reconstruct_ex(pl_shader sh, struct pl_color_repr *repr,
diff --git a/src/include/libplacebo/utils/libav_internal.h b/src/include/libplacebo/utils/libav_internal.h
--- a/src/include/libplacebo/utils/libav_internal.h
+++ b/src/include/libplacebo/utils/libav_internal.h
@@ -950,6 +950,7 @@
     header = av_dovi_get_header(data);
     mapping = av_dovi_get_mapping(data);
     color = av_dovi_get_color(data);
+    out->cb1_native_bounds = false;
 
     for (int i = 0; i < 3; i++)
         out->nonlinear_offset[i] = av_q2d(color->ycc_to_rgb_offset[i]);
@@ -1015,6 +1016,7 @@
             dst->offset = el_scale * src->nlq_offset;
             dst->deadzone_slope = slope_scale_d * S;
             dst->deadzone_threshold = coef_scale_d * (T - 0.5 * S);
+            out->cb1_nlq_max[c] = coef_scale_d * src->vdr_in_max;
         }
     }
 }
diff --git a/src/shaders/colorspace.c b/src/shaders/colorspace.c
--- a/src/shaders/colorspace.c
+++ b/src/shaders/colorspace.c
@@ -243,8 +243,14 @@
     vec3 el_centered = el_sample - $off;                              \
     vec3 noise = 2.384185791015625e-7 * max(abs(el_sample), abs($off)); \
     el_centered = mix(el_centered, vec3(0.0), lessThanEqual(abs(el_centered), noise)); \
-    color.rgb += sign(el_centered) * (abs(el_centered) * $slp + $thr);  \
-    }
+    vec3 residual = sign(el_centered) * (abs(el_centered) * $slp + $thr);
+    if (data->cb1_native_bounds) {
+        ident_t maximum = sh_var(sh, (struct pl_shader_var) {
+            .var=pl_var_vec3("nlq_max"), .data=data->cb1_nlq_max,
+        });
+        GLSL("residual=clamp(residual,-"$","$");\n",maximum,maximum);
+    }
+    GLSL("color.rgb += residual; }\n");
 #endif
 }
 
@@ -262,6 +268,16 @@
          "vec4 coeffs;                          \n"
          "float s;                              \n"
          "sig = clamp(color.rgb, 0.0, 1.0);     \n");
+    if (data->cb1_native_bounds) {
+        float lo[3]={0},hi[3]={1,1,1};
+        for(int c=0;c<3;c++)if(data->comp[c].num_pivots>=2){
+            lo[c]=data->comp[c].pivots[0];
+            hi[c]=data->comp[c].pivots[data->comp[c].num_pivots-1];
+        }
+        ident_t lower=sh_var(sh,(struct pl_shader_var){.var=pl_var_vec3("input_min"),.data=lo});
+        ident_t upper=sh_var(sh,(struct pl_shader_var){.var=pl_var_vec3("input_max"),.data=hi});
+        GLSL("sig=clamp(sig,"$","$");\n",lower,upper);
+    }
 
     float coeffs_data[8][4];
     float mmr_packed_data[8*6][4];
@@ -277,6 +293,13 @@
             continue;
 
         pl_assert(comp->num_pivots >= 2 && comp->num_pivots <= 9);
+        struct pl_reshape_data bounded;
+        if(data->cb1_native_bounds){
+            bounded=*comp;
+            bounded.pivots[0]=0;
+            bounded.pivots[bounded.num_pivots-1]=1;
+            comp=&bounded;
+        }
         struct pl_reshape_data compact;
         bool common_mmr = comp->num_pivots > 2 && comp->method[0] == 1;
         for (int i = 1; common_mmr && i < comp->num_pivots - 1; i++)
@@ -515,6 +538,11 @@
 unsigned pl_cb1_processing_abi(void)
 {
     return PL_CB1_PROCESSING_ABI;
+}
+
+unsigned pl_cb1_dovi_reference_abi(void)
+{
+    return PL_CB1_DOVI_REFERENCE_ABI;
 }
 
 void pl_shader_dovi_reconstruct(pl_shader sh, struct pl_color_repr *repr,
